# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Editable task notes with WebDAV synchronization and JMAP sources"
maintainer: ["Anil Madhavapeddy <anil@recoil.org>"]
authors: ["Anil Madhavapeddy"]
license: "ISC"
depends: [
  "dune" {>= "3.21"}
  "ocaml" {>= "5.1.0"}
  "eio"
  "eio_main"
  "console-eio"
  "console"
  "cmdliner"
  "xdge"
  "tomlt"
  "yamlrw"
  "jsont"
  "bytesrw"
  "frontmatter"
  "digestif"
  "ptime"
  "fetch"
  "fetch-curl"
  "httpz"
  "jmap"
  "sqlite3"
  "uunf"
  "uucp"
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
x-maintenance-intent: ["(latest)"]
