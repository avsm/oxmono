opam-version: "2.0"
synopsis: "Zero-allocation HTTP/1.1 parser for OxCaml"
description: """
A high-performance HTTP/1.1 parser and serializer that achieves near-zero
heap allocations using OxCaml's unboxed types and local allocations. Includes
a segment-based router and an Eio-based static file server."""
maintainer: ["anil@recoil.org"]
authors: ["Anil Madhavapeddy"]
license: "ISC"
homepage: "https://github.com/avsm/httpz"
bug-reports: "https://github.com/avsm/httpz/issues"
depends: [
  "dune" {>= "3.20"}
  "ocaml" {>= "5.2"}
  "base"
  "base_bigstring"
  "ocaml_intrinsics_kernel"
  "unboxed"
  "uriz"
  "core" {>= "v0.17"}
  "eio"
  "eio_main"
  "eio_posix"
  "cmdliner"
  "ppx_jane"
  "core_bench" {with-test}
  "stdio" {with-test}
  "odoc" {with-doc}
]
depopts: ["ocaml_simd"]
conflicts: [
  "ocaml_simd" {< "v0.18"}
]
build: [
  ["dune" "subst"] {dev}
