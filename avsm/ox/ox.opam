opam-version: "2.0"
version: "0.1.0"
synopsis: "Run opam packages from a local OxCaml source and binary cache"
maintainer: ["Anil Madhavapeddy <anil@recoil.org>"]
authors: ["Anil Madhavapeddy"]
license: "ISC"
depends: [
  "dune" {>= "3.21"}
  "ocaml" {>= "5.2"}
  "opam-format" {>= "2.5"}
  "opam-0install" {>= "0.6"}
  "eio"
  "eio_main"
  "d10"
  "fmt"
  "cmdliner"
  "parsexp"
  "sexplib0"
  "conf-python-3" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
x-maintenance-intent: ["(latest)"]
