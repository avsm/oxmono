# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "DS4 adapter for Agentkit"
description:
  "Lossless conversion of DS4 agent events to Agentkit's backend-neutral event stream."
maintainer: ["Anil Madhavapeddy <anil@recoil.org>"]
authors: ["Anil Madhavapeddy"]
license: "ISC"
tags: ["org:blacksun" "ds4" "llm" "agent"]
homepage: "https://tangled.org/anil.recoil.org/ocaml-agentkit"
bug-reports: "https://tangled.org/anil.recoil.org/ocaml-agentkit/issues"
depends: [
  "dune" {>= "3.21"}
  "ocaml" {>= "5.2.0"}
  "ds4"
  "agentkit" {= version}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://tangled.org/anil.recoil.org/ocaml-agentkit"
x-maintenance-intent: ["(latest)"]
