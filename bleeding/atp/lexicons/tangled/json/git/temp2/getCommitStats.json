{
  "lexicon": 1,
  "id": "sh.tangled.git.temp2.getCommitStats",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get an actor's monthly commit counts, with the repos they committed to.",
      "parameters": {
        "type": "params",
        "required": [
          "actor"
        ],
        "properties": {
          "actor": {
            "type": "string",
            "format": "did",
            "description": "Actor whose commits to count."
          },
          "months": {
            "type": "integer",
            "minimum": 1,
            "maximum": 24,
            "default": 7
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "months"
          ],
          "properties": {
            "months": {
              "type": "array",
              "maxLength": 24,
              "items": {
                "type": "ref",
                "ref": "#month"
              }
            }
          }
        }
      },
      "errors": [
        {
          "name": "InvalidRequest",
          "description": "Invalid request parameters"
        }
      ]
    },
    "month": {
      "type": "object",
      "required": [
        "start",
        "commits"
      ],
      "properties": {
        "start": {
          "type": "string",
          "format": "datetime",
          "description": "Start of this UTC calendar month."
        },
        "commits": {
          "type": "integer",
          "minimum": 0,
          "description": "Commits attributed to the actor during this month."
        },
        "repos": {
          "type": "array",
          "description": "Repos the actor committed to this month, busiest first.",
          "items": {
            "type": "ref",
            "ref": "#repoCommits"
          }
        }
      }
    },
    "repoCommits": {
      "type": "object",
      "required": [
        "repo",
        "commits",
        "recent"
      ],
      "properties": {
        "repo": {
          "type": "string",
          "format": "did",
          "description": "DID of the repo the commits were first seen in."
        },
        "commits": {
          "type": "integer",
          "minimum": 0
        },
        "recent": {
          "type": "array",
          "description": "Most recent commits in this repo during the month.",
          "items": {
            "type": "ref",
            "ref": "#commit"
          }
        }
      }
    },
    "commit": {
      "type": "object",
      "required": [
        "sha",
        "subject",
        "committedAt"
      ],
      "properties": {
        "sha": {
          "type": "string",
          "minLength": 40,
          "maxLength": 40
        },
        "subject": {
          "type": "string",
          "maxLength": 1000
        },
        "committedAt": {
          "type": "string",
          "format": "datetime"
        }
      }
    }
  }
}
