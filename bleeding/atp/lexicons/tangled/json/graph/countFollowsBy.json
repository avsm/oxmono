{
  "lexicon": 1,
  "id": "sh.tangled.graph.countFollowsBy",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "type": "params",
        "required": ["subject"],
        "properties": {
          "subject": {
            "type": "string",
            "format": "did",
            "description": "Actor DID whose follow authorings to list."
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["count", "distinctAuthors"],
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 0,
              "description": "Total number of matching records."
            },
            "distinctAuthors": {
              "type": "integer",
              "minimum": 0,
              "description": "Number of distinct authors among the matching records."
            }
          }
        }
      }
    }
  }
}
