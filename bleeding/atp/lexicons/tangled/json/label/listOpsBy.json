{
  "lexicon": 1,
  "id": "sh.tangled.label.listOpsBy",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "type": "params",
        "required": ["subject"],
        "properties": {
          "subject": {
            "type": "string",
            "format": "did",
            "description": "Actor DID whose label-op authorings to list."
          },
          "cursor": {
            "type": "string",
            "description": "Pagination cursor"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "default": 50
          },
          "order": {
            "type": "string",
            "knownValues": ["asc", "desc"],
            "default": "desc",
            "description": "Sort direction by createdAt."
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["items"],
          "properties": {
            "items": {
              "type": "array",
              "items": { "type": "ref", "ref": "sh.tangled.label.listOps#listItem" }
            },
            "cursor": { "type": "string" }
          }
        }
      }
    }
  }
}
