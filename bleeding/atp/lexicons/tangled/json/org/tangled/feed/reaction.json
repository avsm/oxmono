{
  "lexicon": 1,
  "id": "org.tangled.feed.reaction",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": [
          "subject",
          "reaction",
          "createdAt"
        ],
        "properties": {
          "subject": {
            "type": "ref",
            "ref": "com.atproto.repo.strongRef"
          },
          "reaction": {
            "type": "string",
            "maxGraphemes": 1,
            "enum": ["👍", "👎", "😆", "🎉", "🫤", "❤️", "🚀", "👀"]
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  }
}
