{
  "lexicon": 1,
  "id": "org.tangled.git.getBlame",
  "defs": {
    "main": {
      "type": "query",
      "description": "Line-by-line attribution of a file at a ref.",
      "parameters": {
        "type": "params",
        "required": ["repo", "ref", "path"],
        "properties": {
          "repo": {
            "type": "string",
            "format": "did",
            "description": "DID of the repository"
          },
          "ref": {
            "type": "string",
            "description": "Git revision (branch, tag, or commit Object ID)"
          },
          "path": {
            "type": "string",
            "description": "Path of the file to blame"
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["commit", "commits", "runs"],
          "properties": {
            "commit": {
              "type": "string",
              "description": "The resolved commit Object ID"
            },
            "commits": {
              "type": "array",
              "description": "Unique commits referenced by blame runs",
              "items": {
                "type": "ref",
                "ref": "#commit"
              }
            },
            "runs": {
              "type": "array",
              "description": "Complete, gap-free one-based line ranges sorted by start",
              "items": {
                "type": "ref",
                "ref": "#run"
              }
            }
          }
        }
      },
      "errors": [
        {
          "name": "RepoNotFound",
          "description": "Repo is not registered on this knot"
        },
        {
          "name": "RefNotFound",
          "description": "The given ref doesn't resolve in this repo"
        },
        {
          "name": "FileNotFound",
          "description": "The given path doesn't exist at the given ref"
        },
        {
          "name": "BlameTooLarge",
          "description": "The file is too large to blame"
        },
        {
          "name": "BlameTimeout",
          "description": "Blame computation timed out"
        },
        {
          "name": "InvalidRequest",
          "description": "Invalid request parameters"
        }
      ]
    },
    "commit": {
      "type": "object",
      "required": ["sha", "subject", "authoredAt", "author"],
      "properties": {
        "sha": {
          "type": "string",
          "description": "Commit Object ID"
        },
        "subject": {
          "type": "string",
          "description": "First line of the commit message"
        },
        "authoredAt": {
          "type": "string",
          "format": "datetime",
          "description": "When the change was authored"
        },
        "author": {
          "type": "ref",
          "ref": "#author"
        }
      }
    },
    "author": {
      "type": "object",
      "required": ["name", "email"],
      "properties": {
        "name": {
          "type": "string"
        },
        "email": {
          "type": "string"
        }
      }
    },
    "run": {
      "type": "object",
      "required": ["start", "count", "commit"],
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 1,
          "description": "First line of the run, one-based"
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of lines in the run"
        },
        "commit": {
          "type": "string",
          "description": "The commit Object ID of the entry in commits this run is attributed to"
        }
      }
    }
  }
}
