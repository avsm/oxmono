{
  "lexicon": 1,
  "id": "org.tangled.git.listLanguages",
  "defs": {
    "main": {
      "type": "query",
      "description": "Language breakdown of a repository's tree at a ref.",
      "parameters": {
        "type": "params",
        "required": ["repo"],
        "properties": {
          "repo": {
            "type": "string",
            "format": "did",
            "description": "DID of the repository"
          },
          "ref": {
            "type": "string",
            "description": "Git revision (branch, tag, or commit Object ID)",
            "default": "HEAD"
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ref", "languages"],
          "properties": {
            "ref": {
              "type": "string",
              "description": "The ref the breakdown was computed at"
            },
            "languages": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "#language"
              }
            },
            "totalSize": {
              "type": "integer",
              "minimum": 0,
              "description": "Total bytes across counted files"
            },
            "totalFiles": {
              "type": "integer",
              "minimum": 0,
              "description": "Total counted files"
            }
          }
        }
      },
      "errors": [
        {
          "name": "RepoNotFound",
          "description": "Repo is not registered on this knot"
        },
        {
          "name": "RefNotFound",
          "description": "The given ref doesn't resolve in this repo"
        },
        {
          "name": "InvalidRequest",
          "description": "Invalid request parameters"
        }
      ]
    },
    "language": {
      "type": "object",
      "required": ["name", "size", "percentage"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Language name"
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "description": "Bytes counted for this language"
        },
        "percentage": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "Share of total size, 0-100"
        },
        "fileCount": {
          "type": "integer",
          "minimum": 0,
          "description": "Files counted for this language"
        },
        "color": {
          "type": "string",
          "description": "Render color for this language"
        },
        "extensions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "File extensions recognized as this language"
        }
      }
    }
  }
}
