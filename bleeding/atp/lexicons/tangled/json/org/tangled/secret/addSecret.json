{
  "lexicon": 1,
  "id": "org.tangled.secret.addSecret",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Add a CI secret",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "repo",
            "key",
            "value"
          ],
          "properties": {
            "repo": {
              "type": "string",
              "format": "did"
            },
            "key": {
              "type": "string",
              "maxLength": 50,
              "minLength": 1
            },
            "value": {
              "type": "string",
              "maxLength": 4096,
              "minLength": 1
            }
          }
        }
      },
      "errors": [
        {
          "name": "InvalidRequest",
          "description": "Invalid request parameters"
        },
        {
          "name": "RepoNotFound",
          "description": "Repository not found"
        },
        {
          "name": "SecretAlreadyExists",
          "description": "A secret with this key already exists."
        }
      ]
    }
  }
}
