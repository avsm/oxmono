{
  "lexicon": 1,
  "id": "org.tangled.secret.listSecrets",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "type": "params",
        "required": [
          "repo"
        ],
        "properties": {
          "repo": {
            "type": "string",
            "format": "did"
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "secrets"
          ],
          "properties": {
            "secrets": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "#secret"
              }
            }
          }
        }
      },
      "errors": [
        {
          "name": "InvalidRequest",
          "description": "Invalid request parameters"
        },
        {
          "name": "RepoNotFound",
          "description": "Repository not found"
        }
      ]
    },
    "secret": {
      "type": "object",
      "required": [
        "key",
        "createdAt",
        "createdBy"
      ],
      "properties": {
        "key": {
          "type": "string",
          "maxLength": 50,
          "minLength": 1
        },
        "createdAt": {
          "type": "string",
          "format": "datetime"
        },
        "createdBy": {
          "type": "string",
          "format": "did"
        }
      }
    }
  }
}
