{
  "lexicon": 1,
  "id": "org.tangled.temp.server.seedRepo",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Foster an empty git repo TEMPORARILY for an owner from outside the knot, and write the given manifest and records on this knot without lex validation. This endpoint is possible only when legacy admin secret is in use.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["repoDid", "manifest", "records"],
          "properties": {
            "repoDid": {
              "type": "string",
              "format": "did",
              "description": "Existing repo DID which our COB records belong to. The foster knot will serve this DID as a shadow, and will give the record (authority) back to the principal knot once that given knot that *actually* owns the repo DID upgrades!"
            },
            "manifest": {
              "type": "unknown",
              "description": "Raw `org.tangled.repo.manifest` record body"
            },
            "records": {
              "type": "array",
              "maxLength": 200,
              "description": "Records to write besides the manifest. Max 200 per req.",
              "items": {
                "type": "ref",
                "ref": "#seedRecord"
              }
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["did", "key", "results"],
          "properties": {
            "did": {
              "type": "string",
              "format": "did"
            },
            "key": {
              "type": "string",
              "description": "Multibase-encoded public signing key that the knot has for this repo."
            },
            "results": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "#recordResult"
              }
            }
          }
        }
      }
    },
    "seedRecord": {
      "type": "object",
      "required": ["collection", "rkey", "author", "createdAt", "record"],
      "properties": {
        "collection": {
          "type": "string",
          "format": "nsid"
        },
        "rkey": {
          "type": "string",
          "format": "record-key"
        },
        "author": {
          "type": "string",
          "format": "did",
          "description": "DID which will be attributed to the record as the author."
        },
        "createdAt": {
          "type": "integer",
          "description": "Creation time in Unix seconds."
        },
        "record": {
          "type": "unknown",
          "description": "Record body, DAG-CBOR w/o lex validation. Max 1,000,000 bytes post-encode."
        }
      }
    },
    "recordResult": {
      "type": "object",
      "required": ["collection", "rkey"],
      "properties": {
        "collection": {
          "type": "string",
          "format": "nsid"
        },
        "rkey": {
          "type": "string",
          "format": "record-key"
        },
        "error": {
          "type": "string",
          "description": "Reason that a record wasn't written."
        }
      }
    }
  }
}
