{
  "lexicon": 1,
  "id": "org.tangled.temp.spindle.allowList.list",
  "defs": {
    "main": {
      "type": "query",
      "description": "Read this spindle's allow-list. Only callable by a spindle admin.",
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["dids"],
          "properties": {
            "dids": {
              "type": "array",
              "description": "Allow-list entries.",
              "items": { "type": "string", "format": "did" }
            }
          }
        }
      }
    }
  }
}
