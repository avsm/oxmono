{
  "lexicon": 1,
  "id": "org.tangled.temp.spindle.allowList.remove",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Remove a DID from this spindle's allow-list. Only callable by a spindle admin.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["did"],
          "properties": {
            "did": {
              "type": "string",
              "format": "did",
              "description": "DID to remove from allow-list."
            }
          }
        }
      }
    }
  }
}
