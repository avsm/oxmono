{
  "lexicon": 1,
  "id": "org.tangled.temp.account.getNewsletterPreference",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get the authenticated account's newsletter choice. status is absent when the account has neither subscribed nor dismissed the prompt.",
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "knownValues": ["subscribed", "dismissed"]
            }
          }
        }
      }
    }
  }
}
