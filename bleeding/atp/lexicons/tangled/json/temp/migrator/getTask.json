{
  "lexicon": 1,
  "id": "org.tangled.temp.migrator.getTask",
  "defs": {
    "main": {
      "type": "query",
      "description": "Fetch a migration task and its jobs.",
      "parameters": {
        "type": "params",
        "required": [
          "taskId"
        ],
        "properties": {
          "taskId": {
            "type": "string",
            "description": "ID of the task to fetch."
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "ref",
          "ref": "org.tangled.temp.migrator.defs#task"
        }
      },
      "errors": [
        {
          "name": "TaskNotFound",
          "description": "Migration task not found."
        }
      ]
    }
  }
}
