{
  "lexicon": 1,
  "id": "org.tangled.temp.migrator.listTasks",
  "defs": {
    "main": {
      "type": "query",
      "description": "List migration tasks for the caller.",
      "parameters": {
        "type": "params",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 20,
            "description": "Maximum number of tasks to return."
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "tasks"
          ],
          "properties": {
            "tasks": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "org.tangled.temp.migrator.defs#task"
              }
            }
          }
        }
      }
    }
  }
}
