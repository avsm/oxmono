{
  "lexicon": 1,
  "id": "org.tangled.temp.migrator.retryJob",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Retry a failed or unauthorized migration job.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "taskId",
            "jobId"
          ],
          "properties": {
            "taskId": {
              "type": "string",
              "description": "ID of the task the job belongs to."
            },
            "jobId": {
              "type": "string",
              "description": "ID of the job to retry."
            },
            "githubToken": {
              "type": "string",
              "description": "GitHub token for retrying a private repository."
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "ref",
          "ref": "org.tangled.temp.migrator.defs#task"
        }
      },
      "errors": [
        {
          "name": "TaskNotFound",
          "description": "Migration task not found."
        },
        {
          "name": "JobNotRetryable",
          "description": "Job is completed or currently running."
        }
      ]
    }
  }
}
