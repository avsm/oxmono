{
  "lexicon": 1,
  "id": "org.tangled.temp.repo.deleteWebhook",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Delete a webhook from a repository.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["repoDid", "id"],
          "properties": {
            "repoDid": {
              "type": "string",
              "format": "did",
              "description": "DID of the repository as minted by the knot."
            },
            "id": {
              "type": "integer",
              "description": "Webhook ID to delete."
            }
          }
        }
      },
      "errors": [
        { "name": "WebhookNotFound" }
      ]
    }
  }
}
