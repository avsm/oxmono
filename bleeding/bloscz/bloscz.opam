# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Blosc1 compression for OxCaml"
description: """
Bindings to the C-Blosc1 context interface for OxCaml. Compression and
decompression work directly on caller-supplied bigstrings and the runtime
lock is released around the larger calls. No opam package provides the C
library, so libblosc 1.21 or later and its headers must be installed
already: Debian and Ubuntu call them libblosc1 and libblosc-dev,
Homebrew and Nix call them c-blosc."""
maintainer: ["Anil Madhavapeddy <anil@recoil.org>"]
authors: ["Anil Madhavapeddy <anil@recoil.org>"]
license: "ISC"
homepage: "https://tangled.org/anil.recoil.org/ocaml-bloscz"
bug-reports: "https://tangled.org/anil.recoil.org/ocaml-bloscz/issues"
depends: [
  "dune" {>= "3.21"}
  "ocaml" {>= "5.2.0"}
  "base_bigstring"
  "odoc" {with-doc}
  "alcotest" {with-test}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://tangled.org/anil.recoil.org/ocaml-bloscz"
x-maintenance-intent: ["(latest)"]
x-ai-disclosure: "ai-generated"
x-ai-model: "claude-fable-5"
x-ai-provider: "Anthropic"
