(package
 (name chdb)
 (synopsis "High-performance ClickHouse embedded bindings for OxCaml")
 (description
  "Zero-copy OCaml bindings to chdb (ClickHouse Embedded Database).
Provides connection management, query execution with multiple output
formats, zero-copy result access via Bigstring, streaming queries,
and unboxed statistics access.")
 (depends
  (ocaml (>= 5.2.0))
  (dune (>= 3.0))
  base
  base_bigstring
  capsule0
  (alcotest (and :with-test (>= 1.7.0)))))
