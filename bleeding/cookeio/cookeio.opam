# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Cookie parsing and management library"
description:
  "Cookeio implements the RFC 6265 cookie model for both sides of the protocol: a client parses Set-Cookie under the full storage rules (domain matching, public-suffix and name-prefix checks, Max-Age precedence) and a server parses Cookie and emits Set-Cookie. The cookeio.jar library adds a bounded client-side jar with curl-compatible cookies.txt persistence."
maintainer: ["Anil Madhavapeddy <anil@recoil.org>"]
authors: ["Anil Madhavapeddy"]
license: "ISC"
homepage: "https://tangled.sh/@anil.recoil.org/ocaml-cookeio"
doc: "https://tangled.sh/@anil.recoil.org/ocaml-cookeio"
bug-reports: "https://tangled.sh/@anil.recoil.org/ocaml-cookeio/issues"
depends: [
  "dune" {>= "3.18"}
  "ocaml" {>= "5.2.0"}
  "fmt" {>= "0.9.0"}
  "ptime" {>= "1.1.0"}
  "publicsuffix"
  "eio" {>= "1.3"}
  "eio_main" {>= "1.3" & with-test}
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
x-maintenance-intent: ["(latest)"]
x-ai-disclosure: "ai-generated"
x-ai-model: "claude-fable-5"
x-ai-provider: "Anthropic"
