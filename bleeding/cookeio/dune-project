(maintenance_intent "(latest)")

(package
 (name cookeio)
 (synopsis "Cookie parsing and management library")
 (description "Cookeio implements the RFC 6265 cookie model for both sides of the protocol: a client parses Set-Cookie under the full storage rules (domain matching, public-suffix and name-prefix checks, Max-Age precedence) and a server parses Cookie and emits Set-Cookie. The cookeio.jar library adds a bounded client-side jar with curl-compatible cookies.txt persistence.")
 (depends
  (ocaml (>= 5.2.0))
  (fmt (>= 0.9.0))
  (ptime (>= 1.1.0))
  publicsuffix
  (eio (>= 1.3))
  (eio_main (and (>= 1.3) :with-test))
  (alcotest :with-test)
  (odoc :with-doc)))
