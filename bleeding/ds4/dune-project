(lang dune 3.21)
(using mdx 0.4)
(cram enable)
(name ds4)

(generate_opam_files true)
(implicit_transitive_deps false)

(license ISC)
(authors "Anil Madhavapeddy")
(maintainers "Anil Madhavapeddy <anil@recoil.org>")
(source (tangled anil.recoil.org/ocaml-deepseek))

(package
 (name ds4)
 (synopsis "Local LLM inference on the DS4 engine")
 (tags (org:blacksun ds4 llm))
 (description
  "Library and command to run the DeepSeek V4, DeepSeek V4.1 Flash, GLM 5.3 Flash and Qwen3.8 Flash Next models locally on the DS4 engine, with a selectable inference backend (Apple Metal, CUDA or CPU).")
 (depends
  (ocaml (>= 5.2.0))
  (dune-configurator :build)
  (jsont (>= 0.3.0))
  (xdge (>= 1.0.0))
  (eio (>= 1.4))
  eio_main
  (optint (>= 0.3.0))
  (logs (>= 0.7.0))
  (bytesrw (>= 0.3.0))
  (fmt (>= 0.8.7))
  (cmdliner (>= 1.1.0))))
