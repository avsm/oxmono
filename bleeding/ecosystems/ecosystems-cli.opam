# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Command-line tool for the packages.ecosyste.ms API"
description: """
oecosystems queries registries, packages, versions, dependents,
   advisories, maintainers and keywords on packages.ecosyste.ms."""
maintainer: ["anil@recoil.org"]
authors: ["Anil Madhavapeddy"]
license: "ISC"
homepage: "https://tangled.org/anil.recoil.org/ocaml-ecosystems"
bug-reports: "https://tangled.org/anil.recoil.org/ocaml-ecosystems/issues"
depends: [
  "dune" {>= "3.21"}
  "ocaml" {>= "5.2.0"}
  "ecosystems" {= version}
  "openapi" {>= "0.4.0"}
  "eio" {>= "1.2"}
  "eio_main"
  "jsont" {>= "0.2.0"}
  "cmdliner" {>= "1.3.0"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://tangled.org/anil.recoil.org/ocaml-ecosystems"
x-maintenance-intent: ["(latest)"]
