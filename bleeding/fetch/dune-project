(lang dune 3.22)
(name fetch)
(using mdx 0.4)
(formatting disabled)
(generate_opam_files true)
(source (tangled @anil.recoil.org/taposaur))
(license ISC)
(authors "Anil Madhavapeddy")
(maintainers "anil@recoil.org")

(package
 (name fetch)
 (synopsis "Portable HTTP client capability for Eio")
 (description
  "An abstract HTTP client capability that can be narrowed (restricting the origins, methods or paths it may request), appended to (attaching scoped credentials and headers), and rate-limited before being handed to libraries. Any backend can provide it; a mock backend (fetch.mock) and cookie-jar middleware (fetch.cookies) are included.")
 (depends
  (ocaml (>= 5.2.0))
  (eio (>= 1.3))
  (http (>= 6.0.0))
  (uri (>= 4.2.0))
  (fmt (>= 0.8.9))
  (mtime (>= 2.0.0))
  (cstruct (>= 6.0.0))
  (ptime (>= 1.0.0))
  (mdx (and (>= 2.4.1) :with-test))
  (eio_main (and (>= 1.3) :with-test))))

(package
 (name fetch-cohttp)
 (synopsis "cohttp-eio backend for fetch")
 (description
  "A Fetch.Client backend using cohttp-eio: a pure OCaml HTTP/1.1 client with no C dependency, streaming request and response bodies, transparent gzip decoding and TLS supplied by the caller. Each request is a single exchange over its own connection; the portable fetch layer provides redirects and policy.")
 (depends
  (fetch (= :version))
  (cohttp-eio (>= 6.0.0))
  (uri (>= 4.2.0))
  (decompress (>= 1.5.0))
  (eio_main (and (>= 1.3) :with-test))
  (mdx (and (>= 2.4.1) :with-test))))

(package
 (name fetch-curl)
 (synopsis "libcurl backend for fetch")
 (description
  "A Fetch.Client backend using libcurl via the curl bindings: a shared multi handle integrated with the Eio event loop gives connection reuse, HTTP/2 multiplexing and per-host connection limits. Each request is a single exchange; the portable fetch layer provides redirects and policy.")
 (depends
  (fetch (= :version))
  (curl (>= 0.10.0))
  (eio_main (and (>= 1.3) :with-test))
  (mdx (and (>= 2.4.1) :with-test))))
