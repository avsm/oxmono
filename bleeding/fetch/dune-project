(lang dune 3.22)
(name fetch)
(using mdx 0.4)
(formatting disabled)
(generate_opam_files true)
(source (tangled @anil.recoil.org/taposaur))
(license ISC)
(authors "Anil Madhavapeddy")
(maintainers "anil@recoil.org")

(package
 (name fetch)
 (synopsis "Portable HTTP client capability for Eio")
 (description
  "An abstract HTTP client capability that can be narrowed (restricting the origins, methods or paths it may request), appended to (attaching scoped credentials and headers), and rate-limited before being handed to libraries. Any backend can provide it; a mock backend (fetch.mock) and cookie-jar middleware (fetch.cookies) are included.")
 (depends
  (ocaml (>= 5.2.0))
  (eio (>= 1.3))
  (http (>= 6.0.0))
  (uri (>= 4.2.0))
  (fmt (>= 0.8.9))
  (mtime (>= 2.0.0))
  (cstruct (>= 6.0.0))
  (ptime (>= 1.0.0))
  cookeio
  (mdx (and (>= 2.4.1) :with-test))
  (eio_main (and (>= 1.3) :with-test))))

(package
 (name fetch-cohttp)
 (synopsis "cohttp-eio backend for fetch")
 (description
  "A Fetch.Client backend using cohttp-eio: a pure OCaml HTTP/1.1 client with no C dependency, streaming request and response bodies, transparent gzip decoding and TLS supplied by the caller. Each request is a single exchange over its own connection; the portable fetch layer provides redirects and policy.")
 (depends
  (fetch (= :version))
  (cohttp-eio (>= 6.0.0))
  (uri (>= 4.2.0))
  (decompress (>= 1.5.0))
  (eio_main (and (>= 1.3) :with-test))
  (mdx (and (>= 2.4.1) :with-test))))

(package
 (name fetch-curl)
 (synopsis "libcurl backend for fetch")
 (description
  "A Fetch.Client backend using libcurl via the curl bindings: a shared multi handle integrated with the Eio event loop gives connection reuse, HTTP/2 multiplexing and per-host connection limits. Each request is a single exchange; the portable fetch layer provides redirects and policy.")
 (depends
  (fetch (= :version))
  (curl (>= 0.10.0))
  (eio_main (and (>= 1.3) :with-test))
  (mdx (and (>= 2.4.1) :with-test))))

(package
 (name fetch-signature)
 (synopsis "RFC 9421 HTTP Message Signatures for fetch")
 (description
  "Cryptographic signing and verification of HTTP messages per RFC 9421, with RFC 9530 Content-Digest, over the header and URL types fetch already uses. Ed25519, ECDSA P-256/P-384, RSA-PSS, RSA-PKCS1 and HMAC keys are supported, and a middleware signs every request a client makes. The crypto dependencies live here rather than in the core fetch package.")
 (depends
  (fetch (= :version))
  (http (>= 6.0.0))
  (uri (>= 4.2.0))
  (eio (>= 1.3))
  (ptime (>= 1.0.0))
  (logs (>= 0.7.0))
  (base64 (>= 3.5.0))
  (eqaf (>= 0.9))
  (digestif (>= 1.2.0))
  (mirage-crypto (>= 1.0.0))
  (mirage-crypto-ec (>= 1.0.0))
  (mirage-crypto-pk (>= 1.0.0))
  (mirage-crypto-rng (and (>= 1.0.0) :with-test))
  (alcotest (and (>= 1.7.0) :with-test))
  (eio_main (and (>= 1.3) :with-test))))

(package
 (name fetch-cmdliner)
 (synopsis "Command-line configuration for fetch clients")
 (description
  "A cmdliner term that turns the usual HTTP client flags (--timeout, --proxy, --max-retries, --no-verify-tls, --persist-cookies and the rest) plus their environment variables into a configured fetch-curl client, tracking which flag, variable or default supplied each value so that a command can print its resolved configuration.")
 (depends
  (fetch (= :version))
  (fetch-curl (= :version))
  (cmdliner (>= 1.3.0))
  (xdge (>= 0.1.0))
  (logs (>= 0.7.0))
  (eio (>= 1.3))
  (alcotest (and (>= 1.7.0) :with-test))
  (eio_main (and (>= 1.3) :with-test))))

(package
 (name nssessionurl)
 (synopsis "macOS NSURLSession bindings for Eio")
 (description
  "Fetch URLs through the macOS system networking stack (HTTP/2 and HTTP/3, system proxies, TLS via Security.framework) from Eio fibres. Response and request bodies are Eio flows with bounded buffering and backpressure; sessions share a connection pool and expose typed NSURLSessionConfiguration options. Builds on every platform but only functions on macOS: elsewhere Nssessionurl.available is false and session creation raises.")
 (depends
  (ocaml (>= 5.2.0))
  (eio (>= 1.3))
  (cstruct (>= 6.0.0))
  dune-configurator
  (eio_main (and (>= 1.3) :with-test))))

(package
 (name fetch-macos)
 (synopsis "macOS NSURLSession backend for fetch")
 (description
  "A Fetch.Client backend using the macOS system networking stack via nssessionurl: HTTP/2 and HTTP/3, system proxy configuration and TLS from Security.framework, with no third-party C dependency. Each request is a single exchange on an isolated ephemeral session; the portable fetch layer provides redirects and policy. Builds on every platform but only functions on macOS.")
 (depends
  (fetch (= :version))
  (nssessionurl (= :version))
  (http (>= 6.0.0))
  (fmt (>= 0.8.9))
  (eio_main (and (>= 1.3) :with-test))
  (mdx (and (>= 2.4.1) :with-test))))

(package
 (name fetch-main)
 (synopsis "Platform-selected fetch client and CLI")
 (description
  "Selects the best Fetch backend for the platform at runtime: the macOS system networking stack (fetch-macos) on macOS and libcurl (fetch-curl) elsewhere, overridable with the FETCH_BACKEND environment variable. Provides each backend's std stack (cookie jar, per-origin flow control, retries) behind one call, and a small fetch command-line tool over it.")
 (depends
  (fetch (= :version))
  (fetch-curl (= :version))
  (fetch-macos (= :version))
  (http (>= 6.0.0))
  (fmt (>= 0.8.9))
  (eio_main (>= 1.3))
  (mdx (and (>= 2.4.1) :with-test))))
