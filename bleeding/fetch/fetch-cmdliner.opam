# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Command-line configuration for fetch clients"
description:
  "A cmdliner term that turns the usual HTTP client flags (--timeout, --proxy, --max-retries, --no-verify-tls, --persist-cookies and the rest) plus their environment variables into a configured fetch-curl client, tracking which flag, variable or default supplied each value so that a command can print its resolved configuration."
maintainer: ["anil@recoil.org"]
authors: ["Anil Madhavapeddy"]
license: "ISC"
homepage: "https://tangled.org/@anil.recoil.org/taposaur"
bug-reports: "https://tangled.org/@anil.recoil.org/taposaur/issues"
depends: [
  "dune" {>= "3.22"}
  "fetch" {= version}
  "fetch-curl" {= version}
  "cmdliner" {>= "1.3.0"}
  "xdge" {>= "0.1.0"}
  "logs" {>= "0.7.0"}
  "eio" {>= "1.3"}
  "alcotest" {>= "1.7.0" & with-test}
  "eio_main" {>= "1.3" & with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://tangled.org/@anil.recoil.org/taposaur"
x-maintenance-intent: ["(latest)"]
