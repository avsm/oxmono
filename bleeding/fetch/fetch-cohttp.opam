# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "cohttp-eio backend for fetch"
description:
  "A Fetch.Client backend using cohttp-eio: a pure OCaml HTTP/1.1 client with no C dependency, streaming request and response bodies, transparent gzip decoding and TLS supplied by the caller. Each request is a single exchange over its own connection; the portable fetch layer provides redirects and policy."
maintainer: ["anil@recoil.org"]
authors: ["Anil Madhavapeddy"]
license: "ISC"
homepage: "https://tangled.org/@anil.recoil.org/taposaur"
bug-reports: "https://tangled.org/@anil.recoil.org/taposaur/issues"
depends: [
  "dune" {>= "3.22"}
  "fetch" {= version}
  "cohttp-eio" {>= "6.0.0"}
  "uri" {>= "4.2.0"}
  "decompress" {>= "1.5.0"}
  "eio_main" {>= "1.3" & with-test}
  "mdx" {>= "2.4.1" & with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://tangled.org/@anil.recoil.org/taposaur"
x-maintenance-intent: ["(latest)"]
