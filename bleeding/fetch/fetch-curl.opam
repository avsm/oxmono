opam-version: "2.0"
synopsis: "Libcurl backend for Fetch"
description: """
A Fetch backend using libcurl's multi interface with Eio integration,
connection reuse, HTTP/2 multiplexing, and per-host connection limits."""
maintainer: ["anil@recoil.org"]
authors: ["Anil Madhavapeddy"]
license: "ISC"
homepage: "https://tangled.org/@anil.recoil.org/taposaur"
bug-reports: "https://tangled.org/@anil.recoil.org/taposaur/issues"
depends: [
  "dune" {>= "3.22"}
  "fetch" {= version}
  "httpz"
  "checkseum" {>= "0.5.0"}
  "decompress" {>= "1.5.0"}
  "eio" {>= "1.3"}
  "fmt" {>= "0.8.9"}
  "curl" {>= "0.10.0"}
  "eio_main" {>= "1.3" & with-test}
  "mdx" {>= "2.4.1" & with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://tangled.org/@anil.recoil.org/taposaur"
x-maintenance-intent: ["(latest)"]
