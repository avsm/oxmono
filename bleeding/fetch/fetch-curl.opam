# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "libcurl backend for fetch"
description:
  "A Fetch.Client backend using libcurl via the curl bindings: a shared multi handle integrated with the Eio event loop gives connection reuse, HTTP/2 multiplexing and per-host connection limits. Each request is a single exchange; the portable fetch layer provides redirects and policy."
maintainer: ["anil@recoil.org"]
authors: ["Anil Madhavapeddy"]
license: "ISC"
homepage: "https://tangled.org/@anil.recoil.org/taposaur"
bug-reports: "https://tangled.org/@anil.recoil.org/taposaur/issues"
depends: [
  "dune" {>= "3.22"}
  "fetch" {= version}
  "curl" {>= "0.10.0"}
  "eio_main" {>= "1.3" & with-test}
  "mdx" {>= "2.4.1" & with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://tangled.org/@anil.recoil.org/taposaur"
x-maintenance-intent: ["(latest)"]
