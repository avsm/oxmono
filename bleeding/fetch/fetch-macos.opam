# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "macOS NSURLSession backend for fetch"
description:
  "A Fetch.Client backend using the macOS system networking stack via nssessionurl: HTTP/2 and HTTP/3, system proxy configuration and TLS from Security.framework, with no third-party C dependency. Each request is a single exchange on an isolated ephemeral session; the portable fetch layer provides redirects and policy. Builds on every platform but only functions on macOS."
maintainer: ["anil@recoil.org"]
authors: ["Anil Madhavapeddy"]
license: "ISC"
homepage: "https://tangled.org/@anil.recoil.org/taposaur"
bug-reports: "https://tangled.org/@anil.recoil.org/taposaur/issues"
depends: [
  "dune" {>= "3.22"}
  "fetch" {= version}
  "nssessionurl" {= version}
  "http" {>= "6.0.0"}
  "fmt" {>= "0.8.9"}
  "eio_main" {>= "1.3" & with-test}
  "mdx" {>= "2.4.1" & with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://tangled.org/@anil.recoil.org/taposaur"
x-maintenance-intent: ["(latest)"]
