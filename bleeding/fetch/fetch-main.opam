# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Platform-selected fetch client and CLI"
description:
  "Selects the best Fetch backend for the platform at runtime: the macOS system networking stack (fetch-macos) on macOS and libcurl (fetch-curl) elsewhere, overridable with the FETCH_BACKEND environment variable. Provides each backend's std stack (cookie jar, per-origin flow control, retries) behind one call, and a small fetch command-line tool over it."
maintainer: ["anil@recoil.org"]
authors: ["Anil Madhavapeddy"]
license: "ISC"
homepage: "https://tangled.org/@anil.recoil.org/taposaur"
bug-reports: "https://tangled.org/@anil.recoil.org/taposaur/issues"
depends: [
  "dune" {>= "3.22"}
  "fetch" {= version}
  "fetch-curl" {= version}
  "fetch-macos" {= version}
  "http" {>= "6.0.0"}
  "fmt" {>= "0.8.9"}
  "eio_main" {>= "1.3"}
  "mdx" {>= "2.4.1" & with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://tangled.org/@anil.recoil.org/taposaur"
x-maintenance-intent: ["(latest)"]
