# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "RFC 9421 HTTP Message Signatures for fetch"
description:
  "Cryptographic signing and verification of HTTP messages per RFC 9421, with RFC 9530 Content-Digest, over the header and URL types fetch already uses. Ed25519, ECDSA P-256/P-384, RSA-PSS, RSA-PKCS1 and HMAC keys are supported, and a middleware signs every request a client makes. The crypto dependencies live here rather than in the core fetch package."
maintainer: ["anil@recoil.org"]
authors: ["Anil Madhavapeddy"]
license: "ISC"
homepage: "https://tangled.org/@anil.recoil.org/taposaur"
bug-reports: "https://tangled.org/@anil.recoil.org/taposaur/issues"
depends: [
  "dune" {>= "3.22"}
  "fetch" {= version}
  "http" {>= "6.0.0"}
  "uri" {>= "4.2.0"}
  "eio" {>= "1.3"}
  "ptime" {>= "1.0.0"}
  "logs" {>= "0.7.0"}
  "base64" {>= "3.5.0"}
  "eqaf" {>= "0.9"}
  "digestif" {>= "1.2.0"}
  "mirage-crypto" {>= "1.0.0"}
  "mirage-crypto-ec" {>= "1.0.0"}
  "mirage-crypto-pk" {>= "1.0.0"}
  "mirage-crypto-rng" {>= "1.0.0" & with-test}
  "alcotest" {>= "1.7.0" & with-test}
  "eio_main" {>= "1.3" & with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://tangled.org/@anil.recoil.org/taposaur"
x-maintenance-intent: ["(latest)"]
