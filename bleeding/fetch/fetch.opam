# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Portable HTTP client capability for Eio"
description:
  "An abstract HTTP client capability that can be narrowed (restricting the origins, methods or paths it may request), appended to (attaching scoped credentials and headers), and rate-limited before being handed to libraries. Any backend can provide it; a mock backend (fetch.mock) and cookie-jar middleware (fetch.cookies) are included."
maintainer: ["anil@recoil.org"]
authors: ["Anil Madhavapeddy"]
license: "ISC"
homepage: "https://tangled.org/@anil.recoil.org/taposaur"
bug-reports: "https://tangled.org/@anil.recoil.org/taposaur/issues"
depends: [
  "dune" {>= "3.22"}
  "ocaml" {>= "5.2.0"}
  "eio" {>= "1.3"}
  "http" {>= "6.0.0"}
  "uri" {>= "4.2.0"}
  "fmt" {>= "0.8.9"}
  "mtime" {>= "2.0.0"}
  "cstruct" {>= "6.0.0"}
  "ptime" {>= "1.0.0"}
  "cookeio"
  "mdx" {>= "2.4.1" & with-test}
  "eio_main" {>= "1.3" & with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://tangled.org/@anil.recoil.org/taposaur"
x-maintenance-intent: ["(latest)"]
