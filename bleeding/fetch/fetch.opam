# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Portable HTTP client capability for Eio"
description: """
An abstract HTTP client capability that can be narrowed, appended to, and
rate-limited before being handed to libraries. A mock backend and cookie-jar
middleware are included, along with Jsont and Cmarkit media codecs."""
maintainer: ["anil@recoil.org"]
authors: ["Anil Madhavapeddy"]
license: "ISC"
homepage: "https://tangled.org/@anil.recoil.org/taposaur"
bug-reports: "https://tangled.org/@anil.recoil.org/taposaur/issues"
depends: [
  "dune" {>= "3.22"}
  "ocaml" {>= "5.2.0"}
  "httpz"
  "eio" {>= "1.3"}
  "http" {>= "6.0.0"}
  "fmt" {>= "0.8.9"}
  "mtime" {>= "2.0.0"}
  "cstruct" {>= "6.0.0"}
  "bytesrw" {>= "0.4.0"}
  "ptime" {>= "1.0.0"}
  "base64" {>= "3.5.0"}
  "ipaddr" {>= "5.6.2"}
  "alcotest" {with-test}
  "cmarkit" {>= "0.4.0"}
  "mdx" {>= "2.4.1" & with-test}
  "eio_main" {>= "1.3" & with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://tangled.org/@anil.recoil.org/taposaur"
x-maintenance-intent: ["(latest)"]
