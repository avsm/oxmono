# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "macOS NSURLSession bindings for Eio"
description:
  "Fetch URLs through the macOS system networking stack (HTTP/2 and HTTP/3, system proxies, TLS via Security.framework) from Eio fibres. Response and request bodies are Eio flows with bounded buffering and backpressure; sessions share a connection pool and expose typed NSURLSessionConfiguration options. Builds on every platform but only functions on macOS: elsewhere Nssessionurl.available is false and session creation raises."
maintainer: ["anil@recoil.org"]
authors: ["Anil Madhavapeddy"]
license: "ISC"
homepage: "https://tangled.org/@anil.recoil.org/taposaur"
bug-reports: "https://tangled.org/@anil.recoil.org/taposaur/issues"
depends: [
  "dune" {>= "3.22"}
  "ocaml" {>= "5.2.0"}
  "eio" {>= "1.3"}
  "cstruct" {>= "6.0.0"}
  "dune-configurator"
  "eio_main" {>= "1.3" & with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://tangled.org/@anil.recoil.org/taposaur"
x-maintenance-intent: ["(latest)"]
