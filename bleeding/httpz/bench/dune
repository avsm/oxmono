(vendored_dirs vendor)

(executable
 (name bench_httpz)
 ; The switch's Core_bench/Async closure was compiled against the installed
 ; Cstruct ABI.  The vendored TLS closure intentionally shadows Cstruct for
 ; the whole workspace, so linking the two copies is invalid.
 (enabled_if false)
 (libraries httpz base core core_bench)
 (preprocess
  (pps ppx_jane)))

; Comparative benchmark: httpz (OxCaml) vs httpe (Eio)
; Uses simple timing + GC measurement (no core_bench to avoid Eio conflict)

(executable
 (name bench_compare)
 (libraries httpz httpe eio eio_main base))

; Per-operation allocation for the router, conditional-request modules and
; chunked decoding, none of which core_bench covers.

(executable
 (name bench_alloc)
 (libraries httpz httpz.route base unix))
