(lang dune 3.20)
(name httpz)

(generate_opam_files true)
(implicit_transitive_deps false)

(source (github avsm/httpz))
(authors "Anil Madhavapeddy")
(maintainers "anil@recoil.org")

(package
 (name httpz)
 (license MIT ISC MPL-2.0)
 (synopsis "HTTP/1.1 protocol stack for OxCaml")
 (description
  "A bounded-buffer HTTP/1.1 parser and serializer built on OxCaml's unboxed
types and local allocations, with OxCaml-native RFC 3986 URI and RFC 6570 URI
Template implementations. Separate Findlib libraries provide URI operations,
typed media codecs with bounded JSON and Markdown support, shared
Eio TLS, Punycode, the Public Suffix List, and HTTP cookies, and bounded WebDAV protocol codecs.")
 (depends
  (duration (>= 0.3.1))
  (ocaml (>= 5.2))
  (base (>= v0.16.0))
  base_bigstring
  ocaml_intrinsics_kernel
  unboxed
  uriz
  ppx_template
  (uunf (>= 15.0.0))
  (fmt (>= 0.8.9))
  (ptime (>= 1.0.0))
  (bytesrw (>= 0.4.0))
  (jsont (>= 0.4.0))
  (cmarkit (>= 0.4.0))
  (tls (>= 2.1.2))
  (tls-eio (>= 2.1.2))
  (x509 (>= 1.1.1))
  (ca-certs (>= 1.0.3))
  (mirage-crypto (>= 2.4.1))
  (mirage-crypto-rng (>= 2.4.1))
  (digestif (>= 1.3.1))
  (base64 (>= 3.5.0))
  (kdf (>= 1.1.1))
  (asn1-combinators (>= 0.3.2))
  (domain-name (>= 0.5.0))
  (ipaddr (>= 5.6.2))
  (cstruct (>= 6.2.0))
  (zarith (>= 1.14+ox))
  (eio (>= 1.3))
  (eio_main (>= 1.3))
  (cmdliner (>= 1.1.0))
  (stdio :with-test)
  (crowbar :with-test)
  (alcotest :with-test)))
