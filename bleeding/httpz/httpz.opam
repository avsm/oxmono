  "dune" {>= "3.20"}
  "ocaml" {>= "5.2"}
  "base" {>= "v0.16.0"}
  "base_bigstring"
  "ocaml_intrinsics_kernel"
  "unboxed"
  "uriz"
  "core" {>= "v0.17"}
  "ppx_jane"
  "uunf" {>= "15.0.0"}
  "fmt" {>= "0.8.9"}
