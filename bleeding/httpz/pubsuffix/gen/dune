(executable
 (name gen_psl)
 (modules gen_psl)
 (libraries httpz.punycode))

; The parser fails loudly on a malformed rule, so a comment must be recognised
; wherever it begins on the line rather than ingested as a rule of its own.
(rule
 (with-stdout-to
  test_comments.actual
  (run ./gen_psl.exe %{dep:test_comments.dat})))

(rule
 (alias runtest)
 (action
  (diff test_comments.expected test_comments.actual)))
