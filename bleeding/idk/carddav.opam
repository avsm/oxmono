# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "CardDAV client for OCaml"
description:
  "An implementation of CardDAV (RFC 6352) on httpz.dav and fetch.dav, with the address book properties, the addressbook-query and addressbook-multiget reports, the sync-collection report of RFC 6578 and the discovery of RFC 6764. The carddav.eio library is a client on Eio and fetch, and carddav.jscontact reads and writes address objects as JSContact cards through RFC 9555."
maintainer: ["Anil Madhavapeddy <anil@recoil.org>"]
authors: ["Anil Madhavapeddy <anil@recoil.org>"]
license: "ISC"
homepage: "https://tangled.org/anil.recoil.org/idk"
bug-reports: "https://tangled.org/anil.recoil.org/idk/issues"
depends: [
  "dune" {>= "3.21"}
  "ocaml" {>= "5.2.0"}
  "httpz"
  "fetch"
  "fetch-httpz"
  "vcard"
  "jscontact"
  "eio"
  "eio_main"
  "odoc" {with-doc}
  "http" {with-test}
  "alcotest" {with-test & >= "1.7.0"}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://tangled.org/anil.recoil.org/idk"
x-maintenance-intent: ["(latest)"]
