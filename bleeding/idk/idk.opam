# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "IDKit, contact data for OCaml"
description:
  "The umbrella package of IDKit. It installs jscontact (RFC 9553 and its vCard conversion), vcard (RFC 6350), ical (RFC 5545), carddav (RFC 6352) and caldav (RFC 4791), each with an Eio client on fetch.dav, the packages contact data moves between."
maintainer: ["Anil Madhavapeddy <anil@recoil.org>"]
authors: ["Anil Madhavapeddy <anil@recoil.org>"]
license: "ISC"
homepage: "https://tangled.org/anil.recoil.org/idk"
bug-reports: "https://tangled.org/anil.recoil.org/idk/issues"
depends: [
  "dune" {>= "3.21"}
  "ocaml" {>= "5.2.0"}
  "jscontact"
  "vcard"
  "ical"
  "carddav"
  "caldav"
  "httpz"
  "fetch"
  "fetch-httpz"
  "eio"
  "eio_main"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://tangled.org/anil.recoil.org/idk"
x-maintenance-intent: ["(latest)"]
