# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "vCard 4.0 contact data for OCaml"
description:
  "An implementation of the vCard 4.0 format (RFC 6350) with the parameter escapes of RFC 6868 and the JSContact extensions of RFC 9554 and RFC 9555. Cards are read and written losslessly, and typed accessors read the value data types, the N and ADR components and the JSCOMPS parameter."
maintainer: ["Anil Madhavapeddy <anil@recoil.org>"]
authors: ["Anil Madhavapeddy <anil@recoil.org>"]
license: "ISC"
homepage: "https://tangled.org/anil.recoil.org/idk"
bug-reports: "https://tangled.org/anil.recoil.org/idk/issues"
depends: [
  "dune" {>= "3.21"}
  "ocaml" {>= "5.2.0"}
  "ptime" {>= "1.0.0"}
  "odoc" {with-doc}
  "alcotest" {with-test & >= "1.7.0"}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://tangled.org/anil.recoil.org/idk"
x-maintenance-intent: ["(latest)"]
