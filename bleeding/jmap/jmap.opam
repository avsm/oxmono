opam-version: "2.0"
synopsis: "JMAP protocol implementation for OCaml"
description:
  "An implementation of the JSON Meta Application Protocol (JMAP) as specified in RFC 8620 (core), RFC 8621 (mail) and RFC 9610 (contacts), with typed request builders and an Eio (jmap.eio) client."
maintainer: ["Anil Madhavapeddy <anil@recoil.org>"]
authors: ["Anil Madhavapeddy <anil@recoil.org>"]
license: "ISC"
homepage: "https://tangled.org/anil.recoil.org/ocaml-jmap"
bug-reports: "https://tangled.org/anil.recoil.org/ocaml-jmap/issues"
depends: [
  "dune" {>= "3.21"}
  "duration" {>= "0.3.1"}
  "ocaml" {>= "5.2"}
  "base64"
  "bytesrw"
  "jsont" {>= "0.3.0"}
  "jsonm"
  "json-pointer"
  "jscontact"
  "mail-flag"
  "ptime" {>= "1.0.0"}
  "eio"
  "eio_main"
  "fetch"
  "fetch-httpz"
  "httpz"
  "mtime"
  "optint"
  "cmdliner"
  "fmt"
  "alcotest" {with-test}
  "mdx" {with-test}
  "http" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://tangled.org/anil.recoil.org/ocaml-jmap"
x-maintenance-intent: ["(latest)"]
