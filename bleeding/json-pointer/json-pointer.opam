  "dune" {>= "3.21"}
  "ocaml" {>= "5.2.0"}
  "jsont" {>= "0.3.0"}
  "uriz"
  "bytesrw" {>= "0.3.0" & with-test}
  "mdx" {>= "2.4.1" & with-test}
  "odoc" {with-doc}
]
