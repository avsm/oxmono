; The vodozemac oracle is a cargo project; keep dune out of its build tree.

(dirs
 (:standard \ vodozemac-oracle))

(rule
 (alias runtest)
 (deps
  check_no_partial_failures.sh
  (source_tree ../lib))
 (action
  (run sh %{dep:check_no_partial_failures.sh} ..)))

