{
  "openapi": "3.0.3",
  "info": {
    "title": "Regression API",
    "version": "1.0 (* test *)"
  },
  "components": {
    "schemas": {
      "Widget": {
        "type": "object",
        "description": "Safe comments: (* and *)",
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "label": {
            "type": "string",
            "nullable": true,
            "minLength": 1
          },
          "tags": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "nullable": true
            }
          },
          "hint": {
            "type": "string",
            "nullable": true,
            "default": "hello"
          }
        }
      },
      "Problem": {
        "type": "object",
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string"
          }
        }
      },
      "Width": {
        "type": "object",
        "required": [
          "n32",
          "n64"
        ],
        "properties": {
          "n32": {
            "type": "integer",
            "format": "int32",
            "maximum": 9
          },
          "n64": {
            "type": "integer",
            "format": "int64",
            "maximum": 9007199254740992
          }
        }
      },
      "Choices": {
        "type": "object",
        "properties": {
          "one": {
            "oneOf": [
              {
                "type": "integer"
              },
              {
                "type": "number"
              }
            ]
          },
          "any": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "number"
              }
            ]
          }
        }
      },
      "OneChoice": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/Widget"
          },
          {
            "$ref": "#/components/schemas/Problem"
          }
        ]
      },
      "AnyChoice": {
        "anyOf": [
          {
            "$ref": "#/components/schemas/Widget"
          },
          {
            "$ref": "#/components/schemas/Problem"
          }
        ]
      }
    },
    "responses": {
      "Problem": {
        "description": "response",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "ProblemAlias": {
        "$ref": "#/components/responses/Problem"
      }
    },
    "requestBodies": {
      "Widgets": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/Widget"
              }
            }
          }
        }
      },
      "WidgetsAlias": {
        "$ref": "#/components/requestBodies/Widgets"
      }
    },
    "parameters": {
      "Query": {
        "name": "q",
        "in": "query",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "QueryAlias": {
        "$ref": "#/components/parameters/Query"
      }
    }
  },
  "paths": {
    "/widgets/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "q",
          "in": "query",
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "operationId": "getWidget",
        "responses": {
          "200": {
            "description": "response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Widget"
                }
              }
            }
          },
          "404": {
            "description": "response"
          },
          "4XX": {
            "$ref": "#/components/responses/ProblemAlias"
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/QueryAlias"
          },
          {
            "name": "X-Trace",
            "in": "header",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "client",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/widgets": {
      "get": {
        "operationId": "listWidgets",
        "responses": {
          "202": {
            "description": "response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Widget"
                  }
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteWidgets",
        "responses": {
          "204": {
            "description": "response"
          }
        },
        "requestBody": {
          "$ref": "#/components/requestBodies/WidgetsAlias"
        }
      }
    },
    "/maybe": {
      "get": {
        "operationId": "maybeWidget",
        "responses": {
          "200": {
            "description": "response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Widget"
                }
              }
            }
          },
          "204": {
            "description": "response"
          }
        }
      }
    },
    "/vendor": {
      "post": {
        "operationId": "vendorWidget",
        "responses": {
          "201": {
            "description": "response",
            "content": {
              "application/vnd.example+json": {
                "schema": {
                  "$ref": "#/components/schemas/Widget"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": false,
          "content": {
            "application/vnd.example+json": {
              "schema": {
                "$ref": "#/components/schemas/Widget"
              }
            }
          }
        }
      }
    },
    "/form": {
      "post": {
        "operationId": "sendForm",
        "responses": {
          "200": {
            "description": "response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "boolean"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "/upload": {
      "post": {
        "operationId": "uploadFile",
        "responses": {
          "204": {
            "description": "response"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "/raw": {
      "put": {
        "operationId": "putRaw",
        "responses": {
          "200": {
            "description": "response",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "/width": {
      "post": {
        "operationId": "sendWidth",
        "responses": {
          "204": {
            "description": "response"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Width"
              }
            }
          }
        }
      }
    },
    "/head": {
      "head": {
        "operationId": "getHead",
        "responses": {
          "200": {
            "description": "response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Widget"
                }
              }
            }
          }
        }
      }
    },
    "/matrix": {
      "get": {
        "operationId": "getMatrix",
        "responses": {
          "200": {
            "description": "response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/wildcard": {
      "get": {
        "operationId": "wildcardWidget",
        "responses": {
          "200": {
            "description": "value",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Widget"
                }
              }
            }
          },
          "2XX": {
            "description": "empty"
          }
        }
      }
    }
  }
}
