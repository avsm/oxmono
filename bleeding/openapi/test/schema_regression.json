{
  "openapi": "3.1.2",
  "info": {
    "title": "Schema regression",
    "version": "1"
  },
  "components": {
    "schemas": {
      "Presence": {
        "type": "object",
        "required": [
          "required"
        ],
        "properties": {
          "required": {
            "type": [
              "string",
              "null"
            ]
          },
          "optional": {
            "type": [
              "string",
              "null"
            ],
            "default": "annotation"
          }
        }
      },
      "Scalar": {
        "type": "integer",
        "minimum": 1,
        "maximum": 10,
        "enum": [
          1,
          3,
          5
        ]
      },
      "Alias": {
        "$ref": "#/components/schemas/Scalar"
      },
      "BatchItem": {
        "type": "integer",
        "minimum": 1
      },
      "BatchResponse": {
        "type": "array",
        "minItems": 1,
        "items": {
          "$ref": "#/components/schemas/BatchItem"
        }
      },
      "Node": {
        "type": "object",
        "required": [
          "value"
        ],
        "properties": {
          "value": {
            "type": "integer",
            "minimum": 1
          },
          "children": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Node"
            }
          }
        }
      },
      "Mixed": {
        "enum": [
          1,
          "one",
          null
        ]
      },
      "NullableObject": {
        "type": [
          "object",
          "null"
        ],
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "integer"
          }
        }
      },
      "Never": false,
      "Anything": true,
      "Intersection": {
        "allOf": [
          {
            "type": "object",
            "properties": {
              "n": {
                "type": "number",
                "minimum": 1
              }
            }
          },
          {
            "type": "object",
            "properties": {
              "n": {
                "type": "number",
                "maximum": 3
              }
            }
          }
        ],
        "required": [
          "n"
        ]
      },
      "Restricted": {
        "type": "object",
        "required": [
          "mode",
          "value"
        ],
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "safe"
            ]
          },
          "value": {
            "type": "number",
            "multipleOf": 0.1
          },
          "stamp": {
            "const": "fixed"
          }
        },
        "additionalProperties": false
      },
      "PetCat": {
        "type": "object",
        "required": [
          "kind",
          "meows"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "const": "PetCat"
          },
          "meows": {
            "type": "boolean"
          }
        }
      },
      "PetDog": {
        "type": "object",
        "required": [
          "kind",
          "barks"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "const": "PetDog"
          },
          "barks": {
            "type": "boolean"
          }
        }
      },
      "Pet": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/PetCat"
          },
          {
            "$ref": "#/components/schemas/PetDog"
          }
        ],
        "discriminator": {
          "propertyName": "kind"
        }
      },
      "BranchLow": {
        "type": "number",
        "maximum": 10
      },
      "BranchHigh": {
        "type": "number",
        "minimum": 0
      },
      "Branch": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/BranchLow"
          },
          {
            "$ref": "#/components/schemas/BranchHigh"
          }
        ]
      },
      "RefSibling": {
        "$ref": "#/components/schemas/Scalar",
        "minimum": 3
      },
      "UnionField": {
        "type": "object",
        "required": [
          "choice"
        ],
        "properties": {
          "choice": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "object",
                "required": [
                  "ok"
                ],
                "properties": {
                  "ok": {
                    "const": true
                  }
                }
              }
            ]
          }
        }
      },
      "LoopItem": {
        "type": "object",
        "required": [
          "n"
        ],
        "properties": {
          "n": {
            "type": "integer",
            "minimum": 1
          },
          "next": {
            "$ref": "#/components/schemas/LoopResponse"
          }
        }
      },
      "LoopResponse": {
        "type": "object",
        "required": [
          "n"
        ],
        "properties": {
          "n": {
            "type": "integer",
            "minimum": 1
          },
          "next": {
            "$ref": "#/components/schemas/LoopItem"
          }
        }
      },
      "Defaults": {
        "type": "object",
        "properties": {
          "precise": {
            "type": "number",
            "default": 0.30000000000000004
          },
          "integer": {
            "type": "integer",
            "default": 1.5
          },
          "notNull": {
            "type": "integer",
            "default": null
          }
        }
      },
      "KeyNames": {
        "type": "object",
        "required": [
          "v",
          "jsont"
        ],
        "properties": {
          "v": {
            "type": "string"
          },
          "jsont": {
            "type": "string"
          }
        }
      },
      "KeyEnum": {
        "type": "string",
        "enum": [
          "__strange",
          "9value"
        ]
      }
    }
  },
  "paths": {
    "/choice": {
      "get": {
        "operationId": "getChoice",
        "responses": {
          "200": {
            "description": "result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string",
                  "minLength": 2
                }
              }
            }
          },
          "201": {
            "description": "result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "integer",
                  "minimum": 2
                }
              }
            }
          }
        }
      }
    },
    "/input": {
      "post": {
        "operationId": "sendInput",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "amount"
                ],
                "properties": {
                  "amount": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "ok"
          }
        }
      }
    },
    "/nested": {
      "get": {
        "operationId": "getNested",
        "responses": {
          "200": {
            "description": "result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Node/properties/value"
                }
              }
            }
          }
        }
      }
    },
    "/items": {
      "get": {
        "responses": {
          "204": {
            "description": "ok"
          }
        }
      }
    },
    "/items/{id}": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "ok"
          }
        }
      }
    }
  }
}
