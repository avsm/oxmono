(lang dune 3.21)
(name proffer)

(generate_opam_files true)

(source (github avsm/proffer))
(documentation "https://avsm.github.io/proffer/")
(license ISC)
(authors "Anil Madhavapeddy")
(maintainers "anil@recoil.org")

(package
 (name proffer)
 (synopsis "Declarative HTTP serving with interchangeable backends")
 (description
  "Proffer describes sites as data: handlers describe responses through a
callback, routes capture path segments as curried arguments, and caching policy
and media codecs are typed. Jsont and Cmarkit adapters are included in the
main library. Route constructors take their handler at portable, so the
OxCaml compiler is required.")
 (tags (http server web routing))
 (depends
  (ocaml (>= 5.2))
  httpz
  (bytesrw (>= 0.4.0))
  (magic-mime (>= 1.3.1))
  (cmarkit (>= 0.4.0))
  (fetch (and :with-test))
  (eio (and (>= 1.3) :with-test))
  (alcotest :with-test)))

(package
 (name proffer-httpz)
 (synopsis "Proffer backend on the httpz parser and Eio")
 (description
  "Serves a Proffer site over HTTP/1.1 using httpz and Eio, with bounded
concurrency, first-byte and idle deadlines, and optional TLS.")
 (tags (http server web eio))
 (depends
  (ocaml (>= 5.2))
  proffer
  httpz
  (eio (>= 1.3))
  (cstruct (>= 6.0.0))
  base-unix
  (eio_main (and :with-test (>= 1.3)))))
