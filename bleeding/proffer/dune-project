(lang dune 3.21)
(name proffer)

(generate_opam_files true)
(implicit_transitive_deps false)

(source (github avsm/proffer))
(documentation "https://avsm.github.io/proffer/")
(license ISC)
(authors "Anil Madhavapeddy")
(maintainers "anil@recoil.org")

(package
 (name proffer)
 (license ISC)
 (synopsis "Declarative HTTP serving with interchangeable backends")
 (description
  "Proffer describes sites as data: handlers describe responses through a
callback, routes capture path segments as curried arguments, and caching policy
and media codecs are typed. JSON and CommonMark adapters are included through
the httpz media libraries. Route constructors preserve OxCaml portability.")
 (tags (http server web routing))
 (depends
  (duration (>= 0.3.1))
  (ocaml (>= 5.2))
  (httpz (= :version))
  (base (>= v0.16.0))
  (bytesrw (>= 0.4.0))
  (cmarkit (>= 0.4.0))
  (fetch (= :version))
  davz
  http
  xmlm
  uriz
  cstruct
  (eio (>= 1.3))
  (fetch-httpz (and (= :version) :with-test))
  (eio_main (and (>= 1.3) :with-test))
  (x509 :with-test)
  (ptime :with-test)
  (alcotest :with-test)))

(package
 (name proffer-httpz)
 (license ISC)
 (synopsis "Proffer backend on the httpz parser and Eio")
 (description
  "Serves a compiled Proffer site over HTTP/1.1 using httpz and Eio, with
bounded concurrency, request deadlines, and optional TLS.")
 (tags (http server web eio))
 (depends
  (duration (>= 0.3.1))
  (ocaml (>= 5.2))
  (proffer (= :version))
  (httpz (= :version))
  (eio (>= 1.3))
  (cstruct (>= 6.0.0))
  (mtime (>= 2.0.0))
  base-unix
  (eio_main (and :with-test (>= 1.3)))))
