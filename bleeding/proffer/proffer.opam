# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Declarative HTTP serving with interchangeable backends"
description: """
Proffer describes sites as data: handlers describe responses through a
callback, routes capture path segments as curried arguments, and caching policy
and media codecs are typed. Jsont and Cmarkit adapters are included in the
main library. Route constructors take their handler at portable, so the
OxCaml compiler is required."""
maintainer: ["anil@recoil.org"]
authors: ["Anil Madhavapeddy"]
license: "ISC"
tags: ["http" "server" "web" "routing"]
homepage: "https://github.com/avsm/proffer"
doc: "https://avsm.github.io/proffer/"
bug-reports: "https://github.com/avsm/proffer/issues"
depends: [
  "dune" {>= "3.21"}
  "ocaml" {>= "5.2"}
  "httpz"
  "bytesrw" {>= "0.4.0"}
  "magic-mime" {>= "1.3.1"}
  "cmarkit" {>= "0.4.0"}
  "fetch" {with-test}
  "eio" {>= "1.3" & with-test}
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/avsm/proffer.git"
x-maintenance-intent: ["(latest)"]
