# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Declarative HTTP serving with interchangeable backends"
description: """
Proffer describes sites as data: handlers describe responses through a
callback, routes capture path segments as curried arguments, and caching policy
and media codecs are typed. JSON and CommonMark adapters are included through
the httpz media libraries. Route constructors preserve OxCaml portability."""
maintainer: ["anil@recoil.org"]
authors: ["Anil Madhavapeddy"]
license: "ISC"
tags: ["http" "server" "web" "routing"]
homepage: "https://github.com/avsm/proffer"
doc: "https://avsm.github.io/proffer/"
bug-reports: "https://github.com/avsm/proffer/issues"
depends: [
  "dune" {>= "3.21"}
  "duration" {>= "0.3.1"}
  "ocaml" {>= "5.2"}
  "httpz" {= version}
  "base" {>= "v0.16.0"}
  "bytesrw" {>= "0.4.0"}
  "cmarkit" {>= "0.4.0"}
  "fetch" {= version}
  "davz"
  "http"
  "xmlm"
  "uriz"
  "cstruct"
  "eio" {>= "1.3"}
  "fetch-httpz" {= version & with-test}
  "eio_main" {>= "1.3" & with-test}
  "x509" {with-test}
  "ptime" {with-test}
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/avsm/proffer.git"
x-maintenance-intent: ["(latest)"]
