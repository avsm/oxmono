(test
 (name test_eio)
 (package zarrz-eio)
 (libraries
  zarrz
  zarrz_eio
  eio_main
  alcotest
  jsont
  jsont.bytesrw
  base_bigstring
  stdlib_stable
  stdlib_upstream_compatible)
 (deps
  (source_tree ../fixtures)))

; The conformance executable against two fixtures whose every element is
; known, byte compared with the output the oracle prints. Generated by
; hand from the values ../fixtures/README.md records, never from a run.

(rule
 (deps
  (source_tree ../fixtures)
  %{exe:../../conformance/zarrz_conformance.exe})
 (action
  (with-stdout-to
   array_none.out
   (run
    %{exe:../../conformance/zarrz_conformance.exe}
    --array_path
    ../fixtures/v3/array_none.zarr))))

(rule
 (alias runtest)
 (package zarrz-eio)
 (action
  (diff array_none.expected array_none.out)))

(rule
 (deps
  (source_tree ../fixtures)
  %{exe:../../conformance/zarrz_conformance.exe})
 (action
  (with-stdout-to
   sharded.out
   (run
    %{exe:../../conformance/zarrz_conformance.exe}
    --array_path
    ../fixtures/sharded_array_write_read.zarr/group/array))))

(rule
 (alias runtest)
 (package zarrz-eio)
 (action
  (diff sharded.expected sharded.out)))
