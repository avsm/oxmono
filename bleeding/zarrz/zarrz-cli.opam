opam-version: "2.0"
synopsis: "Inspect Zarr V3 stores"
description: """
The zarr command reads the metadata of a local or remote Zarr V3
store and prints what is in it, what one node is, and what it costs to
read. Consolidated metadata makes the whole hierarchy one request."""
maintainer: ["Anil Madhavapeddy <anil@recoil.org>"]
authors: ["Anil Madhavapeddy"]
license: "ISC"
homepage: "https://tangled.org/anil.recoil.org/ocaml-zarrz"
bug-reports: "https://tangled.org/anil.recoil.org/ocaml-zarrz/issues"
depends: [
  "dune" {>= "3.21"}
  "ocaml" {>= "5.2.0"}
  "zarrz" {= version}
  "zarrz-eio" {= version}
  "zarrz-fetch" {= version}
  "base_bigstring"
  "fetch-curl"
  "eio_main"
  "cmdliner"
  "jsont"
  "odoc" {with-doc}
  "alcotest" {with-test}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://tangled.org/anil.recoil.org/ocaml-zarrz"
x-maintenance-intent: ["(latest)"]
x-ai-disclosure: "ai-generated"
x-ai-model: "claude-fable-5"
x-ai-provider: "Anthropic"
