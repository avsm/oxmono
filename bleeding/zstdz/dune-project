(lang dune 3.21)
(name zstdz)

(generate_opam_files true)

(license ISC)
(authors "Anil Madhavapeddy <anil@recoil.org>")
(maintainers "Anil Madhavapeddy <anil@recoil.org>")
(source (tangled anil.recoil.org/ocaml-zstdz))

(package
 (name zstdz)
 (synopsis "Zstandard compression for OxCaml")
 (description
  "Bindings to libzstd for OxCaml. Compression and decompression work
directly on caller-supplied bigstrings, frame probing returns
stack-allocated results, and the runtime lock is released around the
larger calls.")
 (depends
  (ocaml (>= 5.2.0))
  conf-zstd
  base_bigstring
  (odoc :with-doc)
  (alcotest :with-test)))
