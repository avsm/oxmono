# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Zstandard compression for OxCaml"
description: """
Bindings to libzstd for OxCaml. Compression and decompression work
directly on caller-supplied bigstrings, frame probing returns
stack-allocated results, and the runtime lock is released around the
larger calls."""
maintainer: ["Anil Madhavapeddy <anil@recoil.org>"]
authors: ["Anil Madhavapeddy <anil@recoil.org>"]
license: "ISC"
homepage: "https://tangled.org/anil.recoil.org/ocaml-zstdz"
bug-reports: "https://tangled.org/anil.recoil.org/ocaml-zstdz/issues"
depends: [
  "dune" {>= "3.21"}
  "ocaml" {>= "5.2.0"}
  "dune-configurator"
  "conf-zstd"
  "base_bigstring"
  "odoc" {with-doc}
  "alcotest" {with-test}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://tangled.org/anil.recoil.org/ocaml-zstdz"
x-maintenance-intent: ["(latest)"]
