# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "OCaml bindings for the Zulip REST API with bot framework"
description:
  "OCaml bindings for the Zulip REST API using Fetch and Eio, with Jsont protocol codecs, composable bots, and XDG profiles."
maintainer: ["Anil Madhavapeddy <anil@recoil.org>"]
authors: ["Anil Madhavapeddy"]
license: "ISC"
homepage: "https://tangled.org/anil.recoil.org/ocaml-zulip"
bug-reports: "https://tangled.org/anil.recoil.org/ocaml-zulip/issues"
depends: [
  "dune" {>= "3.21"}
  "ocaml" {>= "5.2"}
  "eio" {>= "1.3"}
  "fetch"
  "fetch-httpz"
  "httpz"
  "http"
  "duration"
  "jsont" {>= "0.4.0"}
  "bytesrw"
  "xdge"
  "logs"
  "fmt"
  "eio_main"
  "cmdliner"
  "odoc" {with-doc}
  "alcotest" {with-test}
  "conf-python-3" {with-test}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://tangled.org/anil.recoil.org/ocaml-zulip"
x-maintenance-intent: ["(latest)"]
