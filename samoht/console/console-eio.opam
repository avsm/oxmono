bug-reports: "https://tangled.org/gazagnaire.org/ocaml-console/issues"
depends: [
  "dune" {>= "3.21"}
  "ocaml" {>= "5.1"}
  "console"
  "eio" {>= "1.0"}
  "fmt"
  "logs"
  "cstruct"
  "optint"
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://tangled.org/gazagnaire.org/ocaml-console"
x-maintenance-intent: ["(latest)"]
