# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Terminal styling and layout widgets"
description: """
Type-safe terminal styling (colors, bold, italic) and layout widgets
   (tables, trees, panels) for OCaml CLI applications. Inspired by
   Python's Rich and Go's Charm/lipgloss."""
maintainer: ["Thomas Gazagnaire <thomas@gazagnaire.org>"]
authors: ["Thomas Gazagnaire <thomas@gazagnaire.org>"]
license: "ISC"
tags: ["org:blacksun" "cli" "format"]
homepage: "https://tangled.org/gazagnaire.org/ocaml-console"
bug-reports: "https://tangled.org/gazagnaire.org/ocaml-console/issues"
depends: [
  "dune" {>= "3.21"}
  "ocaml" {>= "5.1"}
  "fmt" {>= "0.9"}
  "logs"
  "uucp"
  "uuseg"
  "uutf" {>= "1.0"}
  "alcotest" {with-test}
  "mdx" {with-test}
  "alcobar" {with-test}
  "eio_main" {with-test}
  "re" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://tangled.org/gazagnaire.org/ocaml-console"
x-maintenance-intent: ["(latest)"]
