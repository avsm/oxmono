(library
 (name taposaur_review_store)
 (public_name taposaur.review-store)
 (private_modules schema)
 (libraries
  taposaur.audit
  taposaur
  taposaur.review
  sqlite3
  sqlite3-eio
  eio
  unix
  jsont
  jsont.bytesrw))

(rule
 (target schema.ml)
 (deps schema.sql)
 (action
  (with-stdout-to
   %{target}
   (progn
    (echo "let sql = {sql|")
    (cat %{dep:schema.sql})
    (echo "|sql}")))))
