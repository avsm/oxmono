(library
 (name taposaur_ui)
 (public_name taposaur.ui)
 (modules taposaur_ui stylesheet widgets)
 (private_modules stylesheet widgets)
 (libraries htmlit))

(rule
 (target stylesheet.ml)
 (deps style.css)
 (action
  (with-stdout-to
   %{target}
   (progn
    (echo "let source = {css|")
    (cat %{dep:style.css})
    (echo "|css}")))))

(rule
 (target widgets.ml)
 (deps widgets.js)
 (action
  (with-stdout-to
   %{target}
   (progn
    (echo "let source = {js|")
    (cat %{dep:widgets.js})
    (echo "|js}")))))
