(library
 (name taposaur_ui)
 (public_name taposaur.ui)
 (modules taposaur_ui stylesheet)
 (private_modules stylesheet)
 (libraries htmlit sitekit))

(rule
 (target stylesheet.ml)
 (deps style.css)
 (action
  (with-stdout-to
   %{target}
   (progn
    (echo "let source = {css|")
    (cat %{dep:style.css})
    (echo "|css}")))))
