(rule
 (target client.ml)
 (deps interface.js)
 (action
  (with-stdout-to
   %{target}
   (progn
    (echo "let source = Taposaur_ui.javascript ^ {js|")
    (cat %{dep:interface.js})
    (echo "|js}")))))

(rule
 (target katex.ml)
 (deps assets/katex.min.js)
 (action
  (with-stdout-to
   %{target}
   (progn
    (echo "let source = {js|")
    (cat %{dep:assets/katex.min.js})
    (echo "|js}")))))
