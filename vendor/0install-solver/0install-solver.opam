version: "2.18"
opam-version: "2.0"
synopsis: "Package dependency solver"
maintainer: "talex5@gmail.com"
authors: "zero-install-devel@lists.sourceforge.net"
homepage: "https://docs.0install.net/developers/solver/"
bug-reports: "https://github.com/0install/0install/issues"
dev-repo: "git+https://github.com/0install/0install.git"
doc: "https://0install.github.io/0install/"
build: [
  ["dune" "build" "-p" name "-j" jobs "@install"]
]
depends: [
  "ocaml" {>= "4.08.0"}
  "dune" {>= "2.5"}
]
description: """
This library resolves package dependencies using the 0install SAT-based
solver. The import retains the generic solver without application commands
or switch contexts. The retained implementation is unchanged."""