version: "3.5.2"
opam-version: "2.0"
maintainer: "mirageos-devel@lists.xenproject.org"
authors: [ "Thomas Gazagnaire"
           "Anil Madhavapeddy" "Calascibetta Romain"
           "Peter Zotov" ]
license: "ISC"
homepage: "https://github.com/mirage/ocaml-base64"
doc: "https://mirage.github.io/ocaml-base64/"
bug-reports: "https://github.com/mirage/ocaml-base64/issues"
dev-repo: "git+https://github.com/mirage/ocaml-base64.git"
synopsis: "Base64 encoding for OCaml"
description: """
This library encodes and decodes Base64 as specified in RFC 4648. The
ocaml-base64 import uses immutable alphabet tables and OxCaml portability
annotations."""
depends: [
  "ocaml" {>= "4.07.0"}
  "dune" {>= "2.3"}
]
build: [
  ["dune" "build" "-p" name "-j" jobs]
]
