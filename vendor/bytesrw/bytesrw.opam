version: "0.4.0"
opam-version: "2.0"
name: "bytesrw"
synopsis: "OxCaml-portable byte stream readers and writers"
description: """\
This vendored OxCaml port contains the pure-OCaml Bytesrw 0.4.0 core. It adds
local and zero-allocation annotations and a selective portable operation
surface used by Jsont and Httpz media codecs. Optional compression,
cryptography, Unix, and command-line sublibraries are not included."""
maintainer: "Daniel Bünzli <daniel.buenzli@erratique.ch>"
authors: "The bytesrw programmers"
license: "ISC"
tags: ["bytes" "streaming" "oxcaml" "org:erratique"]
homepage: "https://erratique.ch/software/bytesrw"
doc: "https://erratique.ch/software/bytesrw/doc"
bug-reports: "https://github.com/dbuenzli/bytesrw/issues"
dev-repo: "git+https://github.com/dbuenzli/bytesrw.git"
depends: [
  "oxcaml-compiler" {>= "5.2.0minus39"}
  "dune" {>= "3.21"}
  "base"
]
build: [
  ["dune" "build" "-p" name "-j" jobs]
]
x-maintenance-intent: ["(latest)"]
