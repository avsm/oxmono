# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Eio backend for console"
description: """
This package runs Console progress displays and terminal input through Eio.
It handles terminal cleanup and supports line-oriented or JSON output
outside terminals. Local adaptations account for OxCaml callback modes and
portable text processing."""
maintainer: ["Thomas Gazagnaire <thomas@gazagnaire.org>"]
authors: ["Thomas Gazagnaire <thomas@gazagnaire.org>"]
license: "ISC"
tags: ["command-line-utilities" "format" "eio"]
homepage: "https://github.com/samoht/ocaml-console"
bug-reports: "https://github.com/samoht/ocaml-console/issues"
depends: [
  "dune" {>= "3.21"}
  "ocaml" {>= "5.2"}
  "console" {= version}
  "eio" {>= "1.4"}
  "mtime" {>= "2.0.0"}
  "fmt"
  "logs"
  "alcotest" {with-test & >= "1.7.0"}
  "astring" {with-test}
  "mdx" {with-test}
  "cmdliner" {with-test}
  "cstruct" {with-test}
  "eio_main" {with-test}
  "alcobar" {with-test & >= "0.3.2"}
  "jsont" {with-test}
  "bytesrw" {with-test}
  "k7" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/samoht/ocaml-console.git"
x-maintenance-intent: ["(latest)"]
