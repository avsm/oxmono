# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Colours, tables, trees and progress rows for the terminal"
description: """
Console renders styled text, tables, trees, panels and progress rows in
terminal scrollback. This ocaml-console import adds OCaml 5.2 compatibility
helpers, OxCaml codec and callback adaptations, and unboxed colour
arithmetic."""
maintainer: ["Thomas Gazagnaire <thomas@gazagnaire.org>"]
authors: ["Thomas Gazagnaire <thomas@gazagnaire.org>"]
license: "ISC"
tags: ["command-line-utilities" "format"]
homepage: "https://github.com/samoht/ocaml-console"
bug-reports: "https://github.com/samoht/ocaml-console/issues"
depends: [
  "dune" {>= "3.21"}
  "ocaml" {>= "5.2"}
  "fmt" {>= "0.9"}
  "uucp" {>= "17.0.0"}
  "uuseg" {>= "17.0.0"}
  "jsont" {>= "0.3.0"}
  "bytesrw" {>= "0.1.0"}
  "matrix" {>= "0.1.0" & < "0.2.0"}
  "alcotest" {with-test & >= "1.7.0"}
  "astring" {with-test}
  "mdx" {with-test}
  "alcobar" {with-test & >= "0.3.2"}
  "re" {with-test}
  "cmdliner" {with-test}
  "k7" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/samoht/ocaml-console.git"
x-maintenance-intent: ["(latest)"]
