(lang dune 3.21)
(using mdx 0.4)

(name console)

(generate_opam_files true)
(implicit_transitive_deps false)

(license ISC)
(authors "Thomas Gazagnaire <thomas@gazagnaire.org>")
(maintainers "Thomas Gazagnaire <thomas@gazagnaire.org>")

(source (github samoht/ocaml-console))

(package
 (name console)
 (synopsis "Colours, tables, trees and progress rows for the terminal")
 (tags (command-line-utilities format))
 (description
  "Console renders styled text, tables, trees, panels and progress rows in
terminal scrollback. This ocaml-console import adds OCaml 5.2 compatibility
helpers, OxCaml codec and callback adaptations, and unboxed colour
arithmetic.")
 (depends
  (ocaml (>= 5.2))
  (fmt (>= 0.9))
  (uucp (>= 17.0.0))
  (uuseg (>= 17.0.0))
  (jsont (>= 0.3.0))
  (bytesrw (>= 0.1.0))
  ; The tests' terminal emulator, from the released matrix. It lacks fixes
  ; some tests need, which are skipped until console moves to matrix 0.2.0.
  (matrix (and (>= 0.1.0) (< 0.2.0)))
  (alcotest (and :with-test (>= 1.7.0)))
  (astring :with-test)
  (mdx :with-test)
  (alcobar (and :with-test (>= 0.3.2)))
  (re :with-test)
  (cmdliner :with-test)
  (k7 :with-test)))

(package
 (name console-eio)
 (synopsis "Eio backend for console")
 (tags (command-line-utilities format eio))
 (description
  "This package runs Console progress displays and terminal input through Eio.
It handles terminal cleanup and supports line-oriented or JSON output
outside terminals. Local adaptations account for OxCaml callback modes and
portable text processing.")
 (depends
  (ocaml (>= 5.2))
  (console (= :version))
  (eio (>= 1.4))
  (mtime (>= 2.0.0))
  fmt
  logs
  (alcotest (and :with-test (>= 1.7.0)))
  (astring :with-test)
  (mdx :with-test)
  (cmdliner :with-test)
  (cstruct :with-test)
  (eio_main :with-test)
  (alcobar (and :with-test (>= 0.3.2)))
  (jsont :with-test)
  (bytesrw :with-test)
  (k7 :with-test)))
