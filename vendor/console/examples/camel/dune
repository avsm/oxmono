(executable
 (name main)
 (libraries console_compat console console-eio console.tty eio eio_main fmt mtime))

(rule
 (enabled_if %{lib-available:console-eio})
 (target camel.cast)
 (action
  (setenv
   CONSOLE_CAST
   %{target}
   (setenv
    COLUMNS
    80
    (setenv
     LINES
     17
     (setenv
      COLORTERM
      truecolor
      (run ./main.exe 2026 10 40 60 78 117 136)))))))

(rule
 (enabled_if %{lib-available:console-eio})
 (target camel.generated.svg)
 (action
  (run
   %{bin:k7}
   play
   --show
   "dune exec -- examples/camel/main.exe"
   -o
   %{target}
   %{dep:camel.cast})))

(rule
 (alias runtest)
 (enabled_if %{lib-available:console-eio})
 (action
  (diff camel.svg camel.generated.svg)))
