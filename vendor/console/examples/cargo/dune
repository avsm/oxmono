(executable
 (name main)
 (libraries console_compat console console.tty console-eio eio eio_main fmt))

(rule
 (enabled_if %{lib-available:console-eio})
 (target cargo.cast)
 (action
  (setenv
   CONSOLE_CAST
   %{target}
   (setenv
    LINES
    24
    (run ./main.exe)))))

(rule
 (enabled_if %{lib-available:console-eio})
 (target cargo.generated.svg)
 (action
  (run
   %{bin:k7}
   play
   --show
   "dune exec -- examples/cargo/main.exe"
   -o
   %{target}
   %{dep:cargo.cast})))

(rule
 (alias runtest)
 (enabled_if %{lib-available:console-eio})
 (action
  (diff cargo.svg cargo.generated.svg)))
