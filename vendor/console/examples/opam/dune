(executable
 (name main)
 (libraries console_compat console console.tty console-eio eio eio_main fmt))

(rule
 (enabled_if %{lib-available:console-eio})
 (target opam.cast)
 (action
  (setenv
   CONSOLE_CAST
   %{target}
   (setenv
    LINES
    30
    (run ./main.exe)))))

(rule
 (enabled_if %{lib-available:console-eio})
 (target opam.generated.svg)
 (action
  (run
   %{bin:k7}
   play
   --show
   "opam install dune cmdliner fmt"
   -o
   %{target}
   %{dep:opam.cast})))

(rule
 (alias runtest)
 (enabled_if %{lib-available:console-eio})
 (action
  (diff opam.svg opam.generated.svg)))
