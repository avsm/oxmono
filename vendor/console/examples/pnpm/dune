(executable
 (name main)
 (libraries console_compat console console.tty console-eio eio eio_main fmt))

(rule
 (enabled_if %{lib-available:console-eio})
 (target pnpm.cast)
 (action
  (setenv
   CONSOLE_CAST
   %{target}
   (setenv
    LINES
    30
    (run ./main.exe)))))

(rule
 (enabled_if %{lib-available:console-eio})
 (target pnpm.generated.svg)
 (action
  (run
   %{bin:k7}
   play
   --show
   "dune exec -- examples/pnpm/main.exe"
   -o
   %{target}
   %{dep:pnpm.cast})))

(rule
 (alias runtest)
 (enabled_if %{lib-available:console-eio})
 (action
  (diff pnpm.svg pnpm.generated.svg)))
