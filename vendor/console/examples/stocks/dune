(executable
 (name main)
 (libraries console_compat console console.tty console-eio eio eio_main fmt cmdliner))

(rule
 (enabled_if %{lib-available:console-eio})
 (target stocks.cast)
 (action
  (setenv
   CONSOLE_CAST
   %{target}
   (setenv
    LINES
    30
    (run ./main.exe)))))

(rule
 (enabled_if %{lib-available:console-eio})
 (target stocks.generated.svg)
 (action
  (run
   %{bin:k7}
   play
   --show
   "dune exec -- examples/stocks/main.exe"
   -o
   %{target}
   %{dep:stocks.cast})))

(rule
 (alias runtest)
 (enabled_if %{lib-available:console-eio})
 (action
  (diff stocks.svg stocks.generated.svg)))
