 (enabled_if %{lib-available:console-eio})
 (target dos.generated.svg)
 (action
  (run
   %{bin:k7}
   play
   --show
   ""
   --theme
   "{\"name\": \"demo\", \"background\": \"#000000\", \"foreground\": \"#dddddd\", \"cursor\": \"#dddddd\", \"selection\": \"#dddddd\"}"
