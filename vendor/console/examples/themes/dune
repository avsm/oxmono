(executable
 (name main)
 (libraries console_compat console console.tty console-eio eio eio_main fmt))

(rule
 (enabled_if %{lib-available:console-eio})
 (target default.cast)
 (action
  (setenv
   CONSOLE_CAST
   %{target}
   (setenv
    COLUMNS
    60
    (setenv
     LINES
     21
     (run ./main.exe default))))))

(rule
 (enabled_if %{lib-available:console-eio})
 (target default.generated.svg)
 (action
  (run %{bin:k7} play --show "" -o %{target} %{dep:default.cast})))

(rule
 (alias runtest)
 (enabled_if %{lib-available:console-eio})
 (action
  (diff default.svg default.generated.svg)))

