version: "0.3.0"
opam-version: "2.0"
maintainer: "Hannes Mehnert <hannes@mehnert.org>"
authors: "Hannes Mehnert <hannes@mehnert.org>"
license: "ISC"
homepage: "https://github.com/hannesm/gmap"
doc: "https://hannesm.github.io/gmap/doc"
bug-reports: "https://github.com/hannesm/gmap/issues"
depends: [
  "ocaml" {>= "4.04.2"}
  "dune" {>= "1.0"}
  "alcotest" {with-test}
  "fmt" {with-test}
]
build: [
  ["dune" "subst"] {dev}
  ["dune" "build" "-p" name "-j" jobs]
  ["dune" "runtest" "-p" name "-j" jobs] {with-test}
]
dev-repo: "git+https://github.com/hannesm/gmap.git"
synopsis: "Heterogenous maps over a GADT"
description: """
Gmap constructs heterogeneous maps from GADT key types, associating each key
with a value of its corresponding type. This copy adds OxCaml portability
annotations to the upstream interface."""
x-maintenance-intent: [ "(latest)" ]
