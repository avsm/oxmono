version: "0.4.0"
opam-version: "2.0"
name: "jsont"
synopsis: "Portable declarative JSON data manipulation for OxCaml"
description: """
Jsont describes typed JSON data for decoding, encoding and transformation.
This import includes the core and Bytesrw codec. Local changes make
descriptions portable and contention-safe, adapt callbacks and defaults, and
optimize ignored-string scanning. The optional Brr and Typegist libraries
are omitted."""
maintainer: "Daniel Bünzli <daniel.buenzli@erratique.ch>"
authors: "The jsont programmers"
license: "ISC"
tags: ["json" "codec" "oxcaml" "org:erratique"]
homepage: "https://erratique.ch/software/jsont"
doc: "https://erratique.ch/software/jsont/doc"
bug-reports: "https://github.com/dbuenzli/jsont/issues"
dev-repo: "git+https://github.com/dbuenzli/jsont.git"
depends: [
  "oxcaml-compiler" {>= "5.2.0minus39"}
  "dune" {>= "3.21"}
  "base"
  "bytesrw" {>= "0.4.0"}
]
build: [
  ["dune" "build" "-p" name "-j" jobs]
]
x-maintenance-intent: ["(latest)"]
