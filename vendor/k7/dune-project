(lang dune 3.21)
(using mdx 0.4)
(name k7)

(generate_opam_files true)
(implicit_transitive_deps false)

(license ISC)
(authors "Thomas Gazagnaire <thomas@gazagnaire.org>")
(maintainers "Thomas Gazagnaire <thomas@gazagnaire.org>")
(source (github samoht/ocaml-k7))

(package
 (name k7)
 (synopsis
  "Record terminal sessions and draw them as animated SVG images")
 (tags (command-line-utilities format eio))
 (description
  "K7 records terminal sessions and renders asciicast recordings as animated
SVG images. It also provides OCaml descriptions of VHS tapes. This ocaml-k7
import adds OCaml 5.2 compatibility helpers and adapts Jsont codecs,
callbacks and Eio sinks for OxCaml.")
 (depends
  (ocaml (>= 5.2))
  (eio (>= 1.6))
  (eio_main (>= 1.6))
  (fmt (>= 0.8.7))
  (cmdliner (>= 2.0.0))
  dune-build-info
  (alcotest :with-test)
  (mtime (>= 2.0.0))
  (cstruct (>= 6.0.1))
  (matrix (and (>= 0.1.0) (< 0.2.0)))
  (re (>= 1.10.0))
  (jsont (>= 0.4.0))
  (bytesrw (>= 0.1.0))
  (markup (and (>= 1.0.0) :with-test))
  (alcobar (and :with-test (>= 0.3.2)))
  (mdx :with-test)
  (odoc :with-doc)))
