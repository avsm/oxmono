# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Record terminal sessions and draw them as animated SVG images"
description: """
K7 records terminal sessions and renders asciicast recordings as animated
SVG images. It also provides OCaml descriptions of VHS tapes. This ocaml-k7
import adds OCaml 5.2 compatibility helpers and adapts Jsont codecs,
callbacks and Eio sinks for OxCaml."""
maintainer: ["Thomas Gazagnaire <thomas@gazagnaire.org>"]
authors: ["Thomas Gazagnaire <thomas@gazagnaire.org>"]
license: "ISC"
tags: ["command-line-utilities" "format" "eio"]
homepage: "https://github.com/samoht/ocaml-k7"
bug-reports: "https://github.com/samoht/ocaml-k7/issues"
depends: [
  "dune" {>= "3.21"}
  "ocaml" {>= "5.2"}
  "eio" {>= "1.6"}
  "eio_main" {>= "1.6"}
  "fmt" {>= "0.8.7"}
  "cmdliner" {>= "2.0.0"}
  "dune-build-info"
  "alcotest" {with-test}
  "mtime" {>= "2.0.0"}
  "cstruct" {>= "6.0.1"}
  "matrix" {>= "0.1.0" & < "0.2.0"}
  "re" {>= "1.10.0"}
  "jsont" {>= "0.4.0"}
  "bytesrw" {>= "0.1.0"}
  "markup" {>= "1.0.0" & with-test}
  "alcobar" {with-test & >= "0.3.2"}
  "mdx" {with-test}
  "odoc" {with-doc}
]
dev-repo: "git+https://github.com/samoht/ocaml-k7.git"
x-maintenance-intent: ["(latest)"]
available: os != "win32"
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test & os != "macos"}
    "@doc" {with-doc}
  ]
]
