version: "2.2.0"
opam-version: "2.0"
name: "mtime"
synopsis: "Monotonic wall-clock time for OCaml"
description: """
Mtime represents monotonic timestamps and time spans with nanosecond
precision. This import includes the core and native clock backend. Local
changes add immutable kinds and portable interfaces. JavaScript and toplevel
support are omitted."""
maintainer: "Daniel Bünzli <daniel.buenzl i@erratique.ch>"
authors: "The mtime programmers"
license: "ISC"
tags: ["time" "monotonic" "system" "org:erratique"]
homepage: "https://erratique.ch/software/mtime"
doc: "https://erratique.ch/software/mtime/doc/"
bug-reports: "https://github.com/dbuenzli/mtime/issues"
depends: [
  "ocaml" {>= "4.08.0"}
  "dune" {>= "3.21"}
]
build: [
  ["dune" "build" "-p" name "-j" jobs]
]
dev-repo: "git+https://erratique.ch/repos/mtime.git"
x-maintenance-intent: ["(latest)"]
