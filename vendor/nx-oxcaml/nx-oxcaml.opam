# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "High-performance Nx backend using OxCaml's unboxed types"
description: """
Nx-oxcaml implements an Nx backend using OxCaml unboxed arrays and NEON or
SSE kernels. Local changes adapt scalar type names and compiler constraints
for OxCaml 5.2. The upstream backend tests are retained and benchmarks are
omitted."""
maintainer: ["Thibaut Mattio <thibaut.mattio@gmail.com>"]
authors: ["Thibaut Mattio"]
license: "ISC"
homepage: "https://github.com/raven-ml/nx-oxcaml"
bug-reports: "https://github.com/raven-ml/nx-oxcaml/issues"
depends: [
  "ocaml" {>= "5.2.0"}
  "dune" {>= "3.21"}
  "nx" {= "1.0.0~alpha3"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/raven-ml/nx-oxcaml.git"
x-maintenance-intent: ["(latest)"]
