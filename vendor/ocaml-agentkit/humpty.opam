# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "A terminal agent over a local DS4 model"
description:
  "humpty runs a DeepSeek or GLM model on your own machine, as a single prompt or as an agent with tools, in a terminal interface."
maintainer: ["Anil Madhavapeddy <anil@recoil.org>"]
authors: ["Anil Madhavapeddy"]
license: "ISC"
tags: ["org:blacksun" "ds4" "llm" "agent" "tui"]
homepage: "https://tangled.org/anil.recoil.org/ocaml-agentkit"
bug-reports: "https://tangled.org/anil.recoil.org/ocaml-agentkit/issues"
depends: [
  "dune" {>= "3.21"}
  "ocaml" {>= "5.2.0"}
  "ds4"
  "agentkit" {= version}
  "agentkit-ds4" {= version}
  "dune-rpc-eio"
  "dune-rpc" {>= "3.24"}
  "csexp" {>= "1.5"}
  "pp" {>= "2.0.0"}
  "eio" {>= "1.4"}
  "eio_main"
  "jsont" {>= "0.2.0"}
  "mosaic" {>= "0.1.0"}
  "matrix" {>= "0.1.0"}
  "logs" {>= "0.7.0"}
  "cmdliner" {>= "1.1.0"}
  "xdge" {>= "1.0.0"}
  "merlin" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://tangled.org/anil.recoil.org/ocaml-agentkit"
x-maintenance-intent: ["(latest)"]
