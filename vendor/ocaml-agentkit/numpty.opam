# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "A headless agent daemon over a local DS4 model"
description:
  "numpty runs a DeepSeek or GLM model unattended on your own machine. It wakes on a schedule you write, reaches the network through a child process, keeps what it learned in a durable memory, and records every prompt, reply and tool call in an append-only journal."
maintainer: ["Anil Madhavapeddy <anil@recoil.org>"]
authors: ["Anil Madhavapeddy"]
license: "ISC"
tags: ["org:blacksun" "ds4" "llm" "agent" "daemon"]
homepage: "https://tangled.org/anil.recoil.org/ocaml-agentkit"
bug-reports: "https://tangled.org/anil.recoil.org/ocaml-agentkit/issues"
depends: [
  "dune" {>= "3.21"}
  "ocaml" {>= "5.2.0"}
  "ds4"
  "agentkit" {= version}
  "agentkit-ds4" {= version}
  "eio" {>= "1.4"}
  "eio_main"
  "jsont" {>= "0.2.0"}
  "bytesrw" {>= "0.2.0"}
  "logs" {>= "0.7.0"}
  "cmdliner" {>= "1.1.0"}
  "xdge" {>= "1.0.0"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://tangled.org/anil.recoil.org/ocaml-agentkit"
x-maintenance-intent: ["(latest)"]
