# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Vendored TOML subset of ocaml-codec"
description: """
This package contains the TOML parser and supporting ASCII, UTF-8 and
location modules from ocaml-codec. Local changes replace Result syntax
helpers for OCaml 5.2 compatibility and provide Dune packaging. TOML JSON
adapters are omitted."""
license: "ISC"
homepage: "https://github.com/samoht/ocaml-codec"
bug-reports: "https://github.com/samoht/ocaml-codec/issues"
depends: [
  "dune" {>= "3.21"}
  "ocaml" {>= "5.2"}
  "bytesrw"
  "fmt"
  "ptime"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/samoht/ocaml-codec.git"
x-maintenance-intent: ["(latest)"]
