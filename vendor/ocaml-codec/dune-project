(lang dune 3.21)

(name codec)

(generate_opam_files true)

(implicit_transitive_deps false)

(license ISC)
(source (github samoht/ocaml-codec))

(package
 (name codec)
 (synopsis "Vendored TOML subset of ocaml-codec")
 (description
  "This package contains the TOML parser and supporting ASCII, UTF-8 and
location modules from ocaml-codec. Local changes replace Result syntax
helpers for OCaml 5.2 compatibility and provide Dune packaging. TOML JSON
adapters are omitted.")
 (depends
  (ocaml
   (>= 5.2))
  bytesrw
  fmt
  ptime))
