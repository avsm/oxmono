(package
 (name dockerfile)
 (synopsis "Dockerfile eDSL in OCaml")
 (description
  "Dockerfile provides typed OCaml combinators for generating Dockerfiles. This
ocaml-dockerfile import retains the library and tests and omits the upstream
command-line tool.")
 (depends
  (ocaml (>= "4.08"))
  (fmt (>= "0.8.7"))
  (ppx_sexp_conv (>= "v0.9.0"))
  sexplib0
  (alcotest (and (>= "1.9.1") :with-test)))
 (conflicts
  (result (< 1.5))
  (rresult (< 0.7.0)))
 (tags ("org:mirage" "org:ocamllabs")))

(package
 (name dockerfile-opam)
 (synopsis "Dockerfile eDSL -- opam support")
 (description
  "This package extends ocaml-dockerfile with opam and Linux distribution
support. The import retains the library and tests and omits the upstream
command-line tool.")
 (depends
  (dockerfile (= :version))
  (fmt (>= "0.8.7"))
  (ocaml-version (>= "3.6.4"))
  (ppx_sexp_conv (>= "v0.9.0"))
  sexplib0
  (alcotest (and (>= "1.9.1") :with-test)))
 (conflicts
  (result (< 1.5))
  (rresult (< 0.7.0)))
 (tags ("org:mirage" "org:ocamllabs")))
