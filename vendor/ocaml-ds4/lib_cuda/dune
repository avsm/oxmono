;; CUDA backend implementation of the virtual [ds4] library.
;;
;; Off unless DS4_CUDA=yes is in the environment. Dune's (enabled_if ...) can
;; test the platform and the environment but cannot read a probe's output, so an
;; opt-in variable is what keeps a host with no CUDA toolkit from ever running
;; nvcc. The same test guards every rule below; ../config/discover.ml checks the
;; variable's spelling, since a value dune does not recognise would otherwise
;; skip the backend without saying so.
;;
;; Kernels are compiled into libds4_core_cuda.a by nvcc, so unlike ../lib_metal
;; there is no shader source to embed and ship.

(library
 (name ds4_cuda)
 (public_name ds4.cuda)
 (implements ds4)
 (enabled_if
  (and
   (= %{system} linux)
   (= %{env:DS4_CUDA=no} yes)))
 (modes native)
 (modules backend)
 (foreign_archives ds4_core_cuda)
 (foreign_stubs
  (language c)
  (names ds4_stubs)
  (include_dirs ../csrc))
 (c_library_flags
  (-lm
   -pthread
   (:include ../config/cuda_link_flags.sexp))))

;; The shared, backend-agnostic FFI stub, compiled into this implementation.

(copy_files
 (files ../csrc/ds4_stubs.c)
 (enabled_if
  (and
   (= %{system} linux)
   (= %{env:DS4_CUDA=no} yes))))

;; --- Engine archive: core (GPU) objects + the CUDA backend object. ---
;;
;; ds4.c and ds4_tp.c are compiled without -DDS4_NO_GPU, which is what selects
;; the CUDA paths: the engine has no positive "is a CUDA build" macro and keys
;; off the absence of that one together with __APPLE__.

(rule
 (target ds4.o)
 (enabled_if
  (and
   (= %{system} linux)
   (= %{env:DS4_CUDA=no} yes)))
 (deps
  ../csrc/ds4.c
  ../csrc/ds4.h
  ../csrc/ds4_image.h
  ../csrc/ds4_ssd.h
  ../csrc/ds4_distributed.h
  ../csrc/ds4_gpu.h
  ../csrc/ds4_gpu_mgpu.h
  ../csrc/ds4_gpu_tp.h
  ../csrc/ds4_deepseek41_gpu.h
  ../csrc/ds4_engram.h
  ../csrc/ds4_linux_memory.h
  ../csrc/ds4_tool_text.h
  ../csrc/ds4_tp.h
  ../csrc/ds4_layer_pack.h
  ../csrc/ds4_streaming_hotlist.inc
  ../csrc/ds4_streaming_hotlist_glm52.inc
  ../csrc/ds4_qwen4_unicode.inc
  ../config/core_cflags)
 (action
  (run
   %{cc}
   %{read-lines:../config/core_cflags}
   -I
   ../csrc
   -c
   ../csrc/ds4.c
   -o
   ds4.o)))

(rule
 (target ds4_image.o)
