  ../csrc/ds4_deepseek4_vision_gpu.cuh
  ../csrc/ds4_deepseek41_cuda.cuh
  ../csrc/ds4_qwen4_cuda.cuh
  ../csrc/ds4_qwen4_vision.h
  ../csrc/ds4_deepseek41_gpu.h
  ../csrc/ds4_gpu_tp.h
  ../csrc/ds4_linux_memory.h
  ../csrc/ds4_image.h
  ../config/cuda_nvcc
  (source_tree ../csrc/cuda/mmq)
  ../config/cuda_cflags)
 (action
  (run
   %{read-lines:../config/cuda_nvcc}
   %{read-lines:../config/cuda_cflags}
   -I
   ../csrc
   -c
   ../csrc/ds4_cuda.cu
   -o
   ds4_cuda.o)))

