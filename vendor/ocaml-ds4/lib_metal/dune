(rule
 (target libds4_core_metal.a)
 (enabled_if
  (= %{system} macosx))
 (deps
  ds4.o
  ds4_image.o
  ds4_ssd.o
  ds4_distributed.o
  ds4_tp.o
  ds4_layer_pack.o
  ds4_engram.o
  ds4_metal.o)
 (action
  (run
   ar
   rcs
   libds4_core_metal.a
   ds4.o
   ds4_image.o
   ds4_ssd.o
   ds4_distributed.o
   ds4_tp.o
   ds4_layer_pack.o
   ds4_engram.o
   ds4_metal.o)))
