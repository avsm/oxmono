opam-version: "2.0"
synopsis: "Use JSON Pointers in URI fragments"
description: """
This ocaml-json-pointer example demonstrates JSON Pointers in URI fragments.
It is packaged against the locally adapted Json-pointer library."""
maintainer: "Anil Madhavapeddy <anil@recoil.org>"
authors: "Anil Madhavapeddy"
license: "ISC"
homepage: "https://tangled.org/anil.recoil.org/ocaml-json-pointer"
bug-reports: "https://tangled.org/anil.recoil.org/ocaml-json-pointer/issues"
depends: [
  "ocaml" {>= "4.14.0"}
  "dune" {>= "3.21"}
  "json-pointer"
]
build: ["dune" "build" "-p" name "-j" jobs]
