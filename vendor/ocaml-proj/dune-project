(lang dune 3.19)
(using ctypes 0.3)

(name proj)

(generate_opam_files true)

(source
 (github geocaml/ocaml-proj))

(authors "Patrick Ferris <patrick@sirref.org>")

(maintainers "Patrick Ferris <patrick@sirref.org>")

(license ISC)

(package
 (name proj)
 (synopsis "Platform-agnostic bindings to PROJ4")
 (description
  "This package provides the shared interface for PROJ coordinate
transformations from ocaml-proj. The import includes a local correction to
the C backend's coordinate argument types to preserve double precision.")
 (depends
   ocaml
   ctypes)
 (tags
  ("org:geocaml" "geospatial" "projections")))

(package
  (name proj_c)
  (synopsis "C bindings to PROJ4")
 (description
  "This package implements ocaml-proj's C backend for PROJ coordinate
transformations. A local binding correction uses double-precision coordinate
arguments as required by PROJ.")
  (depends
    ocaml
    ctypes
    (alcotest :with-test))
   (tags ("org:geocaml" "geospatial" "projections")))

(package
  (name proj_js)
  (synopsis "Javascript bindings to PROJ4")
 (description
  "This package implements ocaml-proj's JavaScript backend for coordinate
transformations. It is packaged with the local ocaml-proj import.")
  (depends
    ocaml
    brr
    (alcotest :with-test))
   (tags ("org:geocaml" "geospatial" "projections")))

