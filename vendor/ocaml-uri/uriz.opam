opam-version: "2.0"
name: "uriz"
maintainer: "anil@recoil.org"
authors: ["Anil Madhavapeddy" "David Sheets" "Rudi Grinberg"]
license: "ISC"
tags: ["url" "uri" "oxcaml" "org:mirage" "org:xapi-project"]
homepage: "https://github.com/mirage/ocaml-uri"
bug-reports: "https://github.com/mirage/ocaml-uri/issues"
dev-repo: "git+https://github.com/mirage/ocaml-uri.git"
doc: "https://mirage.github.io/ocaml-uri/"
synopsis:
  "RFC 3986 URI library for OxCaml, derived from ocaml-uri"
description: """
Uriz implements RFC 3986 URI parsing, construction and resolution. It is an
OxCaml rewrite derived from ocaml-uri, with immutable URI values, portable
operations and local parsing support."""
depends: [
  "oxcaml-compiler" {>= "5.2.0minus39"}
  "dune" {>= "3.0"}
  "base"
  "ppx_template"
  "ounit2" {with-test & >= "1.0.2"}
  "crowbar" {with-test & >= "0.2"}
]
build: [
  ["dune" "build" "-p" name "-j" jobs]
  ["dune" "runtest" "-p" name "-j" jobs] {with-test & os != "macos"}
]
x-maintenance-intent: [ "(latest)" ]
