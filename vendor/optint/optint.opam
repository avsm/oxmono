opam-version: "2.0"
maintainer:   [ "romain.calascibetta@gmail.com" ]
authors:      "Romain Calascibetta"
license:      "ISC"
homepage:     "https://github.com/mirage/optint"
bug-reports:  "https://github.com/mirage/optint/issues"
dev-repo:     "git+https://github.com/mirage/optint.git"
doc:          "https://mirage.github.io/optint/"
synopsis:     "Efficient integer types on 64-bit architectures"
description: """
Optint provides integer types with immediate representations on 64-bit
architectures and boxed fallbacks on 32-bit architectures. This copy adds
OxCaml portability annotations to the upstream interfaces."""

build: ["dune" "build" "-p" name "-j" jobs]
run-test: [ "dune" "runtest" "-p" name "-j" jobs ]

depends: [
  "ocaml" {>= "4.07.0"}
  "dune"
  "crowbar" {with-test & >= "0.2"}
  "monolith" {with-test}
  "fmt" {with-test}
]
x-maintenance-intent: [ "(latest)" ]
