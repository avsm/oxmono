version: "v1.0"
opam-version: "2.0"
synopsis: "Generate XML sitemaps"
description: """\
This project is an OCaml tool to generate XML sitemaps, useful for SEO
and search engines.

This is sitemap v1.0 vendored unpatched. It is here only because it
depends on xmlm, and vendor/xmlm shadows the installed xmlm for the
whole workspace. Two copies of a library named xmlm cannot be linked
into one executable, so every workspace dependency of xmlm has to be
built from source alongside it."""
maintainer: ["Anil Madhavapeddy <anil@recoil.org>"]
authors: ["Anil Madhavapeddy <anil@recoil.org>"]
license: "ISC"
homepage: "https://github.com/avsm/ocaml-sitemap"
bug-reports: "https://github.com/avsm/ocaml-sitemap/issues"
depends: [
  "dune" {>= "3.21"}
  "ocaml" {>= "4.14"}
  "xmlm" {>= "1.2.0"}
]
build: [
  ["dune" "build" "-p" name "-j" jobs]
]
dev-repo: "git+https://github.com/avsm/ocaml-sitemap.git"
