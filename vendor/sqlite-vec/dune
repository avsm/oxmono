(rule
 (target sqlite3.h)
 (action (copy %{lib:sqlite3:sqlite3.h} %{target})))

(library
 (name sqlite_vec)
 (public_name sqlite-vec)
 (libraries sqlite3)
 (foreign_stubs
  (language c)
  (names sqlite-vec sqlite_vec_stubs)
  (flags
   :standard
   -O2
   -DSQLITE_CORE
   -DSQLITE_VEC_STATIC
   -DSQLITE_VEC_OMIT_FS)))

; Keep standalone builds consistent with the monorepo profiles.
(env
 (dev
  (ocamlopt_flags (:standard -zero-alloc-check none)))
 (release
  (ocamlopt_flags (:standard -zero-alloc-check none)))
 (release-check
  (ocamlopt_flags (:standard -O3 -zero-alloc-check all)))
 (afl
  (ocamlopt_flags (:standard -zero-alloc-check none -afl-instrument))))
