version: "1.2.0"
opam-version: "2.0"
maintainer: [
  "Hannes Mehnert <hannes@mehnert.org>"
]
authors: [
  "Hannes Mehnert <hannes@mehnert.org>"
  "David Kaloper <dk505@cam.ac.uk>"
]
license: "BSD-2-Clause"
tags: "org:mirage"
homepage: "https://github.com/mirleft/ocaml-x509"
doc: "https://mirleft.github.io/ocaml-x509/doc"
bug-reports: "https://github.com/mirleft/ocaml-x509/issues"
depends: [
  "ocaml" {>= "4.13.0"}
  "dune" {>= "2.0"}
  "asn1-combinators" {>= "0.3.1"}
  "ptime"
  "base64" {>= "3.3.0"}
  "mirage-crypto" {>= "1.0.0"}
  "mirage-crypto-pk"
  "mirage-crypto-ec" {>= "0.10.7"}
  "mirage-crypto-rng"
  "mirage-crypto-rng" {with-test & >= "1.2.0"}
  "fmt" {>= "0.8.7"}
  "alcotest" {with-test}
  "gmap" {>= "0.3.0"}
  "domain-name" {>= "0.3.0"}
  "logs"
  "kdf" {>= "1.0.0"}
  "ohex" {>= "0.2.0"}
  "ipaddr" {>= "5.2.0"}
]
conflicts: [ "result" {< "1.5"} ]
build: [
  ["dune" "subst"] {dev}
  ["dune" "build" "-p" name "-j" jobs]
  ["dune" "runtest" "-p" name "-j" jobs] {with-test}
]
dev-repo: "git+https://github.com/mirleft/ocaml-x509.git"
synopsis: "Public Key Infrastructure (RFC 5280, PKCS) purely in OCaml"
description: """
X509 parses and validates certificates and implements public-key
infrastructure formats, including ASN.1 DER, PEM and PKCS containers. This
ocaml-x509 import adds OxCaml portable interfaces and supporting value
operations."""
x-maintenance-intent: [ "(latest)" ]