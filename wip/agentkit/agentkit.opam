opam-version: "2.0"
synopsis: "Durable stores and a journal browser for local agents"
description:
  "Backend-neutral event types, line framing, journals, memory and schedules for local agents, and a journal browser that loads no model runtime."
maintainer: ["Anil Madhavapeddy <anil@recoil.org>"]
authors: ["Anil Madhavapeddy"]
license: "ISC"
tags: ["org:blacksun" "llm" "agent"]
homepage: "https://tangled.org/anil.recoil.org/ocaml-agentkit"
bug-reports: "https://tangled.org/anil.recoil.org/ocaml-agentkit/issues"
depends: [
  "dune" {>= "3.21"}
  "ocaml" {>= "5.2.0"}
  "cstruct"
  "eio" {>= "1.4"}
  "eio_main"
  "jsont" {>= "0.2.0"}
  "bytesrw" {>= "0.2.0"}
  "cmdliner" {>= "1.1.0"}
  "xdge" {>= "1.0.0"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://tangled.org/anil.recoil.org/ocaml-agentkit"
x-maintenance-intent: ["(latest)"]
