(lang dune 3.21)
(cram enable)
(name agentkit)

(generate_opam_files true)
(implicit_transitive_deps false)

(license ISC)
(authors "Anil Madhavapeddy")
(maintainers "Anil Madhavapeddy <anil@recoil.org>")
(source (tangled anil.recoil.org/ocaml-agentkit))

(package
 (name agentkit)
 (synopsis "Durable stores and a journal browser for local agents")
 (tags (org:blacksun llm agent))
 (description
  "Agentkit provides backend-independent agent events, journals, memory stores
and schedules. It includes a journal browser that does not load a model
runtime.")
 (depends
  (ocaml (>= 5.2.0))
  cstruct
  (eio (>= 1.4))
  eio_main
  (jsont (>= 0.2.0))
  (bytesrw (>= 0.2.0))
  (cmdliner (>= 1.1.0))
  (xdge (>= 1.0.0))))

(package
 (name agentkit-ds4)
 (synopsis "DS4 adapter for Agentkit")
 (tags (org:blacksun ds4 llm agent))
 (description
  "This package converts DS4 agent events into Agentkit's backend-independent
event stream.")
 (depends
  (ocaml (>= 5.2.0))
  ds4
  (agentkit (= :version))))

(package
 (name agentkit-apple-fm)
 (allow_empty)
 (synopsis "Apple Foundation Models adapter for Agentkit")
 (tags (org:blacksun apple foundation-models llm agent))
 (description
  "This package adapts Apple's on-device Foundation Models framework to
Agentkit. It provides streaming events, tool calls, transcripts,
cancellation and conversation compaction.")
 (depends
  (ocaml (>= 5.2.0))
  (apple-fm (>= 0.1))
  (agentkit (= :version))
  cstruct
  (eio (>= 1.5))))

(package
 (name agentkit-apple-tools)
 (allow_empty)
 (synopsis "Apple Foundation Models bindings for Agentkit workspace tools")
 (description
  "This package supplies Apple Foundation Models tool schemas for Agentkit's
workspace, network and memory handlers.")
 (depends
  (ocaml (>= 5.2.0))
  ds4
  (apple-fm (>= 0.1))
  (eio (>= 1.5))
  (agentkit (= :version))
  (agentkit-apple-fm (= :version))))

(package
 (name humpty)
 (allow_empty)
 (synopsis "A terminal agent over a local DS4 model")
 (tags (org:blacksun ds4 llm agent tui))
 (description
  "The humpty command runs a local DS4 model in a terminal interface. It
supports single prompts and interactive conversations with tools.")
 (depends
  (ocaml (>= 5.2.0))
  ds4
  (agentkit (= :version))
  (agentkit-ds4 (= :version))
  dune-rpc-eio
  (dune-rpc (>= 3.24))
  (csexp (>= 1.5))
  (pp (>= 2.0.0))
  (eio (>= 1.4))
  eio_main
  (jsont (>= 0.2.0))
  (mosaic (>= 0.1.0))
  (matrix (>= 0.1.0))
  (logs (>= 0.7.0))
  (cmdliner (>= 1.1.0))
  (xdge (>= 1.0.0))
  (merlin :with-test)))

(package
 (name numpty)
 (allow_empty)
 (synopsis "A headless agent daemon over a local DS4 model")
 (tags (org:blacksun ds4 llm agent daemon))
 (description
  "The numpty daemon runs a local DS4 agent on a configured schedule. It stores
memory and records prompts, responses and tool calls in an append-only
journal.")
 (depends
  (ocaml (>= 5.2.0))
  ds4
  (agentkit (= :version))
  (agentkit-ds4 (= :version))
  (eio (>= 1.4))
  eio_main
  (jsont (>= 0.2.0))
  (bytesrw (>= 0.2.0))
  (logs (>= 0.7.0))
  (cmdliner (>= 1.1.0))
  (xdge (>= 1.0.0))))

(package
 (name dumpty)
 (allow_empty)
 (synopsis "A one-shot agent over a local DS4 model")
 (tags (org:blacksun ds4 llm agent oneshot))
 (description
  "The dumpty command runs a single prompt through a local DS4 model with
tools. It writes journal events to standard error and a JSON result to
standard output.")
 (depends
  (ocaml (>= 5.2.0))
  ds4
  (agentkit (= :version))
  (agentkit-ds4 (= :version))
  (humpty (= :version))
  (eio (>= 1.4))
  eio_main
  (jsont (>= 0.2.0))
  (bytesrw (>= 0.2.0))
  (logs (>= 0.7.0))
  (cmdliner (>= 1.1.0))
  (xdge (>= 1.0.0))))

(package
 (name agentkit-openrouter)
 (synopsis "OpenRouter adapter for Agentkit")
 (description
  "This package connects OpenRouter conversations to Agentkit's streaming event
interface.")
 (depends
  (ocaml (>= 5.2.0))
  openrouter
  (jsont (>= 0.2.0))
  (agentkit (= :version))))

(package
 (name agentkit-backends)
 (allow_empty)
 (synopsis "Combined Agentkit provider registry")
 (description
  "This package combines Agentkit's provider adapters in a shared backend
registry.")
 (depends
  (ocaml (>= 5.2.0))
  (agentkit (= :version))))

(package
 (name agentkit-osm)
 (synopsis "Address lookup tools for Agentkit")
 (description
  "This package provides Agentkit tools for address lookup through
OpenStreetMap services.")
 (depends
  (ocaml (>= 5.2.0))
  (agentkit (= :version))
  osm fetch eio jsont))
