opam-version: "2.0"
synopsis:
  "OCaml bindings to Apple's on-device speech transcription and synthesis"
description: """
This library binds Apple's Speech framework for audio transcription and
speech synthesis through Eio. Transcription uses SpeechAnalyzer and
SpeechTranscriber and requires macOS 26 or later."""
maintainer: ["Anil Madhavapeddy <anil@recoil.org>"]
authors: ["Anil Madhavapeddy"]
license: "ISC"
tags: ["org:blacksun" "apple" "speech" "transcription" "eio"]
depends: [
  "dune" {>= "3.21"}
  "ocaml" {>= "5.2.0"}
  "eio" {>= "1.5"}
  "eio_main" {>= "1.5"}
  "console"
  "console-eio"
  "jsont" {>= "0.3.0"}
  "cmdliner" {>= "1.1.0"}
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
x-maintenance-intent: ["(latest)"]
