(lang dune 3.21)
(name apple-speech)
(generate_opam_files true)
(implicit_transitive_deps false)

(license ISC)
(authors "Anil Madhavapeddy")
(maintainers "Anil Madhavapeddy <anil@recoil.org>")

(package
 (name apple-speech)
 (synopsis "OCaml bindings to Apple's on-device speech transcription and synthesis")
 (tags (org:blacksun apple speech transcription eio))
 (description
  "This library binds Apple's Speech framework for audio transcription and
speech synthesis through Eio. Transcription uses SpeechAnalyzer and
SpeechTranscriber and requires macOS 26 or later.")
 (depends
  (ocaml (>= 5.2.0))
  (eio (>= 1.5))
  (eio_main (>= 1.5))
  console console-eio
  (jsont (>= 0.3.0))
  (cmdliner (>= 1.1.0))
  (alcotest :with-test)))
