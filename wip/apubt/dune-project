(lang dune 3.21)
(name apubt)

(generate_opam_files true)

(license ISC)
(authors "Anil Madhavapeddy")
(maintainers "Anil Madhavapeddy <anil@recoil.org>")
(source (tangled anil.recoil.org/ocaml-apubt))

(package
 (name apubt)
 (synopsis "ActivityPub client library for OCaml with Eio")
 (description
  "Apubt implements ActivityPub and ActivityStreams types with Jsont codecs. It
provides an Eio HTTP client with HTTP signature support for federation.")
 (depends
  (duration (>= 0.3.1))
  (ocaml (>= 5.1.0))
  (jsont (>= 0.2.0))
  bytesrw
  (eio (>= 1.0))
  (eio_main (>= 1.0))
  console console-eio
  fetch
  fetch-curl
  fetch-signature
  httpz
  webfinger
  base64
  digestif
  mirage-crypto-rng
  (mirage-crypto-pk :with-test)
  (cmdliner (>= 1.2.0))
  (logs (>= 0.7.0))
  (fmt (>= 0.9.0))
  ptime
  uriz
  x509
  (odoc :with-doc)))
