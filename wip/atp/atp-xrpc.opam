  "dune" {>= "3.21"}
  "atp" {= version}
  "fetch"
  "fetch-curl"
  "http"
  "jsont" {>= "0.1"}
  "jsonwt" {>= "0.1"}
  "ptime" {>= "1.0"}
  "uriz"
  "eio" {>= "1.0"}
  "fmt"
  "logs"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
