(lang dune 3.21)
(name atp)

(generate_opam_files true)

(license ISC)
(authors "Anil Madhavapeddy")
(maintainers "Anil Madhavapeddy <anil@recoil.org>")
(source (tangled anil.recoil.org/ocaml-atp))

(package
 (name atp)
 (synopsis "AT Protocol IPLD implementation for OCaml")
 (description
  "Atp implements the AT Protocol's IPLD data formats. It provides content
identifiers, DAG-CBOR codecs, Merkle search trees, CAR repository
serialization and synchronization primitives.")
 (depends
  (ocaml (>= 5.2))
  (bytesrw (>= 0.1))
  (jsont (>= 0.1))
  (digestif (>= 1.2))
  (multibase (>= 0.1))
  (eio (>= 1.0))
  (base64 (>= 3.5))
  (re (>= 1.0))
  fmt))

(package
 (name atp-xrpc)
 (synopsis "XRPC client for AT Protocol")
 (description
  "This library provides an Eio XRPC client for AT Protocol personal data
servers. It supports queries, procedures, session management and automatic
token refresh.")
 (depends
  (atp (= :version))
  fetch
  fetch-curl
  http
  (jsont (>= 0.1))
  (jsonwt (>= 0.1))
  (ptime (>= 1.0))
  uriz
  (eio (>= 1.0))
  fmt
  logs))

(package
 (name xrpc-auth)
 (synopsis "Authentication helpers for AT Protocol CLIs")
 (description
  "This library provides session persistence, credential management and token
refresh for AT Protocol commands. It includes Cmdliner terms for
authentication commands.")
 (depends
  (ocaml (>= 5.1))
  (atp-xrpc (= :version))
  fetch
  fetch-curl
  http
  (jsont (>= 0.1))
  jsonwt
  digestif
  eqaf
  mirage-crypto-ec
  mirage-crypto-rng
  (eio (>= 1.0))
  (ptime (>= 1.0))
  (cmdliner (>= 1.2))
  eio_main
  console
  console-eio
  logs
  fmt))

(package
 (name hermest)
 (synopsis "AT Protocol lexicon code generator for OCaml")
 (description
  "Hermest generates OCaml types and Jsont codecs from AT Protocol lexicon
schemas. Generated code uses Atp for IPLD primitives.")
 (depends
  (ocaml (>= 5.1))
  (jsont (>= 0.1))
  (bytesrw (>= 0.1))))

(package
 (name hermest-cli)
 (synopsis "CLI for hermest lexicon code generator")
 (description
  "The hermest command generates OCaml code from AT Protocol lexicon schemas.")
 (depends
  (ocaml (>= 5.1))
  hermest
  (cmdliner (>= 1.2))))

(package
 (name atp-lexicon-atproto)
 (synopsis "AT Protocol core lexicon types for OCaml")
 (description
  "This package provides generated OCaml types and Jsont codecs for the
com.atproto lexicons.")
 (depends
  (ocaml (>= 5.1))
  (atp (>= 0.1))
  (jsont (>= 0.1))))

(package
 (name atp-lexicon-bsky)
 (synopsis "Bluesky lexicon types for OCaml")
 (description
  "This package provides generated OCaml types and Jsont codecs for the
app.bsky lexicons.")
 (depends
  (ocaml (>= 5.1))
  (atp (>= 0.1))
  (jsont (>= 0.1))))

(package
 (name atp-lexicon-tangled)
 (synopsis "Tangled.sh lexicon types for OCaml")
 (description
  "This package provides generated OCaml types and Jsont codecs for the
org.tangled lexicons and retained legacy sh.tangled records.")
 (depends
  (ocaml (>= 5.1))
  (atp (>= 0.1))
  (jsont (>= 0.1))))

(package
 (name atp-lexicon-standard-site)
 (synopsis "Standard Site lexicon types for OCaml")
 (description
  "This package provides generated OCaml types and Jsont codecs for the
site.standard lexicons.")
 (depends
  (ocaml (>= 5.1))
  (atp (>= 0.1))
  (jsont (>= 0.1))))

(package
 (name tangled)
 (synopsis "Tangled client library and CLI for AT Protocol")
 (description
  "This package provides a library and command-line interface for the Tangled
Git collaboration service on the AT Protocol.")
 (depends
  (ocaml (>= 5.1))
  (xrpc-auth (= :version))
  (atp-xrpc (= :version))
  fetch
  fetch-httpz
  httpz
  uriz
  bytesrw
  (atp-lexicon-atproto (= :version))
  (atp-lexicon-tangled (= :version))
  (jsont (>= 0.1))
  (eio (>= 1.0))
  (ptime (>= 1.0))
  (tomlt (>= 0.1))
  (xdge (>= 0.1))
  (cmdliner (>= 1.2))
  eio_main
  console console-eio
  fmt
  logs))

(package
 (name bsky)
 (synopsis "Bluesky client library and CLI")
 (description
  "This package provides a Bluesky client library and command-line interface
using the AT Protocol.")
 (depends
  (ocaml (>= 5.1))
  (atp (= :version))
  (atp-xrpc (= :version))
  (xrpc-auth (= :version))
  (atp-lexicon-atproto (= :version))
  (atp-lexicon-bsky (= :version))
  (cmdliner (>= 1.2))
  (jsont (>= 0.1))
  (tomlt (>= 0.1))
  (xdge (>= 0.1))
  (re (>= 1.0))
  eio_main
  fmt))

(package
 (name standard-site)
 (synopsis "Standard Site client library and CLI for AT Protocol")
 (description
  "This package provides a library and command-line interface for managing AT
Protocol blogs and publications using the Standard Site lexicons.")
 (depends
  (ocaml (>= 5.1))
  (xrpc-auth (= :version))
  (atp-xrpc (= :version))
  fetch
  uriz
  (atp-lexicon-atproto (= :version))
  (atp-lexicon-standard-site (= :version))
  (jsont (>= 0.1))
  (eio (>= 1.0))
  (ptime (>= 1.0))
  (cmdliner (>= 1.2))
  eio_main
  console
  fmt))
