{
  "lexicon": 1,
  "id": "sh.tangled.graph.vouch",
  "needsCbor": true,
  "needsType": true,
  "defs": {
    "main": {
      "type": "record",
      "key": "any",
      "record": {
        "type": "object",
        "required": [
          "kind",
          "createdAt"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "description": "Whether this user is being vouched for or denounced",
            "enum": ["vouch", "denounce"],
            "default": "vouch"
          },
          "reason": {
            "type": "string",
            "description": "The reason for this vouch/denouncement",
            "maxGraphemes": 256,
            "maxLength": 2560
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          },
          "evidences": {
            "type": "array",
            "description": "Optional list of ATURIs serving as evidence for this vouch (ex. issues, PRs)",
            "maxLength": 10,
            "items": {
              "type": "string",
              "format": "at-uri"
            }
          }
        }
      }
    }
  }
}

