{
  "lexicon": 1,
  "id": "org.tangled.ci.retryPipeline",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Duplicate existing pipeline for rerun.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "repo",
            "pipeline"
          ],
          "properties": {
            "repo": {
              "type": "string",
              "format": "did",
              "description": "git repository DID"
            },
            "pipeline": {
              "type": "string",
              "format": "record-key",
              "description": "pipeline id"
            },
            "workflows": {
              "type": "array",
              "items": {
                "type": "string",
                "description": "workflow name"
              },
              "description": "Workflow names to filter. When not provided, entire pipeline will be duplicated."
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["pipeline"],
          "properties": {
            "pipeline": {
              "type": "string",
              "format": "record-key",
              "description": "Scheduled pipeline id"
            }
          }
        }
      },
      "errors": [
        {
          "name": "PipelineNotFound",
          "description": "Pipeline not found"
        },
        {
          "name": "PipelineNotRetryable",
          "description": "Pipeline is still blocked or has no stored spec to rerun"
        }
      ]
    }
  }
}
