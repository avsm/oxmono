{
  "lexicon": 1,
  "id": "org.tangled.ci.trigger.manual",
  "needsCbor": true,
  "needsType": true,
  "defs": {
    "main": {
      "type": "object",
      "required": ["repo", "commit"],
      "properties": {
        "repo": {
          "type": "string",
          "format": "did"
        },
        "commit": {
          "type": "string",
          "description": "Commit id the pipeline will run on.",
          "minLength": 40,
          "maxLength": 64
        },
        "ref": {
          "type": "string",
          "description": "Optional ref the commit was resolved from."
        },
        "workflows": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "workflow name"
          },
          "description": "Workflow names to run. When not provided, every dispatchable workflow is run."
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "ref",
            "ref": "#pair"
          }
        }
      }
    },
    "pair": {
      "type": "object",
      "required": ["key", "value"],
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      }
    }
  }
}
