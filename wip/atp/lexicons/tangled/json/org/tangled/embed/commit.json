{
  "lexicon": 1,
  "id": "org.tangled.embed.commit",
  "defs": {
    "main": {
      "type": "object",
      "required": [
        "repo",
        "commit"
      ],
      "properties": {
        "repo": { "type": "string", "format": "did" },
        "commit": { "type": "ref", "ref": "org.tangled.git.oid" }
      }
    },
    "view": {
      "type": "object",
      "required": [
        "repo",
        "commit"
      ],
      "properties": {
        "repo": { "type": "string", "format": "did" },
        "commit": { "type": "string", "maxLength": 64 },
        "change": { "type": "string", "maxLength": 32 }
      }
    }
  }
}
