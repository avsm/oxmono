{
  "lexicon": 1,
  "id": "org.tangled.event.push",
  "needsCbor": true,
  "needsType": true,
  "defs": {
    "main": {
      "type": "object",
      "description": "When a repository ref is updated.",
      "required": [
        "repo",
        "ref",
        "oldSha",
        "newSha"
      ],
      "properties": {
        "repo": {
          "type": "string",
          "format": "did"
        },
        "ref": {
          "type": "string"
        },
        "oldSha": {
          "type": "string"
        },
        "newSha": {
          "type": "string"
        },
        "actor": {
          "type": "string",
          "format": "did",
          "description": "The account that pushed."
        },
        "pushOptions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxLength": 50,
          "description": "The push options sent with the push, omitted when there were none."
        }
      }
    }
  }
}
