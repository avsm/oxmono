{
  "lexicon": 1,
  "id": "org.tangled.git.listTags",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "type": "params",
        "required": [
          "repo"
        ],
        "properties": {
          "repo": {
            "type": "string",
            "format": "did",
            "description": "DID of the repository"
          },
          "limit": {
            "type": "integer",
            "description": "Maximum number of tags to return",
            "minimum": 1,
            "maximum": 100,
            "default": 50
          },
          "cursor": {
            "type": "string",
            "description": "Pagination cursor"
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "tags",
            "total"
          ],
          "properties": {
            "tags": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "#tagInfo"
              }
            },
            "cursor": {
              "type": "string"
            },
            "total": {
              "type": "integer",
              "description": "Total number of tags in the repository"
            }
          }
        }
      },
      "errors": [
        {
          "name": "RepoNotFound",
          "description": "Repository not found or access denied"
        },
        {
          "name": "InvalidRequest",
          "description": "Invalid request parameters"
        }
      ]
    },
    "tagInfo": {
      "type": "object",
      "required": [
        "name",
        "oid",
        "message",
        "author"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Tag name"
        },
        "oid": {
          "type": "string",
          "description": "Latest commit oid on this tag"
        },
        "message": {
          "type": "string",
          "description": "Latest commit message"
        },
        "author": {
          "type": "ref",
          "ref": "org.tangled.git.defs#signature"
        },
        "annotation": {
          "type": "ref",
          "ref": "#annotation",
          "description": "Present only for annotated tags"
        }
      }
    },
    "annotation": {
      "type": "object",
      "required": [
        "message"
      ],
      "properties": {
        "tagger": {
          "type": "ref",
          "ref": "org.tangled.git.defs#signature"
        },
        "message": {
          "type": "string",
          "description": "Tag message"
        }
      }
    }
  }
}
