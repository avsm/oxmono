{
  "lexicon": 1,
  "id": "org.tangled.graph.listNetworkVouches",
  "defs": {
    "main": {
      "type": "query",
      "description": "List vouches involving one or more actors as seen through a viewer's vouch network: vouches the viewer's network placed on an actor, and vouches an actor placed on the viewer's network. Requires authentication.",
      "parameters": {
        "type": "params",
        "required": ["actors"],
        "properties": {
          "actors": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "did"
            },
            "minLength": 1,
            "maxLength": 50,
            "description": "DIDs of the profiles whose network vouches to list. At most 50 per request."
          },
          "cursor": {
            "type": "string",
            "description": "Pagination cursor. Only accepted when a single actor is requested."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50,
            "description": "Maximum number of vouches per actor."
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["items"],
          "properties": {
            "items": {
              "type": "array",
              "items": { "type": "ref", "ref": "#listItem" }
            },
            "cursor": { "type": "string" }
          }
        }
      }
    },
    "listItem": {
      "type": "object",
      "required": ["actor", "uri", "value"],
      "properties": {
        "actor": {
          "type": "string",
          "format": "did",
          "description": "The requested actor this vouch involves."
        },
        "uri": { "type": "string", "format": "at-uri" },
        "cid": { "type": "string", "format": "cid" },
        "value": {
          "type": "unknown",
          "description": "Embedded sh.tangled.graph.vouch record"
        }
      }
    }
  }
}
