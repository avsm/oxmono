{
  "lexicon": 1,
  "id": "org.tangled.repo.defs",
  "defs": {
    "sourceTangled": {
      "type": "object",
      "required": ["did"],
      "properties": {
        "did": { "type": "string", "format": "did", "description": "DID of the repo identity" }
      }
    },
    "sourceExternal": {
      "type": "object",
      "required": ["uri"],
      "properties": {
        "uri": { "type": "string", "format": "uri", "description": "git-clone uri of the repo" }
      }
    },
    "repoViewBasic": {
      "type": "object",
      "required": ["did", "owner", "slug", "createdAt"],
      "properties": {
        "did": { "type": "string", "format": "did" },
        "owner": { "type": "ref", "ref": "org.tangled.actor.defs#profileViewBasic" },
        "slug": { "type": "string" },
        "description": { "type": "string" },
        "createdAt": { "type": "string", "format": "datetime" },
        "forkCount": { "type": "integer" },
        "starCount": { "type": "integer" },
        "openIssueCount": { "type": "integer" },
        "openPullCount": { "type": "integer" },
        "primaryLanguage": { "type": "string", "description": "Largest language on the default branch, by bytes." },
        "viewer": { "type": "ref", "ref": "#viewerState" },
        "isStarred": { "type": "boolean" }
      }
    },
    "language": {
      "type": "object",
      "required": ["name", "size"],
      "properties": {
        "name": { "type": "string" },
        "size": { "type": "integer", "description": "Total size of files in this language, in bytes." }
      }
    },
    "viewerState": {
      "type": "object",
      "description": "Metadata about the requesting account's relationship with the subject content. Only has meaningful content for authed requests.",
      "properties": {
        "fork": { "type": "string", "format": "at-uri" },
        "star": { "type": "string", "format": "at-uri" }
      }
    }
  }
}
