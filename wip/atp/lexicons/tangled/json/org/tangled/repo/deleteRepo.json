{
  "lexicon": 1,
  "id": "org.tangled.repo.deleteRepo",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Delete a repository",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["repo"],
          "properties": {
            "repo": {
              "type": "string",
              "format": "did"
            },
            "force": {
              "type": "boolean",
              "description": "Skip the check for a declaration record on the owner's PDS. Knot admins only."
            }
          }
        }
      }
    }
  }
}
