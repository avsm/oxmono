{
  "lexicon": 1,
  "id": "org.tangled.repo.forkSync",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Fetch the upstream of a fork into this repository, updating the remote-tracking ref for the given branch.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["repo", "branch"],
          "properties": {
            "repo": {
              "type": "string",
              "format": "did",
              "description": "DID of the fork repository"
            },
            "branch": {
              "type": "string",
              "description": "Branch to fetch from the upstream"
            }
          }
        }
      }
    }
  }
}
