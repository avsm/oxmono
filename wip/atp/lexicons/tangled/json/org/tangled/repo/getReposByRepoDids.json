{
  "lexicon": 1,
  "id": "org.tangled.repo.getReposByRepoDids",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "type": "params",
        "required": ["dids"],
        "properties": {
          "dids": {
            "type": "array",
            "items": { "type": "string", "format": "did" },
            "maxLength": 50,
            "description": "Repo DIDs to fetch. DIDs that resolve to none are omitted from the response."
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["items"],
          "properties": {
            "items": {
              "type": "array",
              "items": { "type": "ref", "ref": "#listItem" }
            }
          }
        }
      }
    },
    "listItem": {
      "type": "object",
      "required": ["uri", "value"],
      "properties": {
        "uri": { "type": "string", "format": "at-uri" },
        "cid": { "type": "string", "format": "cid" },
        "value": {
          "type": "unknown",
          "description": "sh.tangled.repo record"
        }
      }
    }
  }
}
