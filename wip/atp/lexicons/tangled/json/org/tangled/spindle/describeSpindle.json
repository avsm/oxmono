{
  "lexicon": 1,
  "id": "org.tangled.spindle.describeSpindle",
  "defs": {
    "main": {
      "type": "query",
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "did",
            "version"
          ],
          "properties": {
            "did": {
              "type": "string",
              "format": "did"
            },
            "version": {
              "type": "string"
            },
            "capabilities": {
              "type": "array",
              "items": {
                "type": "string",
                "knownValues": [
                  "tangled1.0"
                ]
              },
              "description": "Protocol capability tokens this spindle implements. Spindle that omit this field are treated as legacy."
            },
            "links": {
              "type": "ref",
              "description": "URLs of service policy documents.",
              "ref": "#links"
            },
            "contact": {
              "type": "ref",
              "description": "Contact information",
              "ref": "#contact"
            }
          }
        }
      }
    },
    "links": {
      "type": "object",
      "properties": {
        "privacyPolicy": { "type": "string", "format": "uri" },
        "termsOfService": { "type": "string", "format": "uri" }
      }
    },
    "contact": {
      "type": "object",
      "properties": {
        "email": { "type": "string" }
      }
    }
  }
}
