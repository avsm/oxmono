{
  "lexicon": 1,
  "id": "org.tangled.temp.git.formatPatch",
  "defs": {
    "main": {
      "type": "query",
      "description": "Serve the commits reachable from 'to' but not from 'from' as a git format-patch mailbox, oldest first.",
      "parameters": {
        "type": "params",
        "required": ["repo", "from", "to"],
        "properties": {
          "repo": {
            "type": "string",
            "format": "did",
            "description": "DID of the repository"
          },
          "from": {
            "type": "string",
            "description": "Revision the series starts after (exclusive)"
          },
          "to": {
            "type": "string",
            "description": "Revision the series ends at (inclusive)"
          }
        }
      },
      "output": {
        "encoding": "*/*",
        "description": "Patch series as text/plain"
      },
      "errors": [
        {
          "name": "RepoNotFound",
          "description": "Repository not found or access denied"
        },
        {
          "name": "RevisionNotFound",
          "description": "One or both revisions not found"
        },
        {
          "name": "InvalidRequest",
          "description": "Invalid request parameters"
        },
        {
          "name": "PatchTooLarge",
          "description": "Range has more commits than the limit"
        }
      ]
    }
  }
}
