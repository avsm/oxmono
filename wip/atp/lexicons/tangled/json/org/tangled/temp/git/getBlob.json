{
  "lexicon": 1,
  "id": "org.tangled.temp.git.getBlob",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "type": "params",
        "required": ["repo", "path"],
        "properties": {
          "repo": {
            "type": "string",
            "format": "did",
            "description": "DID of the repository"
          },
          "ref": {
            "type": "string",
            "description": "Git reference (branch, tag, or commit SHA)",
            "default": "HEAD"
          },
          "path": {
            "type": "string",
            "description": "Path within the repository tree"
          },
          "download": {
            "type": "boolean",
            "description": "Serve the blob as an attachment named after the file",
            "default": false
          }
        }
      },
      "output": {
        "encoding": "*/*",
        "description": "raw blob served in octet-stream"
      }
    }
  }
}
