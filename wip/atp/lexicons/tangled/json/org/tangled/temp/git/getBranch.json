{
  "lexicon": 1,
  "id": "org.tangled.temp.git.getBranch",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "type": "params",
        "required": ["repo", "name"],
        "properties": {
          "repo": {
            "type": "string",
            "format": "did",
            "description": "DID of the repository"
          },
          "name": {
            "type": "string",
            "description": "Branch name to get information for"
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["name", "hash", "message", "author", "totalCommits"],
          "properties": {
            "name": {
              "type": "string",
              "description": "Branch name"
            },
            "hash": {
              "type": "string",
              "description": "Latest commit hash on this branch"
            },
            "message": {
              "type": "string",
              "description": "Latest commit message"
            },
            "author": {
              "type": "ref",
              "ref": "org.tangled.git.defs#signature"
            },
            "totalCommits": {
              "type": "integer",
              "description": "Number of commits reachable from this branch"
            }
          }
        }
      },
      "errors": [
        {
          "name": "RepoNotFound",
          "description": "Repository not found or access denied"
        },
        {
          "name": "BranchNotFound",
          "description": "Branch not found"
        },
        {
          "name": "InvalidRequest",
          "description": "Invalid request parameters"
        }
      ]
    }
  }
}
