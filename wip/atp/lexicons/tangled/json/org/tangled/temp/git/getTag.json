{
  "lexicon": 1,
  "id": "org.tangled.temp.git.getTag",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "type": "params",
        "required": [
          "repo",
          "tag"
        ],
        "properties": {
          "repo": {
            "type": "string",
            "format": "did",
            "description": "DID of the repository"
          },
          "tag": {
            "type": "string",
            "description": "Name of tag, such as v1.3.0"
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["name", "oid", "message", "author"],
          "properties": {
            "name": {
              "type": "string",
              "description": "Tag name"
            },
            "oid": {
              "type": "string",
              "description": "Latest commit oid on this tag"
            },
            "message": {
              "type": "string",
              "description": "Latest commit message"
            },
            "author": {
              "type": "ref",
              "ref": "org.tangled.git.defs#signature"
            },
            "annotation": {
              "type": "ref",
              "ref": "org.tangled.temp.git.listTags#annotation",
              "description": "Present only for annotated tags"
            }
          }
        }
      },
      "errors": [
        {
          "name": "RepoNotFound",
          "description": "Repository not found or access denied"
        },
        {
          "name": "RefNotFound",
          "description": "Git reference not found"
        },
        {
          "name": "InvalidRequest",
          "description": "Invalid request parameters"
        }
      ]
    }
  }
}
