{
  "lexicon": 1,
  "id": "org.tangled.temp.repo.listRecordOrigins",
  "defs": {
    "main": {
      "type": "query",
      "description": "Who opened each COB record of one collection in a repository, and when. Gives the same author as the first version in `org.tangled.repo.listRecordVersions`, for every record in one walk, sorted by record key.",
      "parameters": {
        "type": "params",
        "required": [
          "repo",
          "collection"
        ],
        "properties": {
          "repo": {
            "type": "string",
            "format": "did",
            "description": "DID of the repository."
          },
          "collection": {
            "type": "string",
            "format": "nsid",
            "description": "A versioned collection, such as `org.tangled.track.ticket`."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "default": 500
          },
          "cursor": {
            "type": "string",
            "description": "Pass the cursor from one page into the next query to keep walking records."
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "repo",
            "collection",
            "origins"
          ],
          "properties": {
            "repo": {
              "type": "string",
              "format": "did"
            },
            "collection": {
              "type": "string",
              "format": "nsid"
            },
            "cursor": {
              "type": "string",
              "description": "Left out when the page already reaches the last record."
            },
            "origins": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "#origin"
              }
            }
          }
        }
      },
      "errors": [
        {
          "name": "InvalidRequest",
          "description": "The collection isn't a versioned one, or a parameter is malformed."
        },
        {
          "name": "RepoNotFound",
          "description": "This mirror doesn't have the repository."
        }
      ]
    },
    "origin": {
      "type": "object",
      "required": [
        "rkey",
        "author",
        "changeId",
        "createdAt"
      ],
      "properties": {
        "rkey": {
          "type": "string",
          "format": "record-key"
        },
        "author": {
          "type": "string",
          "format": "did",
          "description": "The DID of the account that opened the record, the editor of its first version."
        },
        "changeId": {
          "type": "string",
          "description": "Git Object ID of the change that opened the record."
        },
        "createdAt": {
          "type": "string",
          "format": "datetime",
          "description": "When the knot wrote the opening change. Not the record's own `createdAt`."
        }
      }
    }
  }
}
