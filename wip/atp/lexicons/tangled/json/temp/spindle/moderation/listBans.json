{
  "lexicon": 1,
  "id": "org.tangled.temp.spindle.moderation.listBans",
  "defs": {
    "main": {
      "type": "query",
      "description": "list all active repository and account-owner bans",
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "bans"
          ],
          "properties": {
            "bans": {
              "description": "active bans ordered by subject DID",
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "org.tangled.temp.spindle.moderation.defs#ban"
              }
            }
          }
        }
      }
    }
  }
}
