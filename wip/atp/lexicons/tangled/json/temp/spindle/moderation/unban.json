{
  "lexicon": 1,
  "id": "org.tangled.temp.spindle.moderation.unban",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "remove an existing ban for a repository or account owner",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "did"
          ],
          "properties": {
            "did": {
              "type": "string",
              "format": "did",
              "description": "DID of the repository or account owner to unban"
            }
          }
        }
      },
      "errors": [
        {
          "name": "InvalidDid"
        },
        {
          "name": "BanNotFound"
        }
      ]
    }
  }
}
