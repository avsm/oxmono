{
  "lexicon": 1,
  "id": "org.tangled.temp.spindle.quota.releaseNars",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "give back the cache storage quota of nars an operator removed from the nix cache. admin only and idempotent, unknown nars are reported and not an error",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "nars"
          ],
          "properties": {
            "nars": {
              "type": "array",
              "description": "nars to release, as cache keys like nar/<hash>.nar.xz (a bare file name works too) or as nix store paths like /nix/store/<hash>-name",
              "minLength": 1,
              "maxLength": 1000,
              "items": {
                "type": "string",
                "maxLength": 512
              }
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "released",
            "bytes",
            "unmatched"
          ],
          "properties": {
            "released": {
              "type": "integer",
              "description": "how many allocations were deleted"
            },
            "bytes": {
              "type": "integer",
              "description": "cache storage bytes given back"
            },
            "unmatched": {
              "type": "array",
              "description": "the inputs that matched no allocation",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
