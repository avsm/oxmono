# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Authentication helpers for AT Protocol CLIs"
description: """
This library provides session persistence, credential management and token
refresh for AT Protocol commands. It includes Cmdliner terms for
authentication commands."""
maintainer: ["Anil Madhavapeddy <anil@recoil.org>"]
authors: ["Anil Madhavapeddy"]
license: "ISC"
homepage: "https://tangled.org/anil.recoil.org/ocaml-atp"
bug-reports: "https://tangled.org/anil.recoil.org/ocaml-atp/issues"
depends: [
  "dune" {>= "3.21"}
  "ocaml" {>= "5.1"}
  "atp-xrpc" {= version}
  "fetch"
  "fetch-curl"
  "http"
  "jsont" {>= "0.1"}
  "jsonwt"
  "digestif"
  "mirage-crypto-ec"
  "mirage-crypto-rng"
  "eio" {>= "1.0"}
  "ptime" {>= "1.0"}
  "cmdliner" {>= "1.2"}
  "eio_main"
  "console"
  "console-eio"
  "logs"
  "fmt"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://tangled.org/anil.recoil.org/ocaml-atp"
x-maintenance-intent: ["(latest)"]
