# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Blosc1 compression for OxCaml"
description: """
Bloscz binds the C-Blosc1 context interface for OxCaml. It compresses and
decompresses caller-supplied bigstrings and releases the runtime lock for
larger calls. It requires an installed libblosc library, version 1.21 or
later, and its headers."""
maintainer: ["Anil Madhavapeddy <anil@recoil.org>"]
authors: ["Anil Madhavapeddy <anil@recoil.org>"]
license: "ISC"
homepage: "https://tangled.org/anil.recoil.org/ocaml-bloscz"
bug-reports: "https://tangled.org/anil.recoil.org/ocaml-bloscz/issues"
depends: [
  "dune" {>= "3.21"}
  "ocaml" {>= "5.2.0"}
  "dune-configurator"
  "base_bigstring"
  "odoc" {with-doc}
  "alcotest" {with-test}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://tangled.org/anil.recoil.org/ocaml-bloscz"
x-maintenance-intent: ["(latest)"]
