# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Read and run the brief project detector"
description: """
Brief reads the JSON reports of brief, the project detector from git-pkgs,
and runs it on a directory, so OCaml programs can learn a project's
languages, package managers and tools."""
maintainer: ["anil@recoil.org"]
authors: ["Anil Madhavapeddy"]
license: "ISC"
depends: [
  "dune" {>= "3.21"}
  "ocaml" {>= "5.2"}
  "jsont"
  "bytesrw"
  "eio"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
x-maintenance-intent: ["(latest)"]
