(lang dune 3.21)
(name cbort)

(generate_opam_files true)

(license ISC)
(authors "Anil Madhavapeddy")
(maintainers "Anil Madhavapeddy <anil@recoil.org>")
(source (tangled anil.recoil.org/ocaml-cbort))

(package
 (name cbort)
 (synopsis "Native CBOR codec with type-safe combinators")
 (description
  "Cbort provides combinators for encoding and decoding CBOR as specified in
RFC 8949. Each codec describes both directions of conversion between OCaml
values and CBOR data.")
 (depends
  (ocaml (>= 5.2))
  (bytesrw (>= 0.2))
  (zarith (>= 1.12))
  (odoc :with-doc)
  (crowbar (and (>= 0.2) :with-test))))
