(test
 (name compat_tests)
 (modules compat_tests)
 (libraries d10.ir alcotest))

(executable
 (name opam_probe)
 (modules opam_probe)
 (libraries opam-format))

(rule
 (alias runtest)
 (deps opam.expected)
 (action
  (progn
   (with-stdout-to
    opam.actual
    (run ./opam_probe.exe))
   (diff opam.expected opam.actual))))

(test
 (name digestif_probe)
 (modules digestif_probe)
 (libraries digestif))

(executable
 (name digestif_length_guard)
 (modules digestif_length_guard))

(rule
 (alias runtest)
 (deps
  (:sources
   (glob_files %{workspace_root}/vendor/digestif/src-c/native/*.{c,h})))
 (action
  (run ./digestif_length_guard.exe %{sources})))
