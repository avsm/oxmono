# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Local LLM inference on the DS4 engine"
description: """
Ds4 provides a library and command for local language model inference on the
DS4 engine. It supports DeepSeek V4 and V4.1 Flash, GLM 5.3 Flash and
Qwen3.8 Flash Next, with selectable Metal, CUDA or CPU backends."""
maintainer: ["Anil Madhavapeddy <anil@recoil.org>"]
authors: ["Anil Madhavapeddy"]
license: "ISC"
tags: ["org:blacksun" "ds4" "llm"]
homepage: "https://tangled.org/anil.recoil.org/ocaml-deepseek"
bug-reports: "https://tangled.org/anil.recoil.org/ocaml-deepseek/issues"
depends: [
  "dune" {>= "3.21"}
  "hf"
  "digestif"
  "ocaml" {>= "5.2.0"}
  "dune-configurator" {build}
  "jsont" {>= "0.3.0"}
  "xdge" {>= "1.0.0"}
  "eio" {>= "1.4"}
  "eio_main"
  "optint" {>= "0.3.0"}
  "logs" {>= "0.7.0"}
  "bytesrw" {>= "0.3.0"}
  "fmt" {>= "0.8.7"}
  "cmdliner" {>= "1.1.0"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://tangled.org/anil.recoil.org/ocaml-deepseek"
x-maintenance-intent: ["(latest)"]
available: (os = "linux" & (arch = "x86_64" | arch = "arm64")) | (os = "macos" & arch = "arm64")
