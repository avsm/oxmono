(package
 (name eioext)
 (synopsis "Filesystem and subprocess extensions for Eio")
 (description
  "Eioext provides filesystem and subprocess extensions for Eio. It supports
bounded reads, private files, atomic replacement, file locking, bounded
process output capture and scoped process groups.")
 (depends
  (ocaml
   (>= 5.2))
  (eio
   (>= 1.6))
  cstruct
  (eio_main :with-test)
  (odoc :with-doc)))
