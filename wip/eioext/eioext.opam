# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Filesystem and subprocess extensions for Eio"
description: """
Eioext provides filesystem and subprocess extensions for Eio. It supports
bounded reads, private files, atomic replacement, file locking, bounded
process output capture and scoped process groups."""
maintainer: ["Anil Madhavapeddy <anil@recoil.org>"]
authors: ["Anil Madhavapeddy"]
license: "ISC"
homepage: "https://github.com/avsm/oxmono"
bug-reports: "https://github.com/avsm/oxmono/issues"
depends: [
  "dune" {>= "3.21"}
  "ocaml" {>= "5.2"}
  "eio" {>= "1.6"}
  "cstruct"
  "eio_main" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/avsm/oxmono.git"
x-maintenance-intent: ["(latest)"]
