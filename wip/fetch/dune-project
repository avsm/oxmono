(lang dune 3.22)
(name fetch)
(using mdx 0.4)
(formatting disabled)
(generate_opam_files true)
(implicit_transitive_deps false)
(source (github avsm/oxmono))
(license ISC)
(authors "Anil Madhavapeddy")
(maintainers "anil@recoil.org")

(package
 (name fetch)
 (license ISC)
 (synopsis "Portable HTTP client capability for Eio and OxCaml")
 (description
  "Fetch provides an HTTP client capability for Eio and OxCaml. It supports
capability restriction, rate limiting, cookie storage and JSON and Markdown
codecs. A mock backend supports testing without network access.")
 (depends
  (duration (>= 0.3.1))
  (ocaml (>= 5.2))
  ppx_globalize
  (httpz (= :version))
  (eio (>= 1.3))
  (http (>= 6.0.0))
  (ipaddr (>= 5.6.2))
  (fmt (>= 0.8.9))
  (mtime (>= 2.0.0))
  (cstruct (>= 6.0.0))
  (bytesrw (>= 0.4.0))
  (ptime (>= 1.0.0))
  (base64 (>= 3.5.0))
  (cmarkit (>= 0.4.0))
  (alcotest :with-test)
  (mdx (and (>= 2.4.1) :with-test))
  (eio_main (and (>= 1.3) :with-test))))

(package
 (name fetch-httpz)
 (license ISC)
 (synopsis "Httpz backend for Fetch")
 (description
  "This package implements a Fetch HTTP/1.1 backend using Httpz. It supports
streaming bodies, gzip decoding and HTTPS with system trust roots by
default.")
 (depends
  (duration (>= 0.3.1))
  (fetch (= :version))
  (httpz (= :version))
  (eio (>= 1.3))
  (http (>= 6.0.0))
  (fmt (>= 0.8.9))
  (cstruct (>= 6.0.0))
  (checkseum (>= 0.5.0))
  optint
  ; The gzip shim tracks the vendored decoder. Check its header regressions
  ; when refreshing vendor/decompress.
  (decompress (>= 1.6.0))
  (eio_main (and (>= 1.3) :with-test))
  (alcotest :with-test)
  (mdx (and (>= 2.4.1) :with-test))))

(package
 (name fetch-curl)
 (license ISC)
 (synopsis "Libcurl backend for Fetch")
 (description
  "This package implements a Fetch backend using libcurl's multi interface with
Eio. It supports connection reuse, HTTP/2 multiplexing and per-host
connection limits.")
 (depends
  (duration (>= 0.3.1))
  (fetch (= :version))
  (httpz (and (= :version) :with-test))
  (eio (>= 1.3))
  (fmt (>= 0.8.9))
  (cstruct (>= 6.0.0))
  (http (>= 6.0.0))
  base-unix
  (curl (>= 0.10.0))
  (alcotest :with-test)
  (eio_main (and (>= 1.3) :with-test))
  (mdx (and (>= 2.4.1) :with-test))))

(package
 (name fetch-signature)
 (synopsis "RFC 9421 HTTP Message Signatures for fetch")
 (description
  "This library signs and verifies HTTP messages using RFC 9421 and content
digests using RFC 9530. It supports Ed25519, ECDSA, RSA and HMAC keys and
provides request-signing middleware for Fetch.")
 (depends
  (fetch (= :version))
  (http (>= 6.0.0))
  uriz
  (eio (>= 1.3))
  (ptime (>= 1.0.0))
  (logs (>= 0.7.0))
  (base64 (>= 3.5.0))
  (eqaf (>= 0.9))
  (digestif (>= 1.2.0))
  (mirage-crypto (>= 1.0.0))
  (mirage-crypto-ec (>= 1.0.0))
  (mirage-crypto-pk (>= 1.0.0))
  (mirage-crypto-rng (and (>= 1.0.0) :with-test))
  (alcotest (and (>= 1.7.0) :with-test))
  (eio_main (and (>= 1.3) :with-test))))

(package
 (name fetch-cmdliner)
 (synopsis "Command-line configuration for fetch clients")
 (description
  "This library provides Cmdliner terms for configuring Fetch clients from
command-line options and environment variables. It records the source of
each setting so commands can display their resolved configuration.")
 (depends
  (duration (>= 0.3.1))
  (fetch (= :version))
  (fetch-curl (= :version))
  (cmdliner (>= 1.3.0))
  (xdge (>= 0.1.0))
  (logs (>= 0.7.0))
  (eio (>= 1.3))
  (alcotest (and (>= 1.7.0) :with-test))
  (eio_main (and (>= 1.3) :with-test))))

(package
 (name nssessionurl)
 (synopsis "macOS NSURLSession bindings for Eio")
 (description
  "This library binds macOS NSURLSession to Eio flows with bounded buffering
and backpressure. It exposes session configuration and shared connection
pools. It builds on other platforms, where session creation is unavailable.")
 (depends
  (ocaml (>= 5.2.0))
  (eio (>= 1.3))
  (cstruct (>= 6.0.0))
  dune-configurator
  (eio_main (and (>= 1.3) :with-test))))

(package
 (name fetch-macos)
 (synopsis "macOS NSURLSession backend for fetch")
 (description
  "This package implements a Fetch backend using NSURLSession on macOS. It uses
system networking, proxy settings and TLS support. It builds on other
platforms but operates only on macOS.")
 (depends
  (duration (>= 0.3.1))
  (fetch (= :version))
  (nssessionurl (= :version))
  (http (>= 6.0.0))
  (fmt (>= 0.8.9))
  (eio_main (and (>= 1.3) :with-test))
  (mdx (and (>= 2.4.1) :with-test))))

(package
 (name fetch-main)
 (synopsis "Platform-selected fetch client and CLI")
 (description
  "This package selects Fetch's macOS backend on macOS and its libcurl backend
elsewhere. The FETCH_BACKEND environment variable overrides the selection.
It supplies cookie, flow-control and retry middleware and a fetch command.")
 (depends
  (duration (>= 0.3.1))
  (fetch (= :version))
  (fetch-curl (= :version))
  (fetch-macos (= :version))
  (http (>= 6.0.0))
  (fmt (>= 0.8.9))
  (eio_main (>= 1.3))
  (mdx (and (>= 2.4.1) :with-test))))
