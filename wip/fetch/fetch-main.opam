# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Platform-selected fetch client and CLI"
description: """
This package selects Fetch's macOS backend on macOS and its libcurl backend
elsewhere. The FETCH_BACKEND environment variable overrides the selection.
It supplies cookie, flow-control and retry middleware and a fetch command."""
maintainer: ["anil@recoil.org"]
authors: ["Anil Madhavapeddy"]
license: "ISC"
homepage: "https://github.com/avsm/oxmono"
bug-reports: "https://github.com/avsm/oxmono/issues"
depends: [
  "dune" {>= "3.22"}
  "duration" {>= "0.3.1"}
  "fetch" {= version}
  "fetch-curl" {= version}
  "fetch-macos" {= version}
  "http" {>= "6.0.0"}
  "fmt" {>= "0.8.9"}
  "eio_main" {>= "1.3"}
  "mdx" {>= "2.4.1" & with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/avsm/oxmono.git"
x-maintenance-intent: ["(latest)"]
