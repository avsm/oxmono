# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Portable HTTP client capability for Eio and OxCaml"
description: """
Fetch provides an HTTP client capability for Eio and OxCaml. It supports
capability restriction, rate limiting, cookie storage and JSON and Markdown
codecs. A mock backend supports testing without network access."""
maintainer: ["anil@recoil.org"]
authors: ["Anil Madhavapeddy"]
license: "ISC"
homepage: "https://github.com/avsm/oxmono"
bug-reports: "https://github.com/avsm/oxmono/issues"
depends: [
  "dune" {>= "3.22"}
  "duration" {>= "0.3.1"}
  "ocaml" {>= "5.2"}
  "ppx_globalize"
  "httpz" {= version}
  "eio" {>= "1.3"}
  "http" {>= "6.0.0"}
  "ipaddr" {>= "5.6.2"}
  "fmt" {>= "0.8.9"}
  "mtime" {>= "2.0.0"}
  "cstruct" {>= "6.0.0"}
  "bytesrw" {>= "0.4.0"}
  "ptime" {>= "1.0.0"}
  "base64" {>= "3.5.0"}
  "cmarkit" {>= "0.4.0"}
  "alcotest" {with-test}
  "mdx" {>= "2.4.1" & with-test}
  "eio_main" {>= "1.3" & with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/avsm/oxmono.git"
x-maintenance-intent: ["(latest)"]
