opam-version: "2.0"
synopsis: "macOS NSURLSession bindings for Eio"
description: """
This library binds macOS NSURLSession to Eio flows with bounded buffering
and backpressure. It exposes session configuration and shared connection
pools. It builds on other platforms, where session creation is unavailable."""
maintainer: ["anil@recoil.org"]
authors: ["Anil Madhavapeddy"]
license: "ISC"
homepage: "https://github.com/avsm/oxmono"
bug-reports: "https://github.com/avsm/oxmono/issues"
depends: [
  "dune" {>= "3.22"}
  "ocaml" {>= "5.2.0"}
  "eio" {>= "1.3"}
  "cstruct" {>= "6.0.0"}
  "dune-configurator"
  "eio_main" {>= "1.3" & with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/avsm/oxmono.git"
x-maintenance-intent: ["(latest)"]
