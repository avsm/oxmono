(lang dune 3.21)
(name frontmatter)

(generate_opam_files true)

(license ISC)
(authors "Anil Madhavapeddy")
(maintainers "Anil Madhavapeddy <anil@recoil.org>")
(source (tangled anil.recoil.org/ocaml-frontmatter))

(package
 (name frontmatter)
 (synopsis "Parse YAML frontmatter from Markdown files")
 (description
  "This library extracts YAML metadata and body content from Markdown files
with Jekyll-style frontmatter delimited by three hyphens.")
 (depends
  (ocaml (>= 5.2))
  (yamlrw (>= 0.3))
  (yamlt (>= 0.1))
  (jsont (>= 0.1))
  (ptime (>= 1.2))
  (odoc :with-doc)))

(package
 (name frontmatter-eio)
 (synopsis "Eio file I/O support for frontmatter")
 (description
  "This package provides Eio file operations for reading Markdown files with
YAML frontmatter.")
 (depends
  (ocaml (>= 5.2))
  (frontmatter (= :version))
  (eio (>= 1.2))
  (odoc :with-doc)))
