(lang dune 3.21)
(name gitops)

(generate_opam_files true)

(license ISC)
(authors "Anil Madhavapeddy <anil@recoil.org>")
(maintainers "Anil Madhavapeddy <anil@recoil.org>")
(source (github avsm/oxmono))

(package
 (name gitops)
 (synopsis "Git operations library with Eio and dry-run support")
 (description
  "Gitops provides Git operations through Eio, with dry-run support and
contextual errors. It includes reusable synchronization settings and
Cmdliner terms.")
 (depends
  eioext
  (ocaml (>= 5.2))
  (eio (>= 1.2))
  (eio_main (>= 1.2))
  (tomlt (>= 0.1))
  (cmdliner (>= 1.3))
  (logs (>= 0.7))
  (fmt (>= 0.9))
  (odoc :with-doc)))
