# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "CalDAV client for OCaml"
description: """
This library implements CalDAV calendar properties and reports, including
calendar queries, free-busy queries and collection synchronization. It
provides an Eio client using Fetch and Httpz WebDAV support. It is
maintained in OxMono from ocaml-jscontact, with OxCaml portable interfaces
and adapted Jsont codecs."""
maintainer: ["Anil Madhavapeddy <anil@recoil.org>"]
authors: ["Anil Madhavapeddy <anil@recoil.org>"]
license: "ISC"
homepage: "https://tangled.org/anil.recoil.org/idk"
bug-reports: "https://tangled.org/anil.recoil.org/idk/issues"
depends: [
  "dune" {>= "3.21"}
  "ocaml" {>= "5.2.0"}
  "httpz"
  "fetch"
  "fetch-httpz"
  "ical"
  "eio"
  "eio_main"
  "odoc" {with-doc}
  "http" {with-test}
  "vcard" {with-test}
  "alcotest" {with-test & >= "1.7.0"}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://tangled.org/anil.recoil.org/idk"
x-maintenance-intent: ["(latest)"]
