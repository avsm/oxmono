# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "CalDAV client for OCaml"
description:
  "An implementation of CalDAV (RFC 4791) on httpz.dav and fetch.dav, with the calendar properties, MKCALENDAR, the calendar-query, calendar-multiget and free-busy-query reports, and the sync-collection report of RFC 6578. The caldav.eio library is a client on Eio and fetch."
maintainer: ["Anil Madhavapeddy <anil@recoil.org>"]
authors: ["Anil Madhavapeddy <anil@recoil.org>"]
license: "ISC"
homepage: "https://tangled.org/anil.recoil.org/idk"
bug-reports: "https://tangled.org/anil.recoil.org/idk/issues"
depends: [
  "dune" {>= "3.21"}
  "ocaml" {>= "5.2.0"}
  "httpz"
  "fetch"
  "fetch-httpz"
  "ical"
  "eio"
  "eio_main"
  "odoc" {with-doc}
  "http" {with-test}
  "vcard" {with-test}
  "alcotest" {with-test & >= "1.7.0"}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://tangled.org/anil.recoil.org/idk"
x-maintenance-intent: ["(latest)"]
