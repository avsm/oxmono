(lang dune 3.21)

(name idk)

(generate_opam_files true)

(license ISC)
(authors "Anil Madhavapeddy <anil@recoil.org>")
(maintainers "Anil Madhavapeddy <anil@recoil.org>")
(source (tangled anil.recoil.org/idk))

(package
 (name idk)
 (synopsis "IDKit, contact data for OCaml")
 (description
  "IDKit groups the JSContact, vCard, iCalendar, CardDAV and CalDAV packages.
The CardDAV and CalDAV packages provide Eio clients for remote contact and
calendar stores. It is maintained in OxMono from ocaml-jscontact, with
OxCaml portable interfaces and adapted Jsont codecs.")
 (depends
  (ocaml (>= 5.2.0))
  jscontact
  vcard
  ical
  carddav
  caldav
  httpz
  fetch
  fetch-httpz
  eio
  eio_main
  (odoc :with-doc)))

(package
 (name jscontact)
 (synopsis "JSContact contact data for OCaml")
 (description
  "This library implements the JSContact JSON contact format specified in RFC
9553. It provides Jsont codecs, semantic validation and localization. It is
maintained in OxMono from ocaml-jscontact, with OxCaml portable interfaces
and adapted Jsont codecs.")
 (depends
  (ocaml (>= 5.2.0))
  (jsont (>= 0.3.0))
  (json-pointer (>= 0.1.0))
  (ptime (>= 1.0.0))
  vcard
  (odoc :with-doc)
  (alcotest (and :with-test (>= 1.7.0)))))

(package
 (name carddav)
 (synopsis "CardDAV client for OCaml")
 (description
  "This library implements CardDAV address-book properties, queries,
synchronization and discovery. It provides an Eio client using Fetch and
conversion between vCard address objects and JSContact cards. It is
maintained in OxMono from ocaml-jscontact, with OxCaml portable interfaces
and adapted Jsont codecs.")
 (depends
  (ocaml (>= 5.2.0))
  httpz
  fetch
  fetch-httpz
  vcard
  jscontact
  eio
  eio_main
  (odoc :with-doc)
  (http :with-test)
  (alcotest (and :with-test (>= 1.7.0)))))

(package
 (name ical)
 (synopsis "iCalendar for OCaml")
 (description
  "This library reads and writes iCalendar data as specified in RFC 5545 with
RFC 7986 properties. It preserves calendar objects and provides typed access
to dates, durations, periods and recurrence rules. It is maintained in
OxMono from ocaml-jscontact, with OxCaml portable interfaces and adapted
Jsont codecs.")
 (depends
  (ocaml (>= 5.2.0))
  vcard
  (ptime (>= 1.0.0))
  (odoc :with-doc)
  (alcotest (and :with-test (>= 1.7.0)))))

(package
 (name caldav)
 (synopsis "CalDAV client for OCaml")
 (description
  "This library implements CalDAV calendar properties and reports, including
calendar queries, free-busy queries and collection synchronization. It
provides an Eio client using Fetch and Httpz WebDAV support. It is
maintained in OxMono from ocaml-jscontact, with OxCaml portable interfaces
and adapted Jsont codecs.")
 (depends
  (ocaml (>= 5.2.0))
  httpz
  fetch
  fetch-httpz
  ical
  eio
  eio_main
  (odoc :with-doc)
  (http :with-test)
  (vcard :with-test)
  (alcotest (and :with-test (>= 1.7.0)))))

(package
 (name vcard)
 (synopsis "vCard 4.0 contact data for OCaml")
 (description
  "This library reads and writes vCard 4.0 data with RFC 6868 parameter
escaping and JSContact extensions. It preserves card data and provides typed
accessors for values and structured components. It is maintained in OxMono
from ocaml-jscontact, with OxCaml portable interfaces and adapted Jsont
codecs.")
 (depends
  (ocaml (>= 5.2.0))
  (ptime (>= 1.0.0))
  (odoc :with-doc)
  (alcotest (and :with-test (>= 1.7.0)))))
