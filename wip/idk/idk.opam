# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "IDKit, contact data for OCaml"
description: """
IDKit groups the JSContact, vCard, iCalendar, CardDAV and CalDAV packages.
The CardDAV and CalDAV packages provide Eio clients for remote contact and
calendar stores. It is maintained in OxMono from ocaml-jscontact, with
OxCaml portable interfaces and adapted Jsont codecs."""
maintainer: ["Anil Madhavapeddy <anil@recoil.org>"]
authors: ["Anil Madhavapeddy <anil@recoil.org>"]
license: "ISC"
homepage: "https://tangled.org/anil.recoil.org/idk"
bug-reports: "https://tangled.org/anil.recoil.org/idk/issues"
depends: [
  "dune" {>= "3.21"}
  "ocaml" {>= "5.2.0"}
  "jscontact"
  "vcard"
  "ical"
  "carddav"
  "caldav"
  "httpz"
  "fetch"
  "fetch-httpz"
  "eio"
  "eio_main"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://tangled.org/anil.recoil.org/idk"
x-maintenance-intent: ["(latest)"]
