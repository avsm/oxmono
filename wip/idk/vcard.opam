# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "vCard 4.0 contact data for OCaml"
description: """
This library reads and writes vCard 4.0 data with RFC 6868 parameter
escaping and JSContact extensions. It preserves card data and provides typed
accessors for values and structured components. It is maintained in OxMono
from ocaml-jscontact, with OxCaml portable interfaces and adapted Jsont
codecs."""
maintainer: ["Anil Madhavapeddy <anil@recoil.org>"]
authors: ["Anil Madhavapeddy <anil@recoil.org>"]
license: "ISC"
homepage: "https://tangled.org/anil.recoil.org/idk"
bug-reports: "https://tangled.org/anil.recoil.org/idk/issues"
depends: [
  "dune" {>= "3.21"}
  "ocaml" {>= "5.2.0"}
  "ptime" {>= "1.0.0"}
  "odoc" {with-doc}
  "alcotest" {with-test & >= "1.7.0"}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://tangled.org/anil.recoil.org/idk"
x-maintenance-intent: ["(latest)"]
