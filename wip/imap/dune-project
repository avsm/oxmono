(lang dune 3.21)
(name imap)
(generate_opam_files true)
(license ISC)
(authors "Anil Madhavapeddy <anil@recoil.org>")
(maintainers "Anil Madhavapeddy <anil@recoil.org>")
(package
 (name imap)
 (synopsis "IMAP protocol and Eio client for OCaml")
 (description
  "This package implements IMAP4rev1 and IMAP4rev2 with an Eio client. It
includes durable IMAP-to-Maildir synchronization, SQLite cursors, a message
archive and the imap-sync command.")
 (depends
  (ocaml (>= 5.2))
  base
  mail-flag
  maildir
  eio
  eio_main
  tls
  tls-eio
  x509
  ca-certs
  cstruct
  domain-name
  ipaddr
  mirage-crypto-rng
  base64
  decompress
  sqlite3
  sqlite3-eio
  digestif
  optint
  cmdliner
  console
  (alcotest :with-test)
  (ptime :with-test)))
