depends: [
  "dune" {>= "3.21"}
  "ocaml" {>= "5.1"}
  "openapi" {>= "0.1"}
  "fetch"
  "fetch-curl"
  "fetch-cmdliner"
  "jsont" {>= "0.2"}
  "bytesrw" {>= "0.2"}
  "eio" {>= "1.0"}
  "eio_main" {>= "1.0"}
  "ptime" {>= "1.0"}
  "base64" {>= "3.5"}
  "fmt" {>= "0.9"}
  "logs" {>= "0.7"}
  "cmdliner" {>= "1.3"}
  "uriz"
  "odoc" {with-doc}
]
