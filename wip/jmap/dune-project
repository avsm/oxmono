(lang dune 3.21)
(using mdx 0.4)

(name jmap)

(generate_opam_files true)

(license ISC)
(authors "Anil Madhavapeddy <anil@recoil.org>")
(maintainers "Anil Madhavapeddy <anil@recoil.org>")
(source (tangled anil.recoil.org/ocaml-jmap))

(package
 (name mail-flag)
 (synopsis "Message flags and mailbox attributes for IMAP/JMAP")
 (description
  "This library represents message keywords, system flags and mailbox
attributes shared by IMAP and JMAP. It includes IMAP4rev2, JMAP Mail and
special-use mailbox flags.")
 (depends
  (ocaml (>= 5.2.0))
  (fmt (>= 0.9))
  (odoc :with-doc)
  (alcotest (and :with-test (>= 1.7.0)))))

(package
 (name jmap)
 (synopsis "JMAP protocol implementation for OCaml")
 (description
  "This library implements JMAP core, mail and contacts as specified in RFCs
8620, 8621 and 9610. It provides typed request builders and an Eio client.
It is maintained in OxMono from ocaml-jmap, with OxCaml mode annotations and
adaptations to Jsont codecs and Eio buffers.")
 (depends
  sekrit
  eioext
  (duration (>= 0.3.1))
  (ocaml (>= 5.2))
  base64
  bytesrw
  (jsont (>= 0.3.0))
  jsonm
  json-pointer
  jscontact
  mail-flag
  markup
  (ptime (>= 1.0.0))
  eio
  eio_main
  fetch
  fetch-httpz
  httpz
  mtime
  optint
  cmdliner
  console
  fmt
  (alcotest :with-test)
  (mdx :with-test)
  (http :with-test)
  (imap :with-test)))

(package
 (name jmap-mosaic)
 (allow_empty)
 (synopsis "A terminal mail client on JMAP")
 (description
  "This package describes a terminal mail client using JMAP and Mosaic. The
client is disabled in this workspace and the package currently installs no
application.")
 (depends
  (duration (>= 0.3.1))
  (ocaml (>= 5.2))
  (jmap (= :version))
  fetch
  mosaic
  matrix-eio
  eio
  eio_main
  ptime
  cmdliner
  fmt
  (alcotest :with-test)))
