# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "A terminal mail client on JMAP"
description: """
This package describes a terminal mail client using JMAP and Mosaic. The
client is disabled in this workspace and the package currently installs no
application."""
maintainer: ["Anil Madhavapeddy <anil@recoil.org>"]
authors: ["Anil Madhavapeddy <anil@recoil.org>"]
license: "ISC"
homepage: "https://tangled.org/anil.recoil.org/ocaml-jmap"
bug-reports: "https://tangled.org/anil.recoil.org/ocaml-jmap/issues"
depends: [
  "dune" {>= "3.21"}
  "duration" {>= "0.3.1"}
  "ocaml" {>= "5.2"}
  "jmap" {= version}
  "fetch"
  "mosaic"
  "matrix-eio"
  "eio"
  "eio_main"
  "ptime"
  "cmdliner"
  "fmt"
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://tangled.org/anil.recoil.org/ocaml-jmap"
x-maintenance-intent: ["(latest)"]
