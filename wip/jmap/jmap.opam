# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "JMAP protocol implementation for OCaml"
description: """
This library implements JMAP core, mail and contacts as specified in RFCs
8620, 8621 and 9610. It provides typed request builders and an Eio client.
It is maintained in OxMono from ocaml-jmap, with OxCaml mode annotations and
adaptations to Jsont codecs and Eio buffers."""
maintainer: ["Anil Madhavapeddy <anil@recoil.org>"]
authors: ["Anil Madhavapeddy <anil@recoil.org>"]
license: "ISC"
homepage: "https://tangled.org/anil.recoil.org/ocaml-jmap"
bug-reports: "https://tangled.org/anil.recoil.org/ocaml-jmap/issues"
depends: [
  "dune" {>= "3.21"}
  "sekrit"
  "eioext"
  "duration" {>= "0.3.1"}
  "ocaml" {>= "5.2"}
  "base64"
  "bytesrw"
  "jsont" {>= "0.3.0"}
  "jsonm"
  "json-pointer"
  "jscontact"
  "mail-flag"
  "markup"
  "ptime" {>= "1.0.0"}
  "eio"
  "eio_main"
  "fetch"
  "fetch-httpz"
  "httpz"
  "mtime"
  "optint"
  "cmdliner"
  "console"
  "fmt"
  "alcotest" {with-test}
  "mdx" {with-test}
  "http" {with-test}
  "imap" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://tangled.org/anil.recoil.org/ocaml-jmap"
x-maintenance-intent: ["(latest)"]
