opam-version: "2.0"
synopsis: "Message flags and mailbox attributes for IMAP/JMAP"
description: """
This library represents message keywords, system flags and mailbox
attributes shared by IMAP and JMAP. It includes IMAP4rev2, JMAP Mail and
special-use mailbox flags."""
maintainer: ["Anil Madhavapeddy <anil@recoil.org>"]
authors: ["Anil Madhavapeddy"]
license: "ISC"
homepage: "https://tangled.org/anil.recoil.org/ocaml-mail-flag"
bug-reports: "https://tangled.org/anil.recoil.org/ocaml-mail-flag/issues"
depends: [
  "dune" {>= "3.21"}
  "ocaml" {>= "5.2.0"}
  "fmt" {>= "0.9"}
  "odoc" {with-doc}
  "alcotest" {with-test & >= "1.7.0"}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://tangled.org/anil.recoil.org/ocaml-mail-flag"
x-maintenance-intent: ["(latest)"]
