(lang dune 3.21)

(name jsonwt)

(generate_opam_files true)

(license ISC)

(authors "Anil Madhavapeddy")

(maintainers "anil@recoil.org")

(source
 (tangled anil.recoil.org/ocaml-jsonwt))

(package
 (name jsonwt)
 (synopsis "Bounded JSON Web Tokens for OxCaml")
 (description
  "Jsonwt implements bounded JWT and CWT decoding, signing and verification. It
derives from ocaml-jsonwt and adds strict claim and key validation, explicit
algorithm policies, corrected signature handling and OxCaml mode
annotations.")
 (depends
  (ocaml
   (>= 5.2))
  dune-configurator
  conf-pkg-config
  jsont
  bytesrw
  digestif
  eqaf
  base64
  ptime
  uriz
  mirage-crypto-ec
  mirage-crypto-rng
  conf-libssl
  cbort
  zarith
  (cstruct :with-test)
  (crowbar :with-test)
  (alcotest :with-test)))
