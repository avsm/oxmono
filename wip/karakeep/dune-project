(lang dune 3.21)
(name karakeep)

(generate_opam_files true)

(license ISC)
(authors "Anil Madhavapeddy")
(maintainers "anil@recoil.org")
(source (tangled anil.recoil.org/ocaml-karakeep))

(package
 (name karakeep)
 (synopsis "Karakeep API client library for OCaml")
 (description
  "This library provides a Karakeep bookmark-service client generated from its
OpenAPI specification. It uses Eio and supports bookmarks, tags, lists,
highlights and user operations.")
 (depends
  (ocaml (>= "5.2.0"))
  (openapi (>= "0.4.0"))
  fetch
  fetch-curl
  (eio (>= "1.2"))
  eio_main
  (jsont (>= "0.2.0"))
  bytesrw
  (ptime (>= "1.0.0"))
  (fmt (>= "0.9.0"))
  (cmdliner (>= "1.3.0"))
  (logs (>= "0.7.0"))
  tomlt
  (odoc :with-doc)))
