# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Pure OCaml Matrix SDK"
description:
  "A pure OCaml implementation of the Matrix client SDK, covering the Client-Server API and end-to-end encryption. Olm and Megolm are interoperable with libolm and vodozemac, and encryption is wired into the sync loop and the send path. Provides matrix-chat.proto for protocol types and JSON codecs, matrix-chat.client for the result-returning SDK over a Fetch.t capability, matrix-chat.eio for Eio-idiomatic usage and the driver loops, matrix-chat.cli for cmdliner terms, matrix-chat.ui for reactive room lists and timelines with matrix-chat.ui.sqlite behind their event cache, matrix-chat.bot for writing bots, and the omatrix and matrix-bot executables."
maintainer: ["Anil Madhavapeddy <anil@recoil.org>"]
authors: ["Anil Madhavapeddy"]
license: "ISC"
homepage: "https://tangled.org/anil.recoil.org/ocaml-matrix"
bug-reports: "https://tangled.org/anil.recoil.org/ocaml-matrix/issues"
depends: [
  "dune" {>= "3.21"}
  "duration" {>= "0.3.1"}
  "ocaml" {>= "5.2"}
  "jsont" {>= "0.4.0"}
  "jsonm" {>= "1.0.2"}
  "fetch"
  "fetch-httpz"
  "httpz"
  "proffer"
  "proffer-httpz"
  "mtime" {>= "2.0.0"}
  "eqaf" {>= "0.10"}
  "mirage-crypto" {>= "2.0.0"}
  "mirage-crypto-ec" {>= "2.0.0"}
  "kdf" {>= "1.1.0"}
  "digestif" {>= "1.0.0"}
  "base64" {>= "3.5.0"}
  "domain-name" {>= "0.5.0"}
  "ipaddr" {>= "5.6.0"}
  "cstruct" {>= "6.0.0"}
  "eio" {>= "1.3"}
  "uriz"
  "ptime" {>= "1.0.0"}
  "markup" {>= "1.0.3"}
  "uutf" {>= "1.0.4"}
  "uunf" {>= "17.0.0"}
  "uucp" {>= "17.0.0"}
  "uuseg" {>= "17.0.0"}
  "sqlite3" {>= "5.4.2"}
  "xdge" {>= "1.1.0"}
  "logs" {>= "0.7.0"}
  "fmt" {>= "0.8.9"}
  "cmdliner" {>= "1.1.0"}
  "eio_main" {>= "1.3"}
  "alcotest" {>= "1.7.0" & with-test}
  "qcheck-core" {>= "0.91" & with-test}
  "qcheck-alcotest" {>= "0.91" & with-test}
  "http" {>= "6.0.0" & with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://tangled.org/anil.recoil.org/ocaml-matrix"
x-maintenance-intent: ["(latest)"]
