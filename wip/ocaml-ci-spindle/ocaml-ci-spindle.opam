# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "A Tangled spindle that tests OCaml projects on OCluster"
description: """
Ocaml-ci-spindle is a Tangled spindle in the manner of OCaml-CI, without
OCurrent. It finds a repository's opam packages, solves their dependencies
for several compilers and runs each solution as an OBuilder job on an
OCluster pool, reporting every build as its own Tangled workflow."""
maintainer: ["anil@recoil.org"]
authors: ["Anil Madhavapeddy"]
license: "ISC"
depends: [
  "dune" {>= "3.21"}
  "ocaml" {>= "5.2"}
  "spindle"
  "ocluster-client"
  "opam-core"
  "opam-format"
  "opam-0install"
  "eio"
  "eio_main"
  "fmt"
  "cmdliner"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
x-maintenance-intent: ["(latest)"]
