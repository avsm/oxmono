# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Eio client for submitting jobs to an OCluster scheduler"
description: """
Ocluster-client connects to an OCluster scheduler with a submission
capability file, submits OBuilder jobs to a pool, streams their logs and
reads their results. It speaks Cap'n Proto RPC through capnp-rpc on Eio."""
maintainer: ["anil@recoil.org"]
authors: ["Anil Madhavapeddy"]
license: "ISC"
depends: [
  "dune" {>= "3.21"}
  "ocaml" {>= "5.2"}
  "capnp"
  "capnp-rpc"
  "capnp-rpc-net"
  "capnp-rpc-unix"
  "eio"
  "eio_main"
  "fmt"
  "logs"
  "cmdliner"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
x-maintenance-intent: ["(latest)"]
