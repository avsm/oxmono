(lang dune 3.21)
(name proffer)

(generate_opam_files true)
(implicit_transitive_deps false)

(source (github avsm/proffer))
(documentation "https://avsm.github.io/proffer/")
(license ISC)
(authors "Anil Madhavapeddy")
(maintainers "anil@recoil.org")

(package
 (name proffer)
 (license ISC)
 (synopsis "Declarative HTTP serving with interchangeable backends")
 (description
  "Proffer describes HTTP routes, responses, cache policies and media codecs as
typed values. It supports interchangeable serving backends and includes JSON
and CommonMark adapters.")
 (tags (http server web routing))
 (depends
  (duration (>= 0.3.1))
  (ocaml (>= 5.2))
  (httpz (= :version))
  (base (>= v0.16.0))
  (bytesrw (>= 0.4.0))
  (cmarkit (>= 0.4.0))
  (fetch (and (= :version) :with-test))
  (http :with-test)
  (cstruct (>= 6.0.0))
  (eio (>= 1.3))
  (digestif (>= 1.2.0))
  (mtime (>= 2.0.0))
  base-unix
  (fetch-httpz (and (= :version) :with-test))
  (eio_main (and (>= 1.3) :with-test))
  (x509 :with-test)
  (ptime (>= 1.1.0))
  (eqaf (>= 0.9))
  (alcotest :with-test)))

(package
 (name proffer-log)
 (license ISC)
 (synopsis "SQLite access log for Proffer servers with rotation and archives")
 (description
  "This package records Proffer request events in a SQLite file, rotates
old rows into yearly archive files beside it, reads the whole history through
one view, and merges log files. The cmdliner sub-library supplies the
maintenance commands.")
 (tags (http server log sqlite))
 (depends
  (ocaml (>= 5.2))
  (proffer (= :version))
  (proffer-httpz (= :version))
  sqlite3-eio
  sqlite3
  (jsont (>= 0.4.0))
  (eio (>= 1.3))
  cmdliner
  (eio_main (>= 1.3))
  base-unix))

(package
 (name proffer-httpz)
 (license ISC)
 (synopsis "Proffer backend on the httpz parser and Eio")
 (description
  "This package serves Proffer sites over HTTP/1.1 using Httpz and Eio. It
supports bounded concurrency, request deadlines and optional TLS.")
 (tags (http server web eio))
 (depends
  (duration (>= 0.3.1))
  (ocaml (>= 5.2))
  (proffer (= :version))
  (httpz (= :version))
  (eio (>= 1.3))
  (cstruct (>= 6.0.0))
  (mtime (>= 2.0.0))
  base-unix
  (eio_main (and :with-test (>= 1.3)))))
