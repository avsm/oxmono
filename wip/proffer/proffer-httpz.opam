opam-version: "2.0"
synopsis: "Proffer backend on the httpz parser and Eio"
description: """
Serves a compiled Proffer site over HTTP/1.1 using httpz and Eio, with
bounded concurrency, request deadlines, and optional TLS."""
maintainer: ["anil@recoil.org"]
authors: ["Anil Madhavapeddy"]
license: "ISC"
tags: ["http" "server" "web" "eio"]
homepage: "https://github.com/avsm/proffer"
doc: "https://avsm.github.io/proffer/"
bug-reports: "https://github.com/avsm/proffer/issues"
depends: [
  "dune" {>= "3.21"}
  "duration" {>= "0.3.1"}
  "ocaml" {>= "5.2"}
  "proffer" {= version}
  "httpz" {= version}
  "eio" {>= "1.3"}
  "cstruct" {>= "6.0.0"}
  "mtime" {>= "2.0.0"}
  "base-unix"
  "eio_main" {with-test & >= "1.3"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/avsm/proffer.git"
x-maintenance-intent: ["(latest)"]
