# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "SQLite access log for Proffer servers with rotation and archives"
description: """
This package records Proffer request events in a SQLite file, rotates
old rows into yearly archive files beside it, reads the whole history through
one view, and merges log files. The cmdliner sub-library supplies the
maintenance commands."""
maintainer: ["anil@recoil.org"]
authors: ["Anil Madhavapeddy"]
license: "ISC"
tags: ["http" "server" "log" "sqlite"]
homepage: "https://github.com/avsm/proffer"
doc: "https://avsm.github.io/proffer/"
bug-reports: "https://github.com/avsm/proffer/issues"
depends: [
  "dune" {>= "3.21"}
  "ocaml" {>= "5.2"}
  "proffer" {= version}
  "proffer-httpz" {= version}
  "sqlite3-eio"
  "sqlite3"
  "jsont" {>= "0.4.0"}
  "eio" {>= "1.3"}
  "cmdliner"
  "eio_main" {>= "1.3"}
  "base-unix"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/avsm/proffer.git"
x-maintenance-intent: ["(latest)"]
