opam-version: "2.0"
synopsis: "Secret references and authenticated encrypted local storage"
maintainer: ["Anil Madhavapeddy <anil@recoil.org>"]
authors: ["Anil Madhavapeddy"]
license: "ISC"
homepage: "https://github.com/avsm/oxmono"
bug-reports: "https://github.com/avsm/oxmono/issues"
depends: [
  "dune" {>= "3.21"}
  "ocaml"
  "eioext"
  "mirage-crypto"
  "mirage-crypto-rng"
  "jsont"
  "bytesrw"
  "xdg"
  "eio"
  "eio_main"
  "cmdliner"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/avsm/oxmono.git"
x-maintenance-intent: ["(latest)"]
