(library
 (name sitekit)
 (public_name sitekit)
 (modules sitekit stylesheet script terminal)
 (private_modules stylesheet script terminal)
 (libraries htmlit proffer uriz digestif ptime console.text))

(rule
 (target stylesheet.ml)
 (deps sitekit.css)
 (action
  (with-stdout-to
   %{target}
   (progn
    (echo "let source = {sitekit_css|")
    (cat %{dep:sitekit.css})
    (echo "|sitekit_css}")))))

(rule
 (target script.ml)
 (deps sitekit.js)
 (action
  (with-stdout-to
   %{target}
   (progn
    (echo "let source = {sitekit_js|")
    (cat %{dep:sitekit.js})
    (echo "|sitekit_js}")))))
