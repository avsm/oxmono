# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Server-rendered web pages that are safe by construction"
description: """
Sitekit is a small library of Htmlit components and a page shell for
server-rendered sites on Proffer. Text is always escaped, links take
validated URLs, and its stylesheet and script are served at content-hashed
paths, so pages run under a Content Security Policy without unsafe-inline."""
maintainer: ["anil@recoil.org"]
authors: ["Anil Madhavapeddy"]
license: "ISC"
depends: [
  "dune" {>= "3.21"}
  "ocaml" {>= "5.2"}
  "htmlit"
  "proffer"
  "uriz"
  "digestif"
  "ptime"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
x-maintenance-intent: ["(latest)"]
