# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "OCaml-defined Tangled CI jobs served by Proffer"
description: """
Spindle schedules Tangled CI workflows defined in OCaml or repository YAML.
It uses Proffer and Eio to serve requests and maintains a durable pipeline
engine. Workflow execution is delegated to an operator-supplied callback."""
maintainer: ["anil@recoil.org"]
authors: ["Anil Madhavapeddy"]
license: "ISC"
depends: [
  "dune" {>= "3.21"}
  "ocaml" {>= "5.2"}
  "atp"
  "proffer"
  "proffer-httpz"
  "httpz"
  "fetch"
  "fetch-httpz"
  "eio"
  "eio_main"
  "mtime"
  "jsont"
  "bytesrw"
  "multibase"
  "jsonwt"
  "mirage-crypto-ec"
  "sqlite3-eio"
  "ptime"
  "cmdliner"
  "brief"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
x-maintenance-intent: ["(latest)"]
