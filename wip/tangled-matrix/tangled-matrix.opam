# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Report Tangled CI pipelines in end-to-end encrypted Matrix rooms"
description: """
Tangled-matrix is a Matrix bot that follows the CI pipelines of Tangled
repositories and keeps one message per pipeline up to date in the rooms
their maintainers bind them to with tangled pipeline matrix set."""
maintainer: ["anil@recoil.org"]
authors: ["Anil Madhavapeddy"]
license: "ISC"
depends: [
  "dune" {>= "3.21"}
  "ocaml" {>= "5.2"}
  "tangled"
  "matrix-chat"
  "eio"
  "eio_main"
  "fetch-httpz"
  "jsont"
  "bytesrw"
  "ptime"
  "fmt"
  "logs"
  "cmdliner"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
x-maintenance-intent: ["(latest)"]
