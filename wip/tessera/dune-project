(lang dune 3.21)
(name tessera)

(generate_opam_files true)

(license ISC)
(authors "Anil Madhavapeddy")
(maintainers "Anil Madhavapeddy <anil@recoil.org>")
(source (tangled anil.recoil.org/ocaml-tessera))

(package
 (name tessera)
 (synopsis "Client for Tessera geospatial embeddings over Zarr")
 (description
  "Tessera reads satellite embedding datasets stored in Zarr. It provides UTM
zone selection, coordinate projection, point queries, region reads and
dequantization over Zarrz store backends.")
 (depends
  (ocaml (>= 5.2.0))
  (zarrz (= :version))
  (zarrz-eio (= :version))
  (zarrz-fetch (= :version))
  (nx (= 1.0.0~alpha3))
  nx-oxcaml
  proj
  jsont
  base_bigstring
  cmdliner
  fetch-httpz
  eio_main
  console console-eio
  (odoc :with-doc)
  (alcotest :with-test)))
