# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Client for Tessera geospatial embeddings over Zarr"
description: """
Tessera reads satellite embedding datasets stored in Zarr. It provides UTM
zone selection, coordinate projection, point queries, region reads and
dequantization over Zarrz store backends."""
maintainer: ["Anil Madhavapeddy <anil@recoil.org>"]
authors: ["Anil Madhavapeddy"]
license: "ISC"
homepage: "https://tangled.org/anil.recoil.org/ocaml-tessera"
bug-reports: "https://tangled.org/anil.recoil.org/ocaml-tessera/issues"
depends: [
  "dune" {>= "3.21"}
  "ocaml" {>= "5.2.0"}
  "zarrz" {= version}
  "zarrz-eio" {= version}
  "zarrz-fetch" {= version}
  "nx" {= "1.0.0~alpha3"}
  "nx-oxcaml"
  "proj"
  "jsont"
  "base_bigstring"
  "cmdliner"
  "fetch-httpz"
  "eio_main"
  "console"
  "console-eio"
  "odoc" {with-doc}
  "alcotest" {with-test}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://tangled.org/anil.recoil.org/ocaml-tessera"
x-maintenance-intent: ["(latest)"]
