# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Scoped process environment changes for single-domain tests"
description: """
Testenv sets, unsets and restores process environment variables around a
test, and creates throwaway XDG base directories bound to fresh temporary
roots. It is for tests that run in a single domain."""
maintainer: ["Anil Madhavapeddy <anil@recoil.org>"]
authors: ["Anil Madhavapeddy"]
license: "ISC"
homepage: "https://github.com/avsm/oxmono"
bug-reports: "https://github.com/avsm/oxmono/issues"
depends: [
  "dune" {>= "3.21"}
  "ocaml" {>= "5.2"}
  "base-unix"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/avsm/oxmono.git"
x-maintenance-intent: ["(latest)"]
