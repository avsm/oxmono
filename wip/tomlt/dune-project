(license ISC)
(authors "Anil Madhavapeddy <anil@recoil.org>")
(maintainers "Anil Madhavapeddy <anil@recoil.org>")
(source (tangled anil.recoil.org/ocaml-tomlt))

(package
 (name tomlt)
 (synopsis "TOML 1.1 codec library for OCaml")
 (description
  "Tomlt provides bidirectional TOML 1.1 codecs using combinators inspired by
Jsont. Separate libraries supply Bytesrw streaming, Eio and Unix I/O, and
Jsont codecs for the toml-test interchange format.")
 (depends
  (ocaml (>= 4.14.0))
  (ptime (>= 1.0.0))
  (bytesrw (>= 0.1.0))
  (uutf (>= 1.0.0))
  (eio (>= 1.0))
  (jsont (>= 0.1))
  (alcotest :with-test)))
