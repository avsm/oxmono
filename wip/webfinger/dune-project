(lang dune 3.21)
(name webfinger)

(generate_opam_files true)

(license ISC)
(authors "Anil Madhavapeddy")
(maintainers "Anil Madhavapeddy <anil@recoil.org>")
(source (tangled anil.recoil.org/ocaml-webfinger))

(package
 (name webfinger)
 (synopsis "RFC 7033 WebFinger and RFC 7565 acct URI scheme for OCaml")
 (description
  "This package implements WebFinger resource discovery and the acct URI scheme
specified in RFCs 7033 and 7565. It provides Jsont codecs, an Eio client
using Fetch and a command-line lookup tool.")
 (depends
  (ocaml (>= 5.2.0))
  (dune (>= 3.0))
  (jsont (>= 0.1.0))
  bytesrw
  (eio (>= 1.0))
  (eio_main (>= 1.0))
  console
  console-eio
  fetch
  fetch-curl
  uriz
  (cmdliner (>= 1.2.0))
  (logs (>= 0.7.0))
  (fmt (>= 0.9.0))
  (odoc :with-doc)
  (alcotest :with-test)))
