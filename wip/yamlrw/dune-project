(lang dune 3.21)
(name yamlrw)

(generate_opam_files true)

(using directory-targets 0.1)
(using mdx 0.4)

(license ISC)
(authors "Anil Madhavapeddy")
(maintainers "Anil Madhavapeddy <anil@recoil.org>")
(source (tangled anil.recoil.org/ocaml-yamlrw))

(package
 (name yamlrw)
 (synopsis "Pure OCaml YAML 1.2 parser and emitter")
 (description
  "Yamlrw parses and emits YAML 1.2 in OCaml. It provides a JSON-compatible
value interface and a lower-level streaming interface. It requires OxCaml
and has no C dependencies.")
 (depends
  (ocaml (>= 5.2))
  bytesrw
  cmdliner
  (odoc :with-doc)
  (mdx :with-doc)
  (jsonm :with-test)
  (alcotest :with-test)
  (crowbar :with-test)))

(package
 (name yamlrw-unix)
 (synopsis "Unix I/O for Yamlrw")
 (description
  "This package provides Unix file and channel operations for reading and
writing YAML with Yamlrw.")
 (depends
  (ocaml (>= 5.2))
  yamlrw
  bytesrw
  (odoc :with-doc)))

(package
 (name yamlrw-eio)
 (synopsis "Eio support for Yamlrw")
 (description
  "This package provides Eio streaming readers and writers for Yamlrw.")
 (depends
  (ocaml (>= 5.2))
  yamlrw
  bytesrw-eio
  (eio (>= 1.1))
  (eio_main :with-test)
  (odoc :with-doc)))
