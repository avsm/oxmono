# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Pure OCaml YAML 1.2 parser and emitter"
description: """
Yamlrw parses and emits YAML 1.2 in OCaml. It provides a JSON-compatible
value interface and a lower-level streaming interface. It requires OxCaml
and has no C dependencies."""
maintainer: ["Anil Madhavapeddy <anil@recoil.org>"]
authors: ["Anil Madhavapeddy"]
license: "ISC"
homepage: "https://tangled.org/anil.recoil.org/ocaml-yamlrw"
bug-reports: "https://tangled.org/anil.recoil.org/ocaml-yamlrw/issues"
depends: [
  "dune" {>= "3.21"}
  "ocaml" {>= "5.2"}
  "bytesrw"
  "cmdliner"
  "odoc" {with-doc}
  "mdx" {with-doc}
  "jsonm" {with-test}
  "alcotest" {with-test}
  "crowbar" {with-test}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://tangled.org/anil.recoil.org/ocaml-yamlrw"
x-maintenance-intent: ["(latest)"]
