(lang dune 3.21)
(name zarrz)

(generate_opam_files true)

(cram enable)

(license ISC)
(authors "Anil Madhavapeddy")
(maintainers "Anil Madhavapeddy <anil@recoil.org>")
(source (tangled anil.recoil.org/ocaml-zarrz))

(package
 (name zarrz)
 (synopsis "Zarr V3 chunked N-dimensional arrays for OxCaml")
 (description
  "Zarrz reads and writes Zarr V3 array hierarchies. It provides unboxed access
to decoded chunk values and separates array operations from storage
backends. Companion packages supply filesystem and HTTP stores.")
 (depends
  (ocaml (>= 5.2.0))
  base
  base64
  jsont
  base_bigstring
  decompress
  checkseum
  zstdz
  bloscz
  (odoc :with-doc)
  (alcotest :with-test)))

(package
 (name zarrz-eio)
 (synopsis "Eio filesystem store for zarrz")
 (description
  "This package implements a filesystem store for Zarrz using Eio directory
capabilities.")
 (depends
  (ocaml (>= 5.2.0))
  (zarrz (= :version))
  (eio (>= 1.3))
  cstruct
  optint
  (odoc :with-doc)
  (alcotest (and :with-test (>= 1.7.0)))
  (eio_main :with-test)))

(package
 (name zarrz-cli)
 (synopsis "Inspect Zarr V3 stores")
 (description
  "The zarr command inspects local and remote Zarr V3 stores. It displays
hierarchy metadata, individual nodes and estimated read costs, using
consolidated metadata when available.")
 (depends
  (ocaml (>= 5.2.0))
  (zarrz (= :version))
  (zarrz-eio (= :version))
  (zarrz-fetch (= :version))
  base_bigstring
  fetch-curl
  eio_main
  console console-eio
  cmdliner
  jsont
  (odoc :with-doc)
  (alcotest :with-test)))

(package
 (name zarrz-fetch)
 (synopsis "HTTP store for zarrz over the fetch client")
 (description
  "This package implements an HTTP store for Zarrz using Fetch.")
 (depends
  (ocaml (>= 5.2.0))
  (zarrz (= :version))
  (eio (>= 1.3))
  fetch
  cstruct
  (http :with-test)
  (odoc :with-doc)
  (alcotest (and :with-test (>= 1.7.0)))
  (eio_main :with-test)))
