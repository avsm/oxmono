(lang dune 3.21)
(name zstdz)

(generate_opam_files true)

(license ISC)
(authors "Anil Madhavapeddy <anil@recoil.org>")
(maintainers "Anil Madhavapeddy <anil@recoil.org>")
(source (tangled anil.recoil.org/ocaml-zstdz))

(package
 (name zstdz)
 (synopsis "Zstandard compression for OxCaml")
 (description
  "Zstdz binds libzstd for OxCaml. It compresses and decompresses
caller-supplied bigstrings, returns stack-allocated frame-probing results
and releases the runtime lock for larger calls.")
 (depends
  (ocaml (>= 5.2.0))
  dune-configurator
  conf-zstd
  base_bigstring
  (odoc :with-doc)
  (alcotest :with-test)))
