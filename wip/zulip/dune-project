(lang dune 3.21)
(name zulip)

(generate_opam_files true)

(license ISC)
(authors "Anil Madhavapeddy")
(maintainers "Anil Madhavapeddy <anil@recoil.org>")
(source (tangled anil.recoil.org/ocaml-zulip))

(package
 (name zulip)
 (synopsis "OCaml bindings for the Zulip REST API with bot framework")
 (description
  "This package provides a Zulip REST API client using Fetch and Eio. It
includes Jsont protocol codecs, composable bot handlers and XDG profiles. It
is maintained in OxMono from ocaml-zulip, with OxCaml codec adaptations and
compiler compatibility helpers.")
 (depends
  (ocaml (>= 5.2))
  (eio (>= 1.3))
  fetch
  fetch-httpz
  httpz
  http
  duration
  (jsont (>= 0.4.0))
  bytesrw
  xdge
  logs
  fmt
  eio_main
  cmdliner
  (odoc :with-doc)
  (alcotest :with-test)
  (conf-python-3 :with-test)))
