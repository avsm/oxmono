(lang dune 3.21)
(name zulip)

(generate_opam_files true)

(license ISC)
(authors "Anil Madhavapeddy")
(maintainers "Anil Madhavapeddy <anil@recoil.org>")
(source (tangled anil.recoil.org/ocaml-zulip))

(package
 (name zulip)
 (synopsis "OCaml bindings for the Zulip REST API with bot framework")
 (description
  "OCaml bindings for the Zulip REST API using Fetch and Eio, with Jsont protocol codecs, composable bots, and XDG profiles.")
 (depends
  (ocaml (>= 5.2))
  (eio (>= 1.3))
  fetch
  fetch-httpz
  httpz
  http
  duration
  (jsont (>= 0.4.0))
  bytesrw
  xdge
  logs
  fmt
  eio_main
  cmdliner
  (odoc :with-doc)
  (alcotest :with-test)
  (conf-python-3 :with-test)))
